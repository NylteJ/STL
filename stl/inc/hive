_EXPORT_STD struct hive_limits {
    size_t min;
    size_t max;
    constexpr hive_limits(size_t _Min, size_t _Max) noexcept : min{_Min}, max{_Max} {}
};

template <class _BlockSizeT>
struct _Hive_limits_small {
    _BlockSizeT min;
    _BlockSizeT max;

    constexpr _Hive_limits_small(_BlockSizeT _Min, _BlockSizeT _Max) noexcept : min{_Min}, max{_Max} {}

    /* implicit */ constexpr _Hive_limits_small(hive_limits _Limits) noexcept
        : min{static_cast<_BlockSizeT>(_Limits.min)}, max{static_cast<_BlockSizeT>(_Limits.max)} {
        _STL_INTERNAL_CHECK(_STD in_range<_BlockSizeT>(_Limits.min) && _STD in_range<_BlockSizeT>(_Limits.max));
    }

    /* implicit */ constexpr operator hive_limits() const noexcept {
        return {min, max};
    }

    constexpr bool operator==(const _Hive_limits_small&) const = default;

    _NODISCARD constexpr bool _Contains(size_t _Value) const noexcept {
        return min <= _Value && _Value <= max;
    }
    _NODISCARD constexpr bool _Contains(_Hive_limits_small _Other) const noexcept {
        return min <= _Other.min && _Other.max <= max;
    }

    template <integral _ValueT>
    _NODISCARD constexpr _BlockSizeT _Clamp(_ValueT _Value) const noexcept {
        _STL_INTERNAL_CHECK(_Value >= 0);
        return static_cast<_BlockSizeT>(
            _STD clamp(static_cast<size_t>(_Value), static_cast<size_t>(min), static_cast<size_t>(max)));
    }

    _NODISCARD constexpr bool _Overlaps(_Hive_limits_small _Other) const noexcept {
        return min <= _Other.max && _Other.min <= max;
    }

    _NODISCARD static constexpr _Hive_limits_small _Union_of(_Hive_limits_small _Left, _Hive_limits_small _Right) {
        return {(_STD min) (_Left.min, _Right.min), (_STD max) (_Left.max, _Right.max)};
    }
};

