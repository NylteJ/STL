// the default constructor potentially-throwing. To avoid this, we use a custom debugging mechanism here.

// iterator debugging data structures overview: iterators -> blocks -> hive_val
// iterators are internally linked in an intrusive doubly-linked list

struct _Hive_val_empty_base {};

struct _Hive_block_base;

class _Hive_iterator_base0 {
public:
    static constexpr bool _Unwrap_when_unverified = true;

protected:
    static constexpr void _Orphan_me() noexcept {}
    static constexpr void _Adopt(const _Hive_block_base*) noexcept {}
};

struct _Hive_iterator_base12_base {
    // _Orphan leaves these pointers unchanged; their values can distinguish default-initialized iterators from
    // invalidated ones
    mutable const _Hive_iterator_base12_base* _Mypreviter = nullptr;
    mutable const _Hive_iterator_base12_base* _Mynextiter = nullptr;
};

struct _Hive_block_base {
#if _ITERATOR_DEBUG_LEVEL != 0
    mutable _Hive_iterator_base12_base _Sent_iter{_STD addressof(_Sent_iter), _STD addressof(_Sent_iter)};
    mutable const _Hive_val_empty_base* _Mycont = nullptr;
#endif // _ITERATOR_DEBUG_LEVEL != 0
};

class _Hive_iterator_base12 : protected _Hive_iterator_base12_base {
public:
    static constexpr bool _Unwrap_when_unverified = _ITERATOR_DEBUG_LEVEL == 0;

protected:
    template <class _Val_types>
    friend struct _Hive_val_provider;

    mutable const _Hive_block_base* _Myblock = nullptr;

    constexpr _Hive_iterator_base12() noexcept = default;

    constexpr _Hive_iterator_base12(const _Hive_iterator_base12& _Right) {
        *this = _Right;
    }

    constexpr _Hive_iterator_base12& operator=(const _Hive_iterator_base12& _Right) {
        if (_Right._Myblock == nullptr) {
            _Orphan_me();
            _Mypreviter = _Right._Mypreviter;
            _STL_INTERNAL_CHECK(_Is_invalid() == _Right._Is_invalid());
            _STL_INTERNAL_CHECK(_Is_value_initialized() == _Right._Is_value_initialized());
        } else {
            this->_Adopt(_Right._Myblock);
        }
        return *this;
    }

    constexpr ~_Hive_iterator_base12() noexcept {
        _Orphan_me();
    }

    constexpr void _Orphan_me() const noexcept {
        if consteval {
            _Orphan_me_unlocked();
        } else {
            _Orphan_me_locked();
        }
    }
    constexpr void _Adopt(const _Hive_block_base* _Parent) const noexcept {
        if consteval {
            this->_Adopt_unlocked(_Parent);
        } else {
            this->_Adopt_locked(_Parent);
        }
    }

    _NODISCARD constexpr bool _Is_value_initialized() const noexcept {
        return _Mypreviter == nullptr;
    }
    _NODISCARD constexpr bool _Is_invalid() const noexcept {
        return _Myblock == nullptr && _Mypreviter != nullptr;
    }

    constexpr void _Adopt_unlocked([[maybe_unused]] const _Hive_block_base* _Parent) const noexcept {
#if _ITERATOR_DEBUG_LEVEL != 0
        if (_Myblock == _Parent) {
            return;
        }
        _Orphan_me_unlocked();
        if (_Parent != nullptr) {
            _Myblock                                      = _Parent;
            _Mypreviter                                   = _Myblock->_Sent_iter._Mypreviter;
            _Mynextiter                                   = _STD addressof(_Myblock->_Sent_iter);
            _Myblock->_Sent_iter._Mypreviter->_Mynextiter = this;
            _Myblock->_Sent_iter._Mypreviter              = this;
        }
#endif // _ITERATOR_DEBUG_LEVEL != 0
    }
    void _Adopt_locked(const _Hive_block_base* _Parent) const noexcept {
        _Lockit _Lock(_LOCK_DEBUG);
        this->_Adopt_unlocked(_Parent);
    }

    constexpr void _Orphan_me_unlocked() const noexcept {
        if (_Myblock == nullptr) {
            return;
        }

        _Myblock                 = nullptr;
        _Mypreviter->_Mynextiter = _Mynextiter;
        _Mynextiter->_Mypreviter = _Mypreviter;
    }
    void _Orphan_me_locked() const noexcept {
        _Lockit _Lock(_LOCK_DEBUG);
        _Orphan_me_unlocked();
    }
};

