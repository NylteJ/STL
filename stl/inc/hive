        template <class _Alloc>
        static constexpr void _Guess_median_median_of_medians(
            const _Iter& _First, const _Iter& _Mid, _Diff _Length, _Pr _Pred, _Alloc& _Al) {
            const auto _Median_count = static_cast<_Diff>(_Length / 5);
            const _Iter _Median_last = _Fallback_bidi::_Collect_medians_of_five(_First, _Median_count, _Pred);

            const auto _Median_mid = _RANGES next(_First, static_cast<_Diff>(_Median_count >> 1));
            _Fallback_bidi::_Nth_element_unchecked(_First, _Median_mid, _Median_last, _Median_count, _Pred, _Al);

            swap(*_Median_mid, *_Mid); // intentional ADL
        }

        template <class _Alloc>
        _NODISCARD static constexpr _Partition_result _Partition_by_median_guess_unchecked(
            const _Iter& _First, const _Iter& _Last, _Diff _Count, _Pr _Pred, _Alloc& _Al) {
            _STL_INTERNAL_CHECK(_RANGES distance(_First, _Last) == _Count);
            // partition [_First, _Last)
            _Iter _Mid = _RANGES next(_First, static_cast<_Diff>(_Count >> 1)); // shift for codegen
            _Fallback_bidi::_Guess_median_median_of_medians(_First, _Mid, _Count, _Pred, _Al);

            return _STD _Partition_by_pivot_unchecked(_First, _Mid, _Last, _Pred);
        }
    };

    static constexpr void _Guess_median_unchecked(
        const _Iter& _First, const _Iter& _Mid, const _Iter& _Last, _Diff _Count, _Pr _Pred) {
        // sort median element to middle
        if (40 < _Count) { // Tukey's ninther
            const auto _Step =
                static_cast<_Diff>((_Count + 1) >> 3); // +1 can't overflow because range was made inclusive in caller

            const auto _First_plus_step  = _RANGES next(_First, _Step);
            const auto _First_plus_2step = _RANGES next(_First_plus_step, _Step);
            const auto _Mid_plus_step    = _RANGES next(_Mid, _Step);
            const auto _Mid_minus_step   = _RANGES prev(_Mid, _Step);
            const auto _Last_minus_step  = _RANGES prev(_Last, _Step);
            const auto _Last_minus_2step = _RANGES prev(_Last_minus_step, _Step);

            _STD _Med3_unchecked(_First, _First_plus_step, _First_plus_2step, _Pred);
            _STD _Med3_unchecked(_Mid_minus_step, _Mid, _Mid_plus_step, _Pred);
            _STD _Med3_unchecked(_Last_minus_2step, _Last_minus_step, _Last, _Pred);
            _STD _Med3_unchecked(_First_plus_step, _Mid, _Last_minus_step, _Pred);
        } else {
            _STD _Med3_unchecked(_First, _Mid, _Last, _Pred);
        }
    }

    _NODISCARD static constexpr _Partition_result _Partition_by_median_guess_unchecked(
        const _Iter& _First, const _Iter& _Last, _Diff _Count, _Pr _Pred) {
        // partition [_First, _Last)
        _Iter _Mid = _RANGES next(_First, static_cast<_Diff>(_Count >> 1)); // shift for codegen
        _Sorter::_Guess_median_unchecked(_First, _Mid, _STD _Prev_iter(_Last), static_cast<_Diff>(_Count - 1), _Pred);

        return _STD _Partition_by_pivot_unchecked(_First, _Mid, _Last, _Pred);
    }

    template <class _Alloc>
    static constexpr _Iter _Insertion_sort_unchecked(const _Iter& _First, const _Iter& _Last, _Pr _Pred, _Alloc& _Al) {
        // insertion sort [_First, _Last)
        if (_First != _Last) {
            for (_Iter _Mid = _First; ++_Mid != _Last;) { // order next element
                _Iter _Hole = _Mid;
                _Alloc_temporary2<_Alloc> _Val(_Al, _STD move(*_Mid));

                if (_DEBUG_LT_PRED(_Pred, _Val._Get_value(), *_First)) { // found new earliest element, move to front
                    _STD _Move_backward_unchecked(_First, _Mid, ++_Hole);
                    *_First = _STD move(_Val._Get_value());
                } else { // look for insertion point after first
                    for (_Iter _Prev = _Hole; _DEBUG_LT_PRED(_Pred, _Val._Get_value(), *--_Prev); _Hole = _Prev) {
                        *_Hole = _STD move(*_Prev); // move hole down
                    }

                    *_Hole = _STD move(_Val._Get_value()); // insert element in hole
                }
            }
        }

        return _Last;
    }

public:
    template <class _Alloc>
    static constexpr void _Sort(_Iter _First, _Iter _Last, _Diff _Count, _Diff _Ideal, _Pr _Pred, _Alloc& _Al) {
        // see also _Sort_unchecked
        for (;;) {
            _STL_INTERNAL_CHECK(_Count == _RANGES distance(_First, _Last));

            if (_Count <= _ISORT_MAX) { // small
                _Sorter::_Insertion_sort_unchecked(_First, _Last, _Pred, _Al);
                return;
            }

            _Partition_result _Mid;
            if (_Ideal <= 0) {
                if constexpr (random_access_iterator<_Iter>) { // heap sort if too many divisions
                    _Fallback_rand<_Alloc>::_Make_heap_unchecked(_First, _Last, _Pred, _Al);
                    _Fallback_rand<_Alloc>::_Sort_heap_unchecked(_First, _Last, _Pred, _Al);
                    return;
                } else { // pick pivot by median-of-medians if too many divisions
                    _Mid = _Fallback_bidi::_Partition_by_median_guess_unchecked(_First, _Last, _Count, _Pred, _Al);
                }
            } else {
                _Mid = _Sorter::_Partition_by_median_guess_unchecked(_First, _Last, _Count, _Pred);
            }

            // divide and conquer by quicksort

            _Ideal = static_cast<_Diff>((_Ideal >> 1) + (_Ideal >> 2)); // allow 1.5 log2(N) divisions

            const auto _First_half_dist  = _RANGES distance(_First, _Mid.first);
            const auto _Second_half_dist = _RANGES distance(_Mid.second, _Last);
            if (_First_half_dist < _Second_half_dist) { // loop on second half
                _Sorter::_Sort(_First, _Mid.first, _First_half_dist, _Ideal, _Pred, _Al);
                _First = _Mid.second;
                _Count = _Second_half_dist;
            } else { // loop on first half
                _Sorter::_Sort(_Mid.second, _Last, _Second_half_dist, _Ideal, _Pred, _Al);
                _Last  = _Mid.first;
                _Count = _First_half_dist;
            }
        }
    }

    template <class _Alloc>
    static constexpr void _Sort(_Iter _First, _Iter _Last, _Pr _Pred, _Alloc& _Al)
        requires sized_sentinel_for<_Iter, _Iter>
    {
        const auto _Dist = _Last - _First;
        _Sorter::_Sort(_STD move(_First), _STD move(_Last), _Dist, _Dist, _Pred, _Al);
    }
};

template <class _BlockSizeT, class _Ty>
class _Hive_lambdas {
public:
    using _Mode_t = uint8_t;
    enum : _Mode_t { _Copy = 1 << 1, _Move = 1 << 2, _Uninit = 1 << 3, _Init = 1 << 4 };

private:
    using _Block_size_t = _BlockSizeT;

    template <_Mode_t _Mode, class _DstIt, class _ValTy>
    static constexpr void _Do_output(_DstIt& _Dst, _ValTy&& _Val) {
        using _Cast_type = conditional_t<static_cast<bool>(_Mode & _Move), remove_reference_t<_ValTy>&&, _ValTy&&>;
        if constexpr (_Mode & _Uninit) {
            _Dst._Emplace(static_cast<_Cast_type>(_Val));
        } else {
            *_Dst = static_cast<_Cast_type>(_Val);
            ++_Dst;
        }
    }

    template <_Mode_t _Mode, class _SrcIt, class _DstIt>
    static constexpr void _Do_copy_move(_SrcIt& _Src, _Block_size_t _Cnt, _DstIt& _Dst) {
        _STL_INTERNAL_CHECK(_Cnt > 0);
        do {
            _Do_output<_Mode>(_Dst, *_Src);
            ++_Src;
            --_Cnt;
        } while (_Cnt != 0);
    }

public:
    template <_Mode_t _Mode>
    _NODISCARD static constexpr auto _Fill_blk(const _Ty& _Val) noexcept {
        _STL_INTERNAL_STATIC_ASSERT(!(_Mode & (_Copy | _Move)));
        return [&]<class _DstIt>(_DstIt&& _Dest, _Block_size_t _Cnt) {
            _STL_INTERNAL_CHECK(_Cnt > 0);
            do {
                _Do_output<_Mode>(_Dest, _Val);
                --_Cnt;
            } while (_Cnt != 0);
        };
    }

    template <_Mode_t _Mode, class _SrcIt>
    _NODISCARD static constexpr auto _Copy_move_to_blk(_SrcIt& _Src) noexcept {
        return [&](auto&& _Dst, _Block_size_t _Cnt) { _Do_copy_move<_Mode>(_Src, _Cnt, _Dst); };
    }
    template <_Mode_t _Mode, class _DstIt>
    _NODISCARD static constexpr auto _Copy_move_from_blk(_DstIt& _Dst) noexcept {
        return [&](auto&& _Src, _Block_size_t _Cnt) { _Do_copy_move<_Mode>(_Src, _Cnt, _Dst); };
    }

    template <_Mode_t _Mode, class _DstIt>
    _NODISCARD static constexpr auto _Copy_move_from_blk_bounded(_DstIt& _Dst, _Block_size_t& _Dst_cnt) noexcept {
        return [&]<class _SrcIt>(_SrcIt _Src_fst, const _SrcIt& _Src_lst) {
            _STL_INTERNAL_CHECK(_Src_fst != _Src_lst);
            _STL_INTERNAL_CHECK(_Dst_cnt > 0);
            do {
                _Do_output<_Mode>(_Dst, *_Src_fst);
                ++_Src_fst;
                --_Dst_cnt;
            } while (_Src_fst != _Src_lst && _Dst_cnt != 0);
            return _Src_fst;
        };
    }
};

template <class _ValueType, class _SizeType, class _DifferenceType, class _Pointer, class _ConstPointer>
struct _Hive_val_provider {
    struct _Val : _Hive_val_empty_base {
        using value_type      = _ValueType;
        using pointer         = _Pointer;
        using const_pointer   = _ConstPointer;
        using reference       = value_type&;
        using const_reference = const value_type&;
        using size_type       = _SizeType;
        using difference_type = _DifferenceType;

        using _Block        = _Hive_block_provider<value_type, size_type, pointer>::_Block;
        using _Block_ptr    = _Block::_Block_ptr;
        using _Block_size_t = _Block::_Size_t;

        using _Union     = _Block::_Union;
        using _Union_ptr = _Block::_Union_ptr;

        using _Limits_t = _Hive_limits_small<_Block_size_t>;

        using _Block_iters_provider = _Hive_block_iterators_provider<_Block, _Block_ptr>;
        using _Block_iter_active    = _Block_iters_provider::_Active_iterator;
        using _Block_iter_nonfull   = _Block_iters_provider::_Nonfull_iterator;
        using _Block_iter_reserved  = _Block_iters_provider::_Reserved_iterator;

        static constexpr bool _Bitset_mode = _Block::_Bitset_mode;

        using _Iters_provider            = _Hive_iterators_provider<_Val>;
        using iterator                   = _Iters_provider::iterator;
        using const_iterator             = _Iters_provider::const_iterator;
        using _Unchecked_iterator        = _Iters_provider::_Unchecked_iterator;
        using _Unchecked_const_iterator  = _Iters_provider::_Unchecked_const_iterator;
        using _Local_iterator            = _Iters_provider::_Local_iterator;
        using _Local_iterator_idl_common = _Iters_provider::_Local_iterator_idl_common;

        using _Local_ptr = _Hive_local_ptr_provider<_Union_ptr, pointer>::_Lptr;

        using _Lambdas = _Hive_lambdas<_Block_size_t, value_type>;

        static constexpr auto _Sentinel_ord_id = _STD _Max_limit<size_type>();

        _Block _Sent_block = _Block::_Sentinel(_Sent_block);
        _Block_iter_reserved _Reserved_first{nullptr};

        size_type _Size     = 0;
        size_type _Capacity = 0;

        _Limits_t _Limits;

        constexpr explicit _Val(_Limits_t _Limits_) noexcept : _Limits(_Limits_) {
#if _ITERATOR_DEBUG_LEVEL != 0
            _Sent_block._Mycont = this;
#endif // _ITERATOR_DEBUG_LEVEL != 0
        }

        _NODISCARD constexpr _Block_iter_active _Active_begin() const noexcept {
            return _Block_iter_active{_Sent_block._Next};
        }
        _NODISCARD constexpr _Block_iter_nonfull _Nonfull_begin() const noexcept {
            return _Block_iter_nonfull{_Sent_block._Next_nonfull};
        }
        _NODISCARD constexpr _Block_ptr _Sent() noexcept {
            return pointer_traits<_Block_ptr>::pointer_to(_Sent_block);
        }

        constexpr void _Swap(_Val& _Right) noexcept {
            _STL_INTERNAL_CHECK(this != _STD addressof(_Right));

            _Orphan_end();
            _Right._Orphan_end();

            _Reserved_first._Swap(_Right._Reserved_first);
            _STD swap(_Size, _Right._Size);
            _STD swap(_Capacity, _Right._Capacity);
            _STD swap(_Limits, _Right._Limits);

            swap(_Sent_block._Next, _Right._Sent_block._Next); // intentional ADL
            swap(_Sent_block._Prev, _Right._Sent_block._Prev); // intentional ADL
            swap(_Sent_block._Next_nonfull, _Right._Sent_block._Next_nonfull); // intentional ADL
            swap(_Sent_block._Prev_nonfull, _Right._Sent_block._Prev_nonfull); // intentional ADL

            constexpr auto _Adapt_blocks = [](_Block_ptr _Sent, _Block_ptr _Other_sent) static {
                if (_Sent->_Next == _Other_sent) {
                    _Sent->_Next = _Sent->_Prev = _Sent;
                    _Sent->_Next_nonfull = _Sent->_Prev_nonfull = _Sent;
                } else {
                    _Sent->_Next->_Prev = _Sent->_Prev->_Next = _Sent;
                    if (_Sent->_Next_nonfull == _Other_sent) {
                        _Sent->_Next_nonfull = _Sent->_Prev_nonfull = _Sent;
                    } else {
                        _Sent->_Next_nonfull->_Prev_nonfull = _Sent->_Prev_nonfull->_Next_nonfull = _Sent;
                    }
                }
            };

            _Adapt_blocks(_Sent(), _Right._Sent());
            _Adapt_blocks(_Right._Sent(), _Sent());

#if _ITERATOR_DEBUG_LEVEL != 0
            _Adopt_all(this);
            _Right._Adopt_all(_STD addressof(_Right));
#endif // _ITERATOR_DEBUG_LEVEL != 0
        }

        constexpr void _Move_from(_Val& _Right) noexcept {
            _STL_INTERNAL_CHECK(_Sent_block._Next == _Sent() && _Sent_block._Prev == _Sent());
            _STL_INTERNAL_CHECK(_Sent_block._Next_nonfull == _Sent() && _Sent_block._Prev_nonfull == _Sent());
            _STL_INTERNAL_CHECK(_Reserved_first == nullptr);
            _STL_INTERNAL_CHECK(_Limits == _Right._Limits);
            _STL_INTERNAL_CHECK(_Size == 0 && _Capacity == 0);

            _Right._Orphan_end();

            if (_Right._Capacity == 0) {
                return;
            }

            _Block_iter_active{_Sent()}._Splice_before(_Right._Sent());
            _Block_iter_nonfull{_Sent()}._Splice_before(_Right._Sent());

            _Reserved_first = _STD exchange(_Right._Reserved_first, _Block_iter_reserved{nullptr});
            _Size           = _STD exchange(_Right._Size, size_type{0});
            _Capacity       = _STD exchange(_Right._Capacity, size_type{0});

            _Adopt_all(this);
        }

        template <class _Fn>
        static constexpr void _Visit_block_iter_n(_Block_ptr _Blk, _Fn _Func) {
            // pass wrapped pointer when the block is full to enable further optimizations
            if (_Blk->_Full()) {
                _Func(_Local_ptr{_Blk->_Data}, _Blk->_Capacity);
            } else {
                _Func(_Local_iterator{_Blk, _Blk->_First_element()}, _Blk->_Size);
            }
        }

        template <class _Fn>
        static constexpr _Block_size_t _With_block_iter(_Block_ptr _Blk, _Block_size_t _Index, _Fn _Func) {
            // pass wrapped pointer when the block is full to enable further optimizations
            if (_Blk->_Full()) {
                return static_cast<_Block_size_t>(_Func(_Local_ptr{_Blk->_Data + _Index})._Raw - _Blk->_Data);
            } else {
                return _Func(_Local_iterator{_Blk, _Index})._Index;
            }
        }

        template <class _Fn>
        static constexpr _Block_size_t _With_block_iters(
            _Block_ptr _Blk, _Block_size_t _First, _Block_size_t _Last, _Fn _Func) {
            // pass wrapped pointers when the block is full to enable further optimizations
            if (_Blk->_Full()) {
                return static_cast<_Block_size_t>(
                    _Func(_Local_ptr{_Blk->_Data + _First}, _Local_ptr{_Blk->_Data + _Last})._Raw - _Blk->_Data);
            } else {
                return _Func(_Local_iterator{_Blk, _First}, _Local_iterator{_Blk, _Last})._Index;
            }
        }

        template <class _ValTy>
        _NODISCARD _ValTy* _Find_buffer_inplace(size_t _Count) const noexcept {
            constexpr size_t _Max_align_padding =
                alignof(_ValTy) > alignof(_Union) ? (alignof(_ValTy) - alignof(_Union)) : 0uz;

            constexpr auto _Convert_result = [](_Union_ptr _Ptr) static {
                void* _Raw = _STD to_address(_Ptr);
                if constexpr (_Max_align_padding > 0) {
                    size_t _Dummy_space = _STD _Max_limit<size_t>();
                    _STD align(alignof(_ValTy), 0, _Raw, _Dummy_space);
                }
                _STL_INTERNAL_CHECK(reinterpret_cast<uintptr_t>(_Raw) % alignof(_ValTy) == 0);
                return reinterpret_cast<_ValTy*>(_Raw);
            };

            const size_t _Required_bytes    = _Count * sizeof(_ValTy) + _Max_align_padding;
            const size_t _Required_capacity = (_Required_bytes + (sizeof(_Union) - 1)) / sizeof(_Union);

            // find free space past the last element
            if (_Size != 0) {
                const auto& _Blk                    = *_Sent_block._Prev;
                const _Block_size_t _Space_past_end = _Blk._Skip[_Blk._Capacity - 1];

                // skip the last union to preserve the free list node or skip count
                if (_Space_past_end >= _Required_capacity + 1) {
                    return _Convert_result(_Blk._Data + _Blk._Capacity - _Space_past_end);
                }
            }

            // find free space in the first (and usually largest) reserved block
            const auto _Reserved = _Reserved_first;
            if (_Reserved != nullptr && _Reserved->_Capacity >= _Required_capacity) {
                return _Convert_result(_Reserved->_Data);
            }

            return nullptr;
        }

#if _ITERATOR_DEBUG_LEVEL == 0
        constexpr void _Orphan_block(const _Block&) const noexcept {}
        constexpr void _Orphan_range(const _Block&, _Block_size_t, _Block_size_t) const noexcept {}
        constexpr void _Orphan_nonend() const noexcept {}
        constexpr void _Orphan_end() const noexcept {}

        constexpr void _Adopt_all(const _Hive_val_empty_base*) const noexcept {}
#else // ^^^ _ITERATOR_DEBUG_LEVEL == 0 / _ITERATOR_DEBUG_LEVEL > 0 vvv
        constexpr void _Orphan_block(const _Block& _Blk) const noexcept {
            if consteval {
                _Orphan_block_unlocked(_Blk);
            } else {
                _Orphan_block_locked(_Blk);
            }
        }
        constexpr void _Orphan_range(const _Block& _Blk, _Block_size_t _First, _Block_size_t _Last) const noexcept {
            if consteval {
                _Orphan_range_unlocked(_Blk, _First, _Last);
            } else {
                _Orphan_range_locked(_Blk, _First, _Last);
            }
        }
        constexpr void _Orphan_nonend() const noexcept {
            if consteval {
                _Orphan_nonend_unlocked();
            } else {
                _Orphan_nonend_locked();
            }
        }
        constexpr void _Orphan_end() const noexcept {
            if consteval {
                _Orphan_end_unlocked();
            } else {
                _Orphan_end_locked();
            }
        }

        constexpr void _Adopt_all(const _Hive_val_empty_base* _Parent) const noexcept {
            // Note: No debug lock needed here, as we are working with blocks instead of iterators.
            const auto _Last = const_cast<_Val*>(this)->_Sent();
            for (auto _Blk = _Active_begin(); _Blk != _Last; ++_Blk) {
                _Blk->_Mycont = _Parent;
            }
        }

        _NODISCARD constexpr bool _Is_parent_of(const _Local_iterator_idl_common& _Iter) const noexcept {
            return _Iter._Myblock != nullptr && _Iter._Myblock->_Mycont == this;
        }
        _NODISCARD constexpr bool _Is_parent_of(const _Local_iterator& _Iter) const noexcept {
            return _Iter._Blk->_Mycont == this;
        }

        constexpr void _Orphan_block_unlocked(const _Block& _Blk) const noexcept {
            const auto _Last_iter = _STD addressof(_Blk._Sent_iter);
            for (auto _Iter = _Blk._Sent_iter._Mynextiter; _Iter != _Last_iter; _Iter = _Iter->_Mynextiter) {
                static_cast<const _Hive_iterator_base12&>(*_Iter)._Myblock = nullptr;
            }
            _Blk._Sent_iter._Mynextiter = _Blk._Sent_iter._Mypreviter = _Last_iter;
        }
        void _Orphan_block_locked(const _Block& _Blk) const noexcept {
            _Lockit _Lock(_LOCK_DEBUG);
            _Orphan_block_unlocked(_Blk);
        }

        constexpr void _Orphan_range_unlocked(
            const _Block& _Blk, _Block_size_t _First, _Block_size_t _Last) const noexcept {
            const auto _Lst = _STD addressof(_Blk._Sent_iter);
            for (auto _Fst = _Blk._Sent_iter._Mynextiter; _Fst != _Lst;) {
                const auto _Next      = _Fst->_Mynextiter;
                const auto& _Fst_iter = static_cast<const _Local_iterator_idl_common&>(*_Fst);
                if (_First <= _Fst_iter._Index && _Fst_iter._Index < _Last) {
                    _Fst_iter._Orphan_me_unlocked();
                }
                _Fst = _Next;
            }
        }
        void _Orphan_range_locked(const _Block& _Blk, _Block_size_t _First, _Block_size_t _Last) const noexcept {
            _Lockit _Lock(_LOCK_DEBUG);
            _Orphan_range_unlocked(_Blk, _First, _Last);
        }

        constexpr void _Orphan_nonend_unlocked() const noexcept {
            const auto _Last_blk = const_cast<_Val*>(this)->_Sent();
            for (auto _Blk = _Active_begin(); _Blk != _Last_blk; ++_Blk) {
                _Orphan_block_unlocked(*_Blk);
            }
        }
        void _Orphan_nonend_locked() const noexcept {
            _Lockit _Lock(_LOCK_DEBUG);
            _Orphan_nonend_unlocked();
        }

        constexpr void _Orphan_end_unlocked() const noexcept {
            _Orphan_block_unlocked(_Sent_block);
        }
        void _Orphan_end_locked() const noexcept {
            _Lockit _Lock(_LOCK_DEBUG);
            _Orphan_end_unlocked();
        }
#endif // ^^^ _ITERATOR_DEBUG_LEVEL > 0 ^^^
    };
};

template <class _HiveIt, class _Diff>
constexpr void _Hive_algorithms::_Advance(_HiveIt& _Where, _Diff _Offset) {
    _STL_INTERNAL_STATIC_ASSERT(_Is_hive_iterator<_HiveIt>);

    constexpr bool _Should_check = _ITERATOR_DEBUG_LEVEL != 0 && _Unwrappable_v<_HiveIt>;

    if (_Offset == 0) {
        return;
    }

    if constexpr (_Should_check) {
        _STL_VERIFY(!_Where._Is_value_initialized(), "cannot advance value-initialized hive iterator");
        _STL_VERIFY(!_Where._Is_invalid(), "cannot advance invalid hive iterator");
    }

    using _Diff_t    = iter_difference_t<_HiveIt>;
    using _Scary_val = _HiveIt::_Hive_scary_val;

    if constexpr (_Should_check) {
        _STL_VERIFY(_STD in_range<_Diff_t>(_Offset), "hive advance offset out of range");
    }
    auto _Off = static_cast<_Diff_t>(_Offset);

    if (_Off > 0) {
        if constexpr (_Should_check) {
            _STL_VERIFY(!_Where._Is_end(), "cannot increment end hive iterator");
        }

        if (_Where._Index != _Where._Blk->_First_element()) {
            // iterator not at beginning of current block
            _Where._Index = _Scary_val::_With_block_iters(
                _Where._Blk, _Where._Index, _Where._Blk->_Capacity, [&_Off](auto _Where_local, const auto& _Blk_last) {
                    _Off = static_cast<_Diff_t>(_RANGES advance(_Where_local, _Off, _Blk_last));
                    return _Where_local;
                });

            if (_Where._Index == _Where._Blk->_Capacity) {
                ++_Where._Blk;
                if (_Off == 0) {
                    _Where._Index = _Where._Blk->_First_element();
                    _Where._Adopt(_STD to_address(_Where._Blk._Ptr()));
                    return;
                }
            } else {
                if (_Off == 0) {
                    return;
                }
            }
        }
        _STL_INTERNAL_CHECK(_Off > 0);

        if constexpr (_Should_check) {
            _STL_VERIFY(!_Where._Blk->_Is_sent(), "cannot advance hive iterator past the end");
        }

        // Now the iterator is at the beginning of the block, so we can skip an entire block at once.
        while (_Off >= _Where._Blk->_Size) {
            _Off -= _Where._Blk->_Size;
            ++_Where._Blk;
            if (_Off == 0) {
                _Where._Index = _Where._Blk->_First_element();
                _Where._Adopt(_STD to_address(_Where._Blk._Ptr()));
                return;
            }

            if constexpr (_Should_check) {
                _STL_VERIFY(!_Where._Blk->_Is_sent(), "cannot advance hive iterator past the end");
            }
        }
        _STL_INTERNAL_CHECK(_Off > 0);

        // the tail block
        _Where._Index = _Scary_val::_With_block_iter(_Where._Blk, _Where._Blk->_First_element(),
            [_Off](auto _Where_local) { return _RANGES next(_Where_local, _Off); });
        _Where._Adopt(_STD to_address(_Where._Blk._Ptr()));
    } else {
        if constexpr (_Should_check) {
            _STL_VERIFY(!_Where._Is_begin(), "cannot decrement begin hive iterator");
        }

        if (const auto _First_elem = _Where._Blk->_First_element(); _Where._Index != _First_elem) {
            // iterator not at beginning of current block
            _Where._Index = _Scary_val::_With_block_iters(
                _Where._Blk, _Where._Index, _First_elem, [&_Off](auto _Where_local, const auto& _Blk_first) {
                    _Off = static_cast<_Diff_t>(_RANGES advance(_Where_local, _Off, _Blk_first));
                    return _Where_local;
                });
            if (_Off == 0) {
                return;
            }
        }
        _STL_INTERNAL_CHECK(_Off < 0);

        if constexpr (_Should_check) {
            _STL_VERIFY(!_Where._Is_first_block(), "cannot decrement hive iterator before begin");
        }
        --_Where._Blk;

        // Now the iterator is at the beginning of the next block, which is equivalent to the end of the current block,
        // so we can skip an entire block at once.
        while (-_Off > _Where._Blk->_Size) {
            _Off += _Where._Blk->_Size;
            if constexpr (_Should_check) {
                _STL_VERIFY(!_Where._Is_first_block(), "cannot decrement hive iterator before begin");
            }
            --_Where._Blk;
        }
        _STL_INTERNAL_CHECK(_Off < 0);

        // the head block
        _Where._Index = _Scary_val::_With_block_iter(_Where._Blk, _Where._Blk->_Capacity,
            [_Off](auto _Where_local) { return _RANGES next(_Where_local, _Off); });
        _Where._Adopt(_STD to_address(_Where._Blk._Ptr()));
    }
}

template <class _HiveIt, class _HiveSe>
constexpr _Iter_diff_t<_HiveIt> _Hive_algorithms::_Distance(_HiveIt _First, const _HiveSe& _Last) {
    _STL_INTERNAL_STATIC_ASSERT(_Is_hive_iterator<_HiveIt> && _Is_hive_iterator<_HiveSe>);

    _STD _Adl_verify_range(_First, _Last);

    using _Diff_t    = iter_difference_t<_HiveIt>;
    using _Scary_val = _HiveIt::_Hive_scary_val;

    _Diff_t _Ret = 0;

    const auto _Accumulate_distance_local = [&_Ret](const auto& _First_local, const auto& _Last_local) {
        _Ret += static_cast<_Diff_t>(_RANGES distance(_First_local, _Last_local));
        return _First_local;
    };

    if (_First._Blk != _Last._Blk) {
        if (_First._Index != _First._Blk->_First_element()) {
            _Scary_val::_With_block_iters(
                _First._Blk, _First._Index, _First._Blk->_Capacity, _Accumulate_distance_local);
            ++_First._Blk;
        }

        for (; _First._Blk != _Last._Blk; ++_First._Blk) {
            _Ret += _First._Blk->_Size;
        }

        _First._Index = _First._Blk->_First_element();
    }

    _STL_INTERNAL_CHECK(_First._Blk == _Last._Blk);

    if (_First._Index != _Last._Index) {
        _Scary_val::_With_block_iters(_First._Blk, _First._Index, _Last._Index, _Accumulate_distance_local);
    }

    return _Ret;
}

template <class _HiveIt, class _HiveSe, class _Fn>
constexpr _HiveIt _Hive_algorithms::_For_each(_HiveIt _UFirst, const _HiveSe& _ULast, _Fn _Func) {
    _STL_INTERNAL_STATIC_ASSERT(_Is_hive_iterator<_HiveIt> && !_Unwrappable_v<_HiveIt>);
    _STL_INTERNAL_STATIC_ASSERT(_Is_hive_iterator<_HiveSe> && !_Unwrappable_v<_HiveSe>);

    using _Scary_val = _HiveIt::_Hive_scary_val;
    using _Ref       = iter_reference_t<_HiveIt>;

    const auto _For_each_local = [_Func = _STD _Pass_fn(_Func)](auto _First, const auto& _Last) mutable {
        _STL_INTERNAL_CHECK(_First != _Last);
        do {
            _Func(static_cast<_Ref>(*_First));
            ++_First;
        } while (_First != _Last);
        return _Last;
    };

    if (_UFirst._Blk != _ULast._Blk) {
        if (_UFirst._Index != _UFirst._Blk->_First_element()) {
            _Scary_val::_With_block_iters(_UFirst._Blk, _UFirst._Index, _UFirst._Blk->_Capacity, _For_each_local);
            ++_UFirst._Blk;
        }

        for (; _UFirst._Blk != _ULast._Blk; ++_UFirst._Blk) {
            _Scary_val::_Visit_block_iter_n(_UFirst._Blk, [_Func = _STD _Pass_fn(_Func)](auto _Fst, auto _Cnt) mutable {
                _STL_INTERNAL_CHECK(_Cnt != 0);
                do {
                    _Func(static_cast<_Ref>(*_Fst));
                    ++_Fst;
                    --_Cnt;
                } while (_Cnt != 0);
            });
        }

        _UFirst._Index = _UFirst._Blk->_First_element();
    }

    _STL_INTERNAL_CHECK(_UFirst._Blk == _ULast._Blk);

    if (_UFirst._Index != _ULast._Index) {
        _Scary_val::_With_block_iters(_UFirst._Blk, _UFirst._Index, _ULast._Index, _For_each_local);
    }

    return _HiveIt{_ULast._Blk, _ULast._Index};
}

template <class _Ty, class _Alloc>
class hive {
private:
    using _Alty        = _Rebind_alloc_t<_Alloc, _Ty>;
    using _Alty_traits = allocator_traits<_Alty>;

    static constexpr bool _Need_destruction =
        !conjunction_v<is_trivially_destructible<_Ty>, _Uses_default_destroy<_Alty, _Ty*>>;

public:
    static_assert(!_ENFORCE_MATCHING_ALLOCATORS || is_same_v<_Ty, typename _Alloc::value_type>,
        _MISMATCHED_ALLOCATOR_MESSAGE("hive<T, Allocator>", "T"));
    static_assert(is_object_v<_Ty>, "The C++ Standard forbids containers of non-object types "
                                    "because of [container.requirements].");

    // types
    using value_type      = _Ty;
    using allocator_type  = _Alloc;
    using pointer         = _Alty_traits::pointer;
    using const_pointer   = _Alty_traits::const_pointer;
    using reference       = value_type&;
    using const_reference = const value_type&;
    using size_type       = _Alty_traits::size_type;
    using difference_type = _Alty_traits::difference_type;

private:
    static constexpr bool _Alty_uses_default_max_size =
        disjunction_v<_Is_default_allocator<_Alloc>, negation<_Has_max_size<_Alty>>>;
    static constexpr bool _Max_limit_may_be_zero =
        !_Alty_uses_default_max_size || _STD _Max_limit<size_type>() / sizeof(_Ty) == 0;

    using _Scary_val = _Hive_val_provider<_Ty, size_type, difference_type, pointer, const_pointer>::_Val;

    using _Block_size_t = _Scary_val::_Block_size_t;

    using _Limits_t = _Scary_val::_Limits_t;

    using _Block        = _Scary_val::_Block;
    using _Alblk        = _Rebind_alloc_t<_Alloc, _Block>;
    using _Alblk_traits = allocator_traits<_Alblk>;
    using _Block_ptr    = _Scary_val::_Block_ptr;

    using _Union          = _Scary_val::_Union;
    using _Alunion        = _Rebind_alloc_t<_Alloc, _Union>;
    using _Alunion_traits = allocator_traits<_Alunion>;
    using _Union_ptr      = _Scary_val::_Union_ptr;

    using _Block_iter_active   = _Scary_val::_Block_iter_active;
    using _Block_iter_nonfull  = _Scary_val::_Block_iter_nonfull;
    using _Block_iter_reserved = _Scary_val::_Block_iter_reserved;

    using _Local_ptr                 = _Scary_val::_Local_ptr;
    using _Local_iterator            = _Scary_val::_Local_iterator;
    using _Local_iterator_idl_common = _Scary_val::_Local_iterator_idl_common;

    using _Lambdas = _Scary_val::_Lambdas;

    static constexpr auto _Sentinel_ord_id = _Scary_val::_Sentinel_ord_id;
    static constexpr auto _Bitset_mode     = _Scary_val::_Bitset_mode;

    // note that this may exceed `block_capacity_hard_limits().max` due to N5032 [hive.overview]/5.3
    static constexpr size_t _Hard_limits_max =
        _STD min<size_t>(_STD _Max_limit<_Block_size_t>(), _STD _Max_limit<size_type>());

    template <class _Iter>
    struct _NODISCARD _Local_backout_base {
        _STL_INTERNAL_STATIC_ASSERT(_Is_any_of_v<_Iter, _Local_ptr, pointer>);

        constexpr explicit _Local_backout_base(_Alty& _Al_, _Iter _Ptr) noexcept
            : _Al(_Al_), _First(_Ptr), _Last(_Ptr) {}

        _Local_backout_base(const _Local_backout_base&)            = delete;
        _Local_backout_base& operator=(const _Local_backout_base&) = delete;

        constexpr ~_Local_backout_base() noexcept {
            if constexpr (_Need_destruction) {
                for (; _First != _Last; ++_First) {
                    _Alty_traits::destroy(_Al, _STD to_address(_First));
                }
            }
        }

        template <class... _Valty>
        constexpr void _Emplace(_Valty&&... _Val) {
            _Alty_traits::construct(_Al, _STD to_address(_Last), _STD forward<_Valty>(_Val)...);
            ++_Last;
        }

        constexpr void _Release() noexcept {
            _First = _Last;
        }

        _Alty& _Al;
        _Iter _First;
        _Iter _Last;
    };

    using _Local_unions_backout = _Local_backout_base<_Local_ptr>;
    using _Local_elems_backout  = _Local_backout_base<pointer>;

    enum class _Temp_block_type { _New, _Reserved };

    template <_Temp_block_type _Type>
    class _NODISCARD _Temp_block {
    public:
        constexpr _Temp_block(hive& _Hive_, _Block_ptr _Blk_) noexcept
            : _Hive(_Hive_), _Blk(_Blk_), _Last(_Blk->_Data) {}

        _Temp_block(const _Temp_block&)            = delete;
        _Temp_block& operator=(const _Temp_block&) = delete;

        constexpr ~_Temp_block() noexcept {
            if (_Blk != nullptr) {
                if constexpr (_Need_destruction) {
                    for (_Local_ptr _Iter = _Blk->_Data; _Iter != _Last; ++_Iter) {
                        _Alty_traits::destroy(_Hive._Al, _STD to_address(_Iter));
                    }
                }

                if constexpr (_Type == _Temp_block_type::_New) {
                    _Hive._Dealloc_block(_Blk);
                }
            }
        }

        _NODISCARD constexpr _Block_size_t _Capacity() const noexcept {
            return _Blk->_Capacity;
        }

        // except order id
        _NODISCARD constexpr _Block_ptr _Init_and_release() noexcept {
            _Blk->_Init(static_cast<_Block_size_t>(_Last - _Blk->_Data));
#if _ITERATOR_DEBUG_LEVEL != 0
            _Blk->_Sent_iter._Mypreviter = _Blk->_Sent_iter._Mynextiter = _STD addressof(_Blk->_Sent_iter);
            _Blk->_Mycont                                               = _STD addressof(_Hive._Myval);
#endif // _ITERATOR_DEBUG_LEVEL != 0
            return _STD exchange(_Blk, nullptr);
        }

        _NODISCARD constexpr _Block_ptr _Uninit_release() noexcept {
            return _STD exchange(_Blk, nullptr);
        }

        template <class... _Valty>
        constexpr void _Emplace(_Valty&&... _Val) {
            _Alty_traits::construct(_Hive._Al, _STD to_address(_Last), _STD forward<_Valty>(_Val)...);
            ++_Last;
        }

    private:
        hive& _Hive;
        _Block_ptr _Blk;
        _Local_ptr _Last;
    };

    // Uninitialized block with contiguous elements. Destroys elements and deallocates the block if an exception is
    // thrown.
    using _Temp_new_block = _Temp_block<_Temp_block_type::_New>;
    // Uninitialized block with contiguous elements. Destroys elements if an exception is thrown.
    using _Temp_reserved_block = _Temp_block<_Temp_block_type::_Reserved>;

public:
    using iterator                  = _Scary_val::iterator;
    using const_iterator            = _Scary_val::const_iterator;
    using _Unchecked_iterator       = _Scary_val::_Unchecked_iterator;
    using _Unchecked_const_iterator = _Scary_val::_Unchecked_const_iterator;

    using reverse_iterator       = _STD reverse_iterator<iterator>;
    using const_reverse_iterator = _STD reverse_iterator<const_iterator>;

private:
    static constexpr void _Verify_limits([[maybe_unused]] hive_limits _Limits) noexcept {
#if _ITERATOR_DEBUG_LEVEL != 0
        _STL_VERIFY(_Limits.min <= _Limits.max, "hive limits min greater than max");
        const auto _Hard_limits = block_capacity_hard_limits();
        _STL_VERIFY(
            _Hard_limits.min <= _Limits.min && _Limits.max <= _Hard_limits.max, "hive limits outside hard limits");
#endif // _ITERATOR_DEBUG_LEVEL != 0
    }

#ifdef _ENABLE_STL_INTERNAL_CHECK
    constexpr void _Check_invariants() const noexcept {
        const auto _Sent = const_cast<_Scary_val&>(_Myval)._Sent();

        size_type _Actual_size = 0;
        size_type _Actual_cap  = 0;
        for (auto _Blk = _Myval._Active_begin(); _Blk != _Sent; ++_Blk) {
            _STL_INTERNAL_CHECK(_Blk->_Size > 0);

            _STL_INTERNAL_CHECK(_Blk->_Skip[_Blk->_Capacity] == 0);

            for (_Block_size_t _Idx = 0; _Idx != _Blk->_Capacity;) {
                if (_Blk->_Skip[_Idx] != 0) {
                    const auto _Length = _Blk->_Skip[_Idx];
                    const auto _Tail   = _Idx + _Length - 1;
                    _STL_INTERNAL_CHECK(0 < _Length && _Length <= _Blk->_Capacity - _Idx);
                    _STL_INTERNAL_CHECK(_Blk->_Skip[_Idx] == _Blk->_Skip[_Tail]);
                    _Idx += _Length;
                } else {
                    ++_Idx;
                }
            }

            if (!_Blk->_Full()) {
                const auto _First_free = _Blk->_First_free;
                const auto _First_node = _First_free + _Blk->_Skip[_First_free] - 1;
                _STL_INTERNAL_CHECK(_Blk->_Data[_First_node]._Free._Prev == _Block::_Free_npos);

                _Block_size_t _Space_count = 0;
                for (auto _Node = _First_node;;) {
                    const auto _Next_node = _Blk->_Data[_Node]._Free._Next;

                    _STL_INTERNAL_CHECK(_Blk->_Skip[_Node] > 0);
                    _Space_count += _Blk->_Skip[_Node];

                    if (_Next_node == _Block::_Free_npos) {
                        break;
                    }
                    _STL_INTERNAL_CHECK(_Blk->_Data[_Next_node]._Free._Prev == _Node);
                    _Node = _Next_node;
                }
                _STL_INTERNAL_CHECK(_Space_count == _Blk->_Capacity - _Blk->_Size);
            }

            _STL_INTERNAL_CHECK(_Blk->_Next->_Prev == _Blk);
            _STL_INTERNAL_CHECK(_Blk->_Capacity >= _Blk->_Size);
            _STL_INTERNAL_CHECK(_Myval._Limits._Contains(_Blk->_Capacity));
            _STL_INTERNAL_CHECK(_Blk->_Order_id < _Blk->_Next->_Order_id);

            _Actual_size += _Blk->_Size;
            _Actual_cap += _Blk->_Capacity;
        }
        _STL_INTERNAL_CHECK(_Myval._Size == _Actual_size);

        size_type _Active_space_count = 0;
        for (auto _Blk = _Myval._Nonfull_begin(); _Blk != _Sent; ++_Blk) {
            _STL_INTERNAL_CHECK(_Blk->_Next_nonfull->_Prev_nonfull == _Blk);
            const auto _Space_count = _Blk->_Capacity - _Blk->_Size;
            _STL_INTERNAL_CHECK(_Space_count > 0);
            _Active_space_count += static_cast<size_type>(_Space_count);
        }
        _STL_INTERNAL_CHECK(_Active_space_count == _Actual_cap - _Actual_size);

        for (auto _Blk = _Myval._Reserved_first; _Blk != nullptr; ++_Blk) {
            _STL_INTERNAL_CHECK(_Myval._Limits._Contains(_Blk->_Capacity));
            _Actual_cap += _Blk->_Capacity;
        }
        _STL_INTERNAL_CHECK(_Myval._Capacity == _Actual_cap);

        _STL_INTERNAL_CHECK(_Myval._Sent_block._Order_id == _Sentinel_ord_id);

#if _ITERATOR_DEBUG_LEVEL != 0
        const auto _Myval_addr = _STD addressof(_Myval);
        for (auto _Blk = _Myval._Active_begin(); _Blk != _Sent; ++_Blk) {
            _STL_INTERNAL_CHECK(_Blk->_Mycont == _Myval_addr);
            const auto _Blk_ptr = _STD to_address(_Blk._Ptr());
            const auto _Last    = _STD addressof(_Blk->_Sent_iter);
            for (auto _First = _Blk->_Sent_iter._Mynextiter; _First != _Last; _First = _First->_Mynextiter) {
                _STL_INTERNAL_CHECK(_First->_Mypreviter->_Mynextiter == _First);
                auto& _First_iter = static_cast<const _Local_iterator_idl_common&>(*_First);
                _STL_INTERNAL_CHECK(_First_iter._Myblock == _Blk_ptr);
            }
        }
#endif // _ITERATOR_DEBUG_LEVEL != 0
    }
#endif // ^^^ defined(_ENABLE_STL_INTERNAL_CHECK) ^^^

public:
    // [hive.cons], construct/copy/destroy
    constexpr hive() noexcept(noexcept(_Alloc())) : hive(_Alloc()) {}
    constexpr explicit hive(const _Alloc& _Allocator) noexcept : hive(block_capacity_default_limits(), _Allocator) {}
    constexpr explicit hive(hive_limits _Block_limits) noexcept(noexcept(_Alloc())) /* strengthened */
        : hive(_Block_limits, _Alloc()) {}
    constexpr hive(hive_limits _Block_limits, const _Alloc& _Allocator) noexcept /* strengthened */
        : _Al(_Allocator), _Myval(_Block_limits) {
        _Verify_limits(_Block_limits);
    }

private:
    // Adds the block to the active blocks list, and to the nonfull blocks list if not full.
    // Numbers the block, and renumbers all blocks if necessary.
    // Does not modify size or capacity.
    constexpr void _Activate_block(_Block_ptr _Blk) noexcept {
        _Block_iter_active{_Myval._Sent()}._Insert_before(_Blk);
        if (!_Blk->_Full()) {
            _Block_iter_nonfull{_Myval._Sent()}._Insert_before(_Blk);
        }

        auto _Ord_id = static_cast<size_type>(_Blk->_Prev->_Order_id + 1); // handles sentinel (wraps to 0)
        if (_Ord_id == _Sentinel_ord_id) {
            _Renumber_blocks();
            _Ord_id = static_cast<size_type>(_Blk->_Prev->_Order_id + 1);
        }
        _STL_INTERNAL_CHECK(_Ord_id != _Sentinel_ord_id);
        _Blk->_Order_id = _Ord_id;
    }

    // Adds the block to the reserved blocks list; does not modify size or capacity.
    constexpr void _Reserve_block(_Block_ptr _Blk) noexcept {
        _Blk->_Next            = _Myval._Reserved_first;
        _Myval._Reserved_first = _Block_iter_reserved{_Blk};
    }

    constexpr void _Renumber_blocks() noexcept {
        const auto _Sent = _Myval._Sent();
        for (auto _Blk = _Myval._Active_begin(); _Blk != _Sent; ++_Blk) {
            _Blk->_Order_id = static_cast<size_type>(_Blk->_Prev->_Order_id + 1);
            _STL_INTERNAL_CHECK(_Blk->_Order_id != _Sentinel_ord_id);
        }
    }

    _NODISCARD constexpr _Temp_new_block _Alloc_block(_Block_size_t _Block_cap) {
        _STL_INTERNAL_CHECK(_Myval._Limits._Contains(_Block_cap));
        _STL_INTERNAL_CHECK(_Block_cap > 0);
        _STL_INTERNAL_CHECK(_Block_cap <= max_size() - _Myval._Capacity);
        _STL_INTERNAL_STATIC_ASSERT(is_implicit_lifetime_v<_Block>);
        _STL_INTERNAL_STATIC_ASSERT(is_implicit_lifetime_v<_Union>);

        _Alblk _Alb(_Al);
        _Alloc_construct_ptr _New_block(_Alb);
        _New_block._Allocate();

        _Alunion _Alu(_Al);
        _Alloc_construct_n_ptr _New_data(_Alu, _Block_cap);
        _New_data._Allocate();

        {
            using _Skip_t     = _Block::_Skipfield_t;
            using _Alskip     = _Rebind_alloc_t<_Alloc, _Skip_t>;
            using _Alskp_size = _Alloc_size_t<_Alskip>;
            _Alskip _Als(_Al);
            _New_block._Ptr->_Skip =
                allocator_traits<_Alskip>::allocate(_Als, static_cast<_Alskp_size>(_Block_cap + 1uz),
                    _New_data._Ptr); // no need to be protected
            _STL_INTERNAL_STATIC_ASSERT(is_implicit_lifetime_v<_Skip_t>);
        }

        _New_block._Ptr->_Data     = _New_data._Release();
        _New_block._Ptr->_Capacity = _Block_cap;

        return _Temp_new_block{*this, _New_block._Release()};
    }

    [[noreturn]] static void _Xlength() {
        _STD _Xlength_error("hive too long");
    }

    // Allocates as precisely as possible, returns the actual allocated size.
    template <class _Fn>
    constexpr size_type _Alloc_exact_n(size_type _Count, _Fn _Func) {
        _STL_INTERNAL_CHECK(_Count > 0);
        const auto _Limits = _Myval._Limits;
        if constexpr (_Max_limit_may_be_zero) {
            if (_Limits.max == 0) {
                _Xlength();
            }
        }

        const auto _Block_count     = static_cast<size_type>((_Count + (_Limits.max - 1uz)) / _Limits.max);
        const auto _Base_elem_cnt   = static_cast<size_type>(_Block_count * _Limits.min);
        const auto _Actual_elem_cnt = (_STD max) (_Count, _Base_elem_cnt);

        if (_Actual_elem_cnt > max_size() - _Myval._Capacity) {
            _Xlength();
        }

        const auto _Extra_elem_cnt = static_cast<size_type>(_Actual_elem_cnt - _Base_elem_cnt);
        if (_Extra_elem_cnt == 0) {
            for (size_type _Idx = 0; _Idx != _Block_count; ++_Idx) {
                _Func(_Alloc_block(_Limits.min));
            }
        } else {
            const auto _Limits_length = _Limits.max - _Limits.min;
            _STL_INTERNAL_CHECK(_Limits_length != 0);
            const auto _Max_block_cnt = static_cast<size_type>(_Extra_elem_cnt / _Limits_length);
            const auto _Rest_elem_cnt = static_cast<size_type>(_Extra_elem_cnt % _Limits_length);

            _STL_INTERNAL_CHECK(_Max_block_cnt <= _Block_count);
            const auto _Nonmax_blk_cnt = static_cast<size_type>(_Block_count - _Max_block_cnt);
            if (_Nonmax_blk_cnt > 0) {
                for (size_type _Idx = 1; _Idx < _Nonmax_blk_cnt; ++_Idx) {
                    _Func(_Alloc_block(_Limits.min));
                }
                _Func(_Alloc_block(static_cast<_Block_size_t>(_Limits.min + _Rest_elem_cnt)));
            }
            for (size_type _Idx = 0; _Idx != _Max_block_cnt; ++_Idx) {
                _Func(_Alloc_block(_Limits.max));
            }
        }

        return _Actual_elem_cnt;
    }

    _NODISCARD constexpr _Temp_new_block _Alloc_blk_generously(size_type _Min_cap = 0) {
        if constexpr (_Max_limit_may_be_zero) {
            if (_Myval._Limits.max == 0) {
                _Xlength();
            }
        }

        const auto _Max_cap = static_cast<size_type>(max_size() - _Myval._Capacity);
        if (_Max_cap < _Myval._Limits.min || _Min_cap > _Max_cap) {
            _Xlength();
        }
        return _Alloc_block(_Myval._Limits._Clamp(_STD clamp(_Myval._Capacity, _Min_cap, _Max_cap)));
    }

    template <class _Fn>
    constexpr void _Alloc_generous_n(size_type _Count, _Fn _Func) {
        _STL_INTERNAL_CHECK(_Count > 0);
        const auto _Limits = _Myval._Limits;
        if constexpr (_Max_limit_may_be_zero) {
            if (_Limits.max == 0) {
                _Xlength();
            }
        }

        const auto _Max_block_cnt = static_cast<size_type>(_Count / _Limits.max);
        const auto _Rest_raw      = static_cast<size_type>(_Count % _Limits.max);

        if (_Max_block_cnt != 0) {
            const auto _Blk_cnt = _Max_block_cnt + (_Rest_raw != 0);

            if (_Blk_cnt * _Limits.max > max_size() - _Myval._Capacity) {
                _Alloc_exact_n(_Count, _STD _Pass_fn(_Func));
                return;
            }

            for (size_type _Idx = 0; _Idx != _Blk_cnt; ++_Idx) {
                _Func(_Alloc_block(_Limits.max));
            }
        } else {
            _Func(_Alloc_blk_generously(_Rest_raw));
        }
    }

    template <_Iterator_for_container _Iter, class _SizedOp, class _UnsizedOp>
    constexpr void _Dispatch_range_op(_Iter& _First, _Iter& _Last, _SizedOp _Sized, _UnsizedOp _Unsized) {
        _STD _Adl_verify_range(_First, _Last);
        auto&& _UFirst = _STD _Get_unwrapped(_STD move(_First));
        auto&& _ULast  = _STD _Get_unwrapped(_STD move(_Last));

        using _UIter = remove_cvref_t<decltype(_UFirst)>;

        if constexpr (sized_sentinel_for<_UIter, _UIter>) {
            const auto _Dist = _ULast - _UFirst;
#if _ITERATOR_DEBUG_LEVEL != 0
            _STL_VERIFY(_Dist >= 0, "input range transposed");
#endif // _ITERATOR_DEBUG_LEVEL != 0
            const auto _Size = _STD _Convert_size<size_type>(_STD _To_unsigned_like(_Dist));
            _Sized(_Size, _UFirst);
        } else {
            _Unsized(_UFirst, _ULast);
        }
    }

    template <_Container_compatible_range<_Ty> _Rng, class _SizedOp, class _UnsizedOp, class _ApproxedOp>
    constexpr void _Dispatch_range_op(_Rng& _Range, _SizedOp _Sized, _UnsizedOp _Unsized, _ApproxedOp _Approxed) {
        if constexpr (_RANGES sized_range<_Rng>) {
            const auto _Size = _STD _Convert_size<size_type>(_RANGES size(_Range));
            _Sized(_Size, _RANGES _Ubegin(_Range));
        } else {
#ifdef __cpp_lib_ranges_reserve_hint // TRANSITION, GH-5299
            if constexpr (_RANGES approximately_sized_range<_Rng>) {
                const auto _Approx_size = _STD _Convert_size<size_type>(_RANGES reserve_hint(_Range));
                _Approxed(_Approx_size, _RANGES _Ubegin(_Range), _RANGES _Uend(_Range));
            } else
#else // ^^^ defined(__cpp_lib_ranges_reserve_hint) / !defined(__cpp_lib_ranges_reserve_hint) vvv
            (void) _Approxed;
#endif // ^^^ !defined(__cpp_lib_ranges_reserve_hint) ^^^
            {
                _Unsized(_RANGES _Ubegin(_Range), _RANGES _Uend(_Range));
            }
        }
    }

    // Precisely allocates blocks, calls _Func to construct elements in, activates them, and sets size and capacity.
    // _Tidy *this if an exception is thrown; should only be called in constructors.
    template <class _Fn>
    constexpr void _Construct_n(size_type _Count, _Fn _Func) {
        if (_Count == 0) {
            return;
        }

        _Tidy_guard _Guard{this};

        _Myval._Size = _Count;
        _Myval._Capacity =
            _Alloc_exact_n(_Count, [this, &_Count, _Func = _STD _Pass_fn(_Func)](_Temp_new_block _Blk) mutable {
                const auto _Cnt =
                    static_cast<_Block_size_t>((_STD min) (_Count, static_cast<size_type>(_Blk._Capacity())));
                _STL_INTERNAL_CHECK(_Cnt > 0);

                _Func(_Blk, _Cnt);
                _Activate_block(_Blk._Init_and_release());

                _Count -= _Cnt;
            });

        _Guard._Target = nullptr;
    }

    // Returns a lambda that copies/moves elements from an active blocks list to the given destination.
    // If moving, destroys source elements and deallocates source blocks.
    template <typename _Lambdas::_Mode_t _Mode, class _Hive>
    _NODISCARD static constexpr auto _Copy_move_elems_from(
        _Block_iter_active& _Src_blk, _Block_size_t& _Src_idx, _Hive& _Src_hive) {
        return [&](auto&& _Dst, _Block_size_t _Dst_cnt) {
            _STL_INTERNAL_CHECK(_Dst_cnt != 0);
            do {
                _Src_idx = _Scary_val::_With_block_iters(_Src_blk, _Src_idx, _Src_blk->_Capacity,
                    _Lambdas::template _Copy_move_from_blk_bounded<_Mode>(_Dst, _Dst_cnt));

                if (_Src_idx != _Src_blk->_Capacity) {
                    _STL_INTERNAL_CHECK(_Dst_cnt == 0);
                    break;
                }

                if constexpr (_Mode & _Lambdas::_Move) {
                    const auto _Blk = _Src_blk++;
                    _Block_iter_active{_Blk}._Remove_from_list();
                    if (!_Blk->_Full()) {
                        _Block_iter_nonfull{_Blk}._Remove_from_list();
                    }
                    _Src_hive._Myval._Capacity -= _Blk->_Capacity;
                    _Src_hive._Myval._Size -= _Blk->_Size;
                    _Src_hive._Destroy_elems(_Blk);
                    _Src_hive._Dealloc_block(_Blk);
                } else {
                    ++_Src_blk;
                }
                _Src_idx = _Src_blk->_First_element();
            } while (_Dst_cnt != 0);
        };
    }

public:
    explicit hive(size_type _Count, const _Alloc& _Allocator = _Alloc())
        : hive(_Count, block_capacity_default_limits(), _Allocator) {}
    hive(size_type _Count, hive_limits _Block_limits, const _Alloc& _Allocator = _Alloc())
        : _Al(_Allocator), _Myval(_Block_limits) {
        _Verify_limits(_Block_limits);
        _Construct_n(_Count, [](_Temp_new_block& _Blk, _Block_size_t _Cnt) static {
            _STL_INTERNAL_CHECK(_Cnt > 0);
            do {
                _Blk._Emplace();
                --_Cnt;
            } while (_Cnt != 0);
        });
    }

    hive(size_type _Count, const _Ty& _Val, const _Alloc& _Allocator = _Alloc())
        : hive(_Count, _Val, block_capacity_default_limits(), _Allocator) {}
    hive(size_type _Count, const _Ty& _Val, hive_limits _Block_limits, const _Alloc& _Allocator = _Alloc())
        : _Al(_Allocator), _Myval(_Block_limits) {
        _Verify_limits(_Block_limits);
        _Construct_n(_Count, _Lambdas::template _Fill_blk<_Lambdas::_Uninit>(_Val));
    }

private:
    template <class _It, class _Se>
    constexpr void _Insert_unsized_rng_into_new_blocks(_It&& _First, _Se&& _Last) {
        while (_First != _Last) {
            _Temp_new_block _Tmp_blk = _Alloc_blk_generously();

            const auto _Blk_cap     = _Tmp_blk._Capacity();
            _Block_size_t _Blk_size = 0;
            _STL_INTERNAL_CHECK(_Blk_size != _Blk_cap && _First != _Last);
            do {
                _Tmp_blk._Emplace(*_First);
                ++_First;
                ++_Blk_size;
            } while (_Blk_size != _Blk_cap && _First != _Last);

            const auto _New_blk = _Tmp_blk._Init_and_release();
            _Myval._Size += _Blk_size;
            _Myval._Capacity += _Blk_cap;
            _Activate_block(_New_blk);
        }
    }

    template <class _It>
    constexpr void _Construct_sized_rng(size_type _Size, _It&& _First) {
        _Construct_n(_Size, _Lambdas::template _Copy_move_to_blk<_Lambdas::_Copy | _Lambdas::_Uninit>(_First));
    }

    template <class _It, class _Se>
    constexpr void _Construct_unsized_rng(_It&& _First, _Se&& _Last) {
        _Tidy_guard _Guard{this};
        _Insert_unsized_rng_into_new_blocks(_First, _Last);
        _Guard._Target = nullptr;
    }

public:
    template <_Iterator_for_container _Iter>
    hive(_Iter _First, _Iter _Last, const _Alloc& _Allocator = _Alloc())
        : hive(_STD move(_First), _STD move(_Last), block_capacity_default_limits(), _Allocator) {}
    template <_Iterator_for_container _Iter>
    hive(_Iter _First, _Iter _Last, hive_limits _Block_limits, const _Alloc& _Allocator = _Alloc())
        : _Al(_Allocator), _Myval(_Block_limits) {
        _Verify_limits(_Block_limits);
        _Dispatch_range_op(
            _First, _Last, [&](auto&&... _Args) { _Construct_sized_rng(_Args...); },
            [&](auto&&... _Args) { _Construct_unsized_rng(_Args...); });
    }

    template <_Container_compatible_range<_Ty> _Rng>
    hive(from_range_t, _Rng&& _Range, const _Alloc& _Allocator = _Alloc())
        : hive(from_range, _Range, block_capacity_default_limits(), _Allocator) {}
    template <_Container_compatible_range<_Ty> _Rng>
    hive(from_range_t, _Rng&& _Range, hive_limits _Block_limits, const _Alloc& _Allocator = _Alloc())
        : _Al(_Allocator), _Myval(_Block_limits) {
        _Verify_limits(_Block_limits);
        _Dispatch_range_op(
            _Range, [&](auto&&... _Args) { _Construct_sized_rng(_Args...); },
            [&](auto&&... _Args) { _Construct_unsized_rng(_Args...); },
            [&](size_type _Approx_size, auto&&... _Args) {
                _Tidy_guard _Guard{this};
                reserve(_Approx_size);
                _Insert_unsized_rng(_Args...);
                _Guard._Target = nullptr;
            });
    }

private:
    template <class _Hive>
    constexpr void _Copy_move_construct_one_by_one(_Hive&& _Right) {
        constexpr bool _Is_move = is_rvalue_reference_v<_Hive&&>;
        constexpr auto _Mode    = (_Is_move ? _Lambdas::_Move : _Lambdas::_Copy) | _Lambdas::_Uninit;

        auto _Src_blk = _Right._Myval._Active_begin();
        auto _Src_idx = _Src_blk->_First_element();

        _Construct_n(_Right._Myval._Size, _Copy_move_elems_from<_Mode>(_Src_blk, _Src_idx, _Right));
    }

public:
    hive(const hive& _Right) : hive(_Right, _Alty_traits::select_on_container_copy_construction(_Right._Al)) {}

    hive(hive&& _Right) noexcept : _Al(_STD move(_Right._Al)), _Myval(_Right._Myval._Limits) {
        _Myval._Move_from(_Right._Myval);
    }

    hive(const hive& _Right, const type_identity_t<_Alloc>& _Allocator)
        : _Al(_Allocator), _Myval(_Right._Myval._Limits) {
        _Copy_move_construct_one_by_one(_Right);
    }

    hive(hive&& _Right, const type_identity_t<_Alloc>& _Allocator)
        noexcept(_Alty_traits::is_always_equal::value) // strengthened
        : _Al(_Allocator), _Myval(_Right._Myval._Limits) {
        if constexpr (!_Alty_traits::is_always_equal::value) {
            if (_Allocator != _Right._Al) {
                _Right._Myval._Orphan_nonend();
                _Right._Myval._Orphan_end();
                _Copy_move_construct_one_by_one(_STD move(_Right));
                return;
            }
        }

        _Myval._Move_from(_Right._Myval);
    }

    hive(initializer_list<_Ty> _Ilist, const _Alloc& _Allocator = _Alloc()) : hive(from_range, _Ilist, _Allocator) {}
    hive(initializer_list<_Ty> _Ilist, hive_limits _Block_limits, const _Alloc& _Allocator = _Alloc())
        : hive(from_range, _Ilist, _Block_limits, _Allocator) {}

private:
    constexpr void _Destroy_elems(_Block_ptr _Blk) noexcept {
        if constexpr (_Need_destruction) {
            _Scary_val::_Visit_block_iter_n(_Blk, [this](auto _First, _Block_size_t _Cnt) {
                _STL_INTERNAL_CHECK(_Cnt > 0);
                do {
                    _Alty_traits::destroy(_Al, _STD addressof(*_First));
                    ++_First;
                    --_Cnt;
                } while (_Cnt != 0);
            });
        }
    }

    // does not destroy elements
    constexpr void _Dealloc_block(_Block_ptr _Blk) const noexcept {
        {
            using _Alskip = _Rebind_alloc_t<_Alloc, typename _Block::_Skipfield_t>;
            _Alskip _Als(_Al);
            allocator_traits<_Alskip>::deallocate(
                _Als, _Blk->_Skip, static_cast<_Alloc_size_t<_Alskip>>(_Blk->_Capacity + 1u));
        }
        {
            _Alunion _Alu(_Al);
            _Alunion_traits::deallocate(_Alu, _Blk->_Data, _Blk->_Capacity);
        }
        {
            _Alblk _Alb(_Al);
            _Alblk_traits::deallocate(_Alb, _Blk, 1);
        }
    }

    // Destroys all elements and deallocates all blocks.
    // Only uses the active blocks list and reserved blocks list.
    // Does not maintain invariants; call only in constructors and destructor.
    constexpr void _Tidy() noexcept {
        _Myval._Orphan_nonend();
        _Myval._Orphan_end();

        const auto _Sent = _Myval._Sent();
        for (auto _Blk = _Myval._Active_begin(); _Blk != _Sent;) {
            _Destroy_elems(_Blk);
            _Dealloc_block(_Blk++);
        }

        while (_Myval._Reserved_first != nullptr) {
            _Dealloc_block(_Myval._Reserved_first++);
        }
    }

    friend _Tidy_guard<hive>;

public:
    ~hive() noexcept {
#ifdef _ENABLE_STL_INTERNAL_CHECK
        _Check_invariants();
#endif // defined(_ENABLE_STL_INTERNAL_CHECK)

        _Tidy();
    }

private:
    template <class _It>
    constexpr void _Verify_iter_not_in_this([[maybe_unused]] const _It& _Iter) const noexcept {
#if _ITERATOR_DEBUG_LEVEL != 0
        if constexpr (_Is_hive_iterator<_It>) {
            _STL_VERIFY(!_Myval._Is_parent_of(_Iter), "source range overlaps hive");
        } else if constexpr (_Is_hive_riterator<_It>) {
            _STL_VERIFY(!_Myval._Is_parent_of(_Iter._Get_current()), "source range overlaps hive");
        }
#endif // _ITERATOR_DEBUG_LEVEL != 0
    }

    // Assigns elements via _Assign_func and constructs elements via _Insert_func.
    // _Orphan non-end iterators.
    template <class _InsertFn, class _AssignFn>
    constexpr void _Assign_n(size_type _Count, _InsertFn _Insert_func, _AssignFn _Assign_func) {
        if (_Count == 0) {
            clear();
            return;
        }

        _Myval._Orphan_nonend();

        size_type _Assign_count = (_STD min) (_Myval._Size, _Count);
        auto _Insert_count      = static_cast<size_type>(_Count - _Assign_count);

        const auto _Sent = _Myval._Sent();
        for (auto _Blk = _Myval._Active_begin(); _Blk != _Sent; ++_Blk) {
            auto _Assign_cnt =
                static_cast<_Block_size_t>((_STD min) (static_cast<size_type>(_Blk->_Size), _Assign_count));
            auto _Insert_cnt = static_cast<_Block_size_t>(
                (_STD min) (static_cast<size_type>(_Blk->_Capacity - _Blk->_Size), _Insert_count));
            _STL_INTERNAL_CHECK(_Assign_cnt > 0);

            _Assign_count -= _Assign_cnt;

            _Local_iterator _Iter{_Blk, _Blk->_First_element()};
            if (_Insert_cnt != 0) {
                _STL_INTERNAL_CHECK(_Assign_cnt == _Blk->_Size);

                _Insert_count -= _Insert_cnt;

                for (_Block_size_t _Idx = 0;; ++_Idx, ++_Iter) {
                    _STL_INTERNAL_CHECK(_Insert_cnt > 0);
                    _STL_INTERNAL_CHECK(_Iter._Index <= _Blk->_Capacity);
                    _STL_INTERNAL_CHECK(_Idx <= _Iter._Index);

                    // [_Idx, _Iter._Index) is empty
                    if (_Idx != _Iter._Index) {
                        const auto _Cnt = (_STD min) (static_cast<_Block_size_t>(_Iter._Index - _Idx), _Insert_cnt);

                        _Blk->_Emplace_n_at(_Idx, _Cnt,
                            [this, _Insert_func = _STD _Pass_fn(_Insert_func)](
                                _Union_ptr _Ptr, _Block_size_t _Len) mutable {
                                _Local_unions_backout _Backout{_Al, _Ptr};
                                _Insert_func(_Backout, _Len);
                                _Backout._Release();
                                _Myval._Size += _Len;
                            });

                        _Idx += _Cnt;
                        _Insert_cnt -= _Cnt;
                        if (_Insert_cnt == 0) {
                            break;
                        }
                    }
                    _STL_INTERNAL_CHECK(_Idx == _Iter._Index);

                    _STL_INTERNAL_CHECK(_Iter._Index < _Blk->_Capacity);
                    _Assign_func(_STD addressof(*_Iter), 1);
                    --_Assign_cnt;
                }

                if (_Blk->_Full()) {
                    _Block_iter_nonfull{_Blk}._Remove_from_list();
                }
            }
            _STL_INTERNAL_CHECK(_Insert_cnt == 0);

            // now old elements before _Iter have been assigned
            if (_Assign_cnt != 0) {
                _Iter._Index = _Scary_val::_With_block_iter(
                    _Blk, _Iter._Index, [_Assign_cnt, _Assign_func = _STD _Pass_fn(_Assign_func)](auto&& _Fst) mutable {
                        _Assign_func(_Fst, _Assign_cnt);
                        return _Fst;
                    });
            }

            if (_Assign_count == 0 && _Insert_count == 0) {
                if (_Iter._Index != _Blk->_Capacity) {
                    _Erase(_Unchecked_const_iterator{_Blk, _Iter._Index}, _Unchecked_end());
                } else {
                    _Erase(_Unchecked_const_iterator{_Block_iter_active{_Blk->_Next}, _Blk->_Next->_First_element()},
                        _Unchecked_end());
                }
                return;
            }
        }

        _STL_INTERNAL_CHECK(_Assign_count == 0);
        _STL_INTERNAL_CHECK(_Myval._Nonfull_begin() == _Sent);
        // intentionally grows capacity generously to match std::vector's behavior
        _Insert_n(_Insert_count, _STD _Pass_fn(_Insert_func));
    }

    template <class _It>
    constexpr void _Assign_sized_rng(size_type _Size, _It&& _First) {
        if (_Size != 0) {
            _Verify_iter_not_in_this(_First);
        }
        _Assign_n(_Size, _Lambdas::template _Copy_move_to_blk<_Lambdas::_Copy | _Lambdas::_Uninit>(_First),
            _Lambdas::template _Copy_move_to_blk<_Lambdas::_Copy | _Lambdas::_Init>(_First));
    }

    template <class _It, class _Se>
    constexpr void _Assign_unsized_rng(_It&& _First, _Se&& _Last) {
#if _ITERATOR_DEBUG_LEVEL != 0
        if (_First != _Last) {
            _Verify_iter_not_in_this(_First);
        }
        _Myval._Orphan_nonend();
#endif // _ITERATOR_DEBUG_LEVEL != 0

        const auto _Sent = _Myval._Sent();
        for (auto _Blk = _Myval._Active_begin(); _Blk != _Sent; ++_Blk) {
            _Local_iterator _Iter{_Blk, _Blk->_First_element()};

            if (!_Blk->_Full()) {
                _Block_size_t _Idx = 0;
                while (_First != _Last) {
                    _STL_INTERNAL_CHECK(_Iter._Index <= _Blk->_Capacity);
                    _STL_INTERNAL_CHECK(_Idx <= _Iter._Index);

                    // [_Idx, _Iter._Index) is empty
                    if (_Idx != _Iter._Index) {
                        do {
                            _Blk->_Emplace_n_at(_Idx, 1, [&](_Union_ptr _Ptr, _Block_size_t) {
                                _Alty_traits::construct(_Al, _STD addressof(_Ptr->_Value), *_First);
                                ++_First;
                                ++_Myval._Size;
                                ++_Idx;
                            });
                        } while (_Idx != _Iter._Index && _First != _Last);

                        if (_Blk->_Full()) {
                            _Block_iter_nonfull{_Blk}._Remove_from_list();
                            break;
                        }

                        if (_First == _Last) {
                            break;
                        }
                    }

                    _STL_INTERNAL_CHECK(_Iter._Index < _Blk->_Capacity);
                    _STL_INTERNAL_CHECK(_First != _Last);
                    *_Iter = *_First;
                    ++_Iter;
                    ++_First;
                    ++_Idx;
                }
            }

            _Iter._Index =
                _Scary_val::_With_block_iters(_Blk, _Iter._Index, _Blk->_Capacity, [&](auto&& _Fst, const auto& _Lst) {
                    for (; _Fst != _Lst && _First != _Last; ++_Fst, (void) ++_First) {
                        *_Fst = *_First;
                    }
                    return _Fst;
                });

            if (_First == _Last) {
                if (_Iter._Index != _Blk->_Capacity) {
                    _Erase(_Unchecked_const_iterator{_Blk, _Iter._Index}, _Unchecked_end());
                } else {
                    _Erase(_Unchecked_const_iterator{_Block_iter_active{_Blk->_Next}, _Blk->_Next->_First_element()},
                        _Unchecked_end());
                }
                return;
            }
        }

        _STL_INTERNAL_CHECK(_Myval._Nonfull_begin() == _Sent);
        _Insert_unsized_rng(_First, _Last);
    }

    template <class _Hive>
    constexpr void _Copy_move_assign_one_by_one(_Hive&& _Right) {
        constexpr auto _Mode_base = is_rvalue_reference_v<_Hive&&> ? _Lambdas::_Move : _Lambdas::_Copy;

        auto _Src_blk = _Right._Myval._Active_begin();
        auto _Src_idx = _Src_blk->_First_element();

        _Assign_n(_Right._Myval._Size,
            _Copy_move_elems_from<_Mode_base | _Lambdas::_Uninit>(_Src_blk, _Src_idx, _Right),
            _Copy_move_elems_from<_Mode_base | _Lambdas::_Init>(_Src_blk, _Src_idx, _Right));
    }

public:
    hive& operator=(const hive& _Right) {
        if (_STD addressof(_Right) == this) {
            return *this;
        }

        if constexpr (_Choose_pocca_v<_Alty>) {
            if (_Al != _Right._Al) {
                clear();
                trim_capacity();
            }
        }
        _STD _Pocca(_Al, _Right._Al);

        _Copy_move_assign_one_by_one(_Right);
        return *this;
    }

    hive& operator=(hive&& _Right) noexcept(_Choose_pocma_v<_Alty> != _Pocma_values::_No_propagate_allocators) {
        if (_STD addressof(_Right) == this) {
            return *this;
        }

        constexpr auto _Pocma_val = _Choose_pocma_v<_Alty>;
        if constexpr (_Pocma_val == _Pocma_values::_No_propagate_allocators) {
            if (_Al != _Right._Al) {
                _Right._Myval._Orphan_nonend();
                _Right._Myval._Orphan_end();
                _Copy_move_assign_one_by_one(_STD move(_Right));
                return *this;
            }
        }

        if constexpr (!_Alty_traits::is_always_equal::value) {
            if (_Al != _Right._Al) {
                // discard all old blocks as they cannot be reused
                clear();
                trim_capacity(); // FIXME: complexity, see below
                                 //        (does "valid but unspecified state" allow changing the allocator?)
                _STD _Pocma(_Al, _Right._Al);
                _Myval._Limits = _Right._Myval._Limits;
                _Myval._Move_from(_Right._Myval);
                return *this;
            }
        }
        _STL_INTERNAL_CHECK(_Al == _Right._Al);

        _STD _Pocma(_Al, _Right._Al);
        _Myval._Orphan_nonend();

        const auto _Old_limits = _Myval._Limits;
        _Myval._Limits         = _Right._Myval._Limits;

        size_type _Reserved_cap = _Myval._Capacity;
        if (_Myval._Size != 0) {
            // For the old blocks, destroy their elements and try to reserve them (temporarily in _Right).
            const auto _Sent = _Myval._Sent();
            for (auto _Cur_blk = _Myval._Active_begin(); _Cur_blk != _Sent;) {
                const auto _Blk = _Cur_blk++;
                _Reserved_cap -= _Blk->_Capacity;
                _Destroy_elems(_Blk);
                if (_Myval._Limits._Contains(_Blk->_Capacity) && _Right._Should_reserve(_Blk)) {
                    _Right._Myval._Capacity += _Blk->_Capacity;
                    _Right._Reserve_block(_Blk);
                } else {
                    _Dealloc_block(_Blk);
                }
            }
            _Myval._Sent_block._Next = _Myval._Sent_block._Prev = _Sent;
            _Myval._Sent_block._Next_nonfull = _Myval._Sent_block._Prev_nonfull = _Sent;

            _Myval._Size = 0;
        }
        _Myval._Capacity = 0;

        const auto _My_reserved = _STD exchange(_Myval._Reserved_first, _Block_iter_reserved{nullptr});
        _Myval._Move_from(_Right._Myval);

        // The complexity requirement prevents us from releasing reserved blocks (otherwise the complexity would be
        // linear in the number of reserved blocks). Therefore, reserved blocks can only be transferred to _Right, and
        // the limits must be adjusted accordingly.
        _Right._Myval._Reserved_first = _My_reserved;
        _Right._Myval._Capacity       = _Reserved_cap;
        _Right._Myval._Limits         = _Old_limits;

        return *this;
    }

    hive& operator=(initializer_list<_Ty> _Ilist) {
        assign_range(_Ilist);
        return *this;
    }

    template <_Iterator_for_container _Iter>
    void assign(_Iter _First, _Iter _Last) {
        _Dispatch_range_op(
            _First, _Last, [&](auto&&... _Args) { _Assign_sized_rng(_Args...); },
            [&](auto&&... _Args) { _Assign_unsized_rng(_Args...); });
    }
    template <_Container_compatible_range<_Ty> _Rng>
    void assign_range(_Rng&& _Range) {
        static_assert(assignable_from<_Ty&, _RANGES range_reference_t<_Rng>>,
            "Elements must be assignable from the range's reference type (N5032 [sequence.reqmts]/61).");
        _Dispatch_range_op(
            _Range, [&](auto&&... _Args) { _Assign_sized_rng(_Args...); },
            [&](auto&&... _Args) { _Assign_unsized_rng(_Args...); },
            [&](size_type _Approx_size, auto&&... _Args) {
                reserve(_Approx_size);
                _Assign_unsized_rng(_Args...);
            });
    }

    void assign(size_type _Count, const _Ty& _Val) {
        _Assign_n(_Count, _Lambdas::template _Fill_blk<_Lambdas::_Uninit>(_Val),
            _Lambdas::template _Fill_blk<_Lambdas::_Init>(_Val));
    }

