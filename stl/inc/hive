private:
    // Splices the active and nonfull block lists to *this, and renumber blocks if needed.
    // Size and capacity remain unchanged.
    constexpr void _Splice_blocks(_Block& _Rtsent) noexcept {
        auto& _Mysent          = _Myval._Sent_block;
        const auto _Rtsent_ptr = pointer_traits<_Block_ptr>::pointer_to(_Rtsent);
        _STL_INTERNAL_CHECK(_Rtsent._Next != _Rtsent_ptr);

        const auto _My_head = static_cast<size_type>(_Mysent._Next->_Order_id + 1); // wraps to 0 when empty
        const auto _Rt_tail = static_cast<size_type>(_Rtsent._Prev->_Order_id + 1); // > 0
        if (_Rt_tail < _My_head) {
            _Myval._Active_begin()._Splice_before(_Rtsent_ptr);
        } else {
            const auto _My_tail = static_cast<size_type>(_Mysent._Prev->_Order_id + 1); // wraps to 0 when empty
            const auto _Rt_head = static_cast<size_type>(_Rtsent._Next->_Order_id + 1); // > 0
            if (_Rt_head <= _My_tail) {
                _Renumber_blocks();

                const auto _My_tail_new = static_cast<size_type>(_Mysent._Prev->_Order_id + 1);
                if (_Rt_head <= _My_tail_new) {
                    _Rtsent._Next->_Order_id = _My_tail_new;
                    _STL_INTERNAL_CHECK(_Rtsent._Next->_Order_id != _Sentinel_ord_id);
                    for (_Block_iter_active _Blk{_Rtsent._Next->_Next}; _Blk != _Rtsent_ptr; ++_Blk) {
                        _Blk->_Order_id = static_cast<size_type>(_Blk->_Prev->_Order_id + 1);
                        _STL_INTERNAL_CHECK(_Blk->_Order_id != _Sentinel_ord_id);
                    }
                }
            }

            _Block_iter_active{_Myval._Sent()}._Splice_before(_Rtsent_ptr);
        }

        _Block_iter_nonfull{_Myval._Sent()}._Splice_before(_Rtsent_ptr);
    }

    // Replaces all _Count elements from _Sent into *this. Splices them back to *this if an exception is thrown.
    // Will reuse nonfull blocks and reserved blocks.
    constexpr void _Rebuild_n(size_type _Count, _Block& _Sent) {
        if (_Count == 0) {
            return;
        }

        struct _Rebuild_guard {
            hive* _Hive;
            _Block& _Sent;
            constexpr ~_Rebuild_guard() noexcept {
                if (_Hive != nullptr) {
                    _Hive->_Splice_blocks(_Sent);
                }
            }
        };
        _Rebuild_guard _Guard{this, _Sent};

        auto _Src_blk       = _Block_iter_active{_Sent._Next};
        auto _Src_idx       = _Src_blk->_First_element();
        const auto _Do_move = _Copy_move_elems_from<_Lambdas::_Move | _Lambdas::_Uninit>(_Src_blk, _Src_idx, *this);

        // reuses nonfull blocks first
        const auto _Mysent = _Myval._Sent();
        for (auto _Nonfull = _Myval._Nonfull_begin(); _Nonfull != _Mysent;) {
            const auto _Cnt = static_cast<_Block_size_t>(
                (_STD min) (static_cast<size_type>(_Nonfull->_Capacity - _Nonfull->_Size), _Count));
            _STL_INTERNAL_CHECK(_Cnt > 0);

            _Nonfull->_Emplace_n(_Cnt, [&](_Union_ptr _Ptr, _Block_size_t _Len) {
                _Local_unions_backout _Backout{_Al, _Ptr};
                _Do_move(_Backout, _Len);
                _Backout._Release();
                _Myval._Size += _Len;
            });

            if (_Nonfull->_Full()) {
                (_Nonfull++)._Remove_from_list();
            } else {
                _STL_INTERNAL_CHECK(_Count == _Cnt);
            }
            _Count -= _Cnt;

            if (_Count == 0) {
                _Guard._Hive = nullptr;
                return;
            }
        }

        _STL_INTERNAL_CHECK(_Count > 0);

        const auto _Move_to_tmp_blk = [&](auto& _Dst) {
            const auto _Cnt = static_cast<_Block_size_t>((_STD min) (static_cast<size_type>(_Dst._Capacity()), _Count));
            _STL_INTERNAL_CHECK(_Cnt > 0);

            _Do_move(_Dst, _Cnt);

            _Myval._Size += _Cnt;
            _Count -= _Cnt;
        };

        // then reserved blocks
        while (_Myval._Reserved_first != nullptr) {
            _STL_INTERNAL_CHECK(_Count > 0);
            _Temp_reserved_block _Tmp_blk{*this, _Myval._Reserved_first};
            _Move_to_tmp_blk(_Tmp_blk);

            ++_Myval._Reserved_first;
            _Activate_block(_Tmp_blk._Init_and_release());

            if (_Count == 0) {
                _Guard._Hive = nullptr;
                return;
            }
        }

        _STL_INTERNAL_CHECK(_Count > 0);
        _Alloc_exact_n(_Count, [&](_Temp_new_block _Tmp_blk) {
            _Move_to_tmp_blk(_Tmp_blk);
            _Myval._Capacity += _Tmp_blk._Capacity();
            _Activate_block(_Tmp_blk._Init_and_release());
        });
        _Guard._Hive = nullptr;
    }

    constexpr void _Rebuild_all() {
        _Myval._Orphan_nonend();
        _Myval._Orphan_end();
        const auto _Mysent = _Myval._Sent();
        _Block _Temp_sent  = _Block::_Sentinel(_Temp_sent);
        _Block_iter_active{_Temp_sent._Next}._Splice_before(_Mysent);
        _Block_iter_nonfull{_Temp_sent._Next_nonfull}._Splice_before(_Mysent);
        _Rebuild_n(_Myval._Size, _Temp_sent);
    }

    // returns _Count for _Rebuild_n; _Orphan all iterators if any block is picked
    template <class _Pr>
    _NODISCARD constexpr size_type _Pick_active_for_rebuild(_Pr _Pred, _Block& _Dest_sent) noexcept {
        const _Block_iter_active _Dst_active{_Dest_sent._Next};
        const _Block_iter_nonfull _Dst_nonfull{_Dest_sent._Next_nonfull};

        size_type _Count = 0;
        const auto _Sent = _Myval._Sent();
        for (auto _Cur_blk = _Myval._Active_begin(); _Cur_blk != _Sent;) {
            if (_Pred(_Cur_blk)) {
                const auto _Blk = _Cur_blk++;
                _Myval._Orphan_block(*_Blk);

                _Block_iter_active{_Blk}._Remove_from_list();
                _Dst_active._Insert_before(_Blk);
                if (!_Blk->_Full()) {
                    _Block_iter_nonfull{_Blk}._Remove_from_list();
                    _Dst_nonfull._Insert_before(_Blk);
                }

                _Count += _Blk->_Size;
            } else {
                // also renumber unchanged blocks to avoid order id overflow
                _Cur_blk->_Order_id = static_cast<size_type>(_Cur_blk->_Prev->_Order_id + 1);
                ++_Cur_blk;
            }
        }

        if (_Count != 0) {
            _Myval._Orphan_nonend();
            _Myval._Orphan_end();
        }
        return _Count;
    }

    template <class _Pr>
    constexpr void _Drop_reserved_if(_Pr _Pred) noexcept {
        _Block_iter_reserved _Prev{nullptr};
        for (auto _Cur = _Myval._Reserved_first; _Cur != nullptr;) {
            if (_Pred(_Cur)) {
                if (_Prev != nullptr) {
                    _Prev->_Next = _Cur->_Next;
                } else {
                    ++_Myval._Reserved_first;
                }
                _Myval._Capacity -= _Cur->_Capacity;
                _Dealloc_block(_Cur++);
            } else {
                _Prev = _Cur;
                ++_Cur;
            }
        }
    }

public:
    void shrink_to_fit() {
        if (_Myval._Capacity == _Myval._Size) {
            return;
        }

        const auto _Limits        = _Myval._Limits;
        const auto _Block_count   = static_cast<size_type>((_Myval._Size + (_Limits.max - 1uz)) / _Limits.max);
        const auto _Base_elem_cnt = static_cast<size_type>(_Block_count * _Limits.min);
        if (_Myval._Capacity == _Base_elem_cnt) {
            return;
        }
        _STL_INTERNAL_CHECK(_Myval._Capacity > _Base_elem_cnt);

        if (_Limits.min != _Limits.max) {
            const auto _Actual_elem_cnt = (_STD max) (_Myval._Size, _Base_elem_cnt);
            const auto _Extra_elem_cnt  = static_cast<size_type>(_Actual_elem_cnt - _Base_elem_cnt);
            const auto _Max_block_cnt   = static_cast<size_type>(_Extra_elem_cnt / (_Limits.max - _Limits.min));

            if (_Max_block_cnt == 0) {
                trim_capacity();
                _Rebuild_all();
                return;
            }

            auto _Rest_max = _Max_block_cnt;

            _Block _Temp_sent = _Block::_Sentinel(_Temp_sent);
            const auto _Count = _Pick_active_for_rebuild(
                [&](const auto& _Blk) {
                    if (_Rest_max != 0 && _Blk->_Size == _Limits.max) {
                        // rebuilding these blocks will not reduce capacity
                        _STL_INTERNAL_CHECK(_Blk->_Full() && _Blk->_Capacity == _Limits.max);
                        --_Rest_max;
                        return false;
                    }
                    return true;
                },
                _Temp_sent);

            if (_Rest_max != 0) {
                _Drop_reserved_if([&](const auto& _Blk) {
                    if (_Rest_max != 0 && _Blk->_Capacity == _Limits.max) {
                        // these blocks can be reused
                        --_Rest_max;
                        return false;
                    }
                    return true;
                });
            } else {
                trim_capacity();
            }

            _Rebuild_n(_Count, _Temp_sent);
        } else {
            trim_capacity();

            if (_Myval._Capacity != _Base_elem_cnt) {
                _Block _Temp_sent = _Block::_Sentinel(_Temp_sent);
                const auto _Count =
                    _Pick_active_for_rebuild([=](const auto& _Blk) { return _Blk->_Size != _Limits.max; }, _Temp_sent);
                _Rebuild_n(_Count, _Temp_sent);
            }
        }
    }

    void trim_capacity() noexcept {
        trim_capacity(0);
    }
    void trim_capacity(size_type _Min_capacity) noexcept {
        auto& _Res_first = _Myval._Reserved_first;
        while (_Res_first != nullptr && _Myval._Capacity - _Res_first->_Capacity >= _Min_capacity) {
            _Myval._Capacity -= _Res_first->_Capacity;
            _Dealloc_block(_Res_first++);
        }
    }

    _NODISCARD constexpr hive_limits block_capacity_limits() const noexcept {
        return _Myval._Limits;
    }

private:
    static constexpr size_t _Default_limits_max =
        (_STD min) ((_STD max) (65536uz / sizeof(_Union), 2uz), _Hard_limits_max);
    static constexpr size_t _Default_limits_min = [] consteval {
        // If the minimum limit is too large, a container with only one element wastes a lot of memory.
        // If the minimum limit is too small, repeated single insertions create many tiny blocks, also wasting memory.
        // This function finds the minimum limit that balances waste across these two worst cases.
        constexpr size_t _Skipfield_size = sizeof(_Block_size_t);
        _STL_INTERNAL_STATIC_ASSERT(_Default_limits_max >= 1);

        constexpr auto _Log2_ceil = [](size_t _Val) {
            _STL_INTERNAL_CHECK(_Val > 0);
            const int _Ret = _Unsigned_integer_digits<size_t> - _STD _Countl_zero(_Val - 1);
            _STL_INTERNAL_CHECK(_Ret >= 0);
            _STL_INTERNAL_CHECK((1uz << _Ret) >= _Val);
            _STL_INTERNAL_CHECK(_Ret == 0 || (1uz << (_Ret - 1)) < _Val);
            return static_cast<size_t>(_Ret);
        };

        const auto _Search_pred = [&](size_t _Lim) {
            const size_t _Big_block_waste    = (_Lim - 1) * (sizeof(_Union) + _Skipfield_size);
            const size_t _Small_blocks_waste = _Log2_ceil((_Default_limits_max + (_Lim - 1)) / _Lim) * sizeof(_Block);
            return _Big_block_waste < _Small_blocks_waste;
        };

        // binary search
        size_t _First = 1;
        size_t _Last  = _Default_limits_max;
        while (_First < _Last) {
            const auto _Mid = _First + (_Last - _First) / 2;
            if (_Search_pred(_Mid)) {
                _First = _Mid + 1;
            } else {
                _Last = _Mid;
            }
        }

        return _First;
    }();

public:
    _NODISCARD static constexpr hive_limits block_capacity_default_limits() noexcept {
        const auto _Hard_limits = block_capacity_hard_limits();
        return {_STD clamp(_Default_limits_min, _Hard_limits.min, _Hard_limits.max),
            _STD clamp(_Default_limits_max, _Hard_limits.min, _Hard_limits.max)};
    }

    _NODISCARD static constexpr hive_limits block_capacity_hard_limits() noexcept {
        size_t _Allocator_max; // N5032 [hive.overview]/5.3
        if constexpr (_Alty_uses_default_max_size) {
            _Allocator_max = static_cast<size_t>(_STD _Max_limit<size_type>() / sizeof(_Ty));
        } else if constexpr (is_default_constructible_v<_Alty>) {
            _Allocator_max = static_cast<size_t>(_Alty_traits::max_size(_Alty()));
        } else {
            // FIXME: What should we do? (Also, does this requirement actually make sense?)
            _Allocator_max = static_cast<size_t>(_STD _Max_limit<size_type>() / sizeof(_Union));
        }

        if (_Allocator_max == 0) {
            _STL_INTERNAL_CHECK(_Max_limit_may_be_zero);
            return {0, 0};
        }
        return {1, (_STD min) (_Allocator_max, _Hard_limits_max)};
    }

    void reshape(hive_limits _New_limits_) {
        _Verify_limits(_New_limits_);

        const auto _Old_limits      = _Myval._Limits;
        const _Limits_t _New_limits = _New_limits_;
        _Myval._Limits              = _New_limits;

        if (_New_limits._Contains(_Old_limits) || _Myval._Capacity == 0) {
            return;
        }

        struct _Limits_backout {
            hive* _Hive;
            _Limits_t _Limits;

            constexpr ~_Limits_backout() noexcept {
                if (_Hive != nullptr) {
                    _Hive->_Myval._Limits = _Limits;
                }
            }
        };
        _Limits_backout _Backout{this, _Limits_t::_Union_of(_Old_limits, _New_limits)};

        if (_New_limits._Overlaps(_Old_limits)) {
            const auto _Block_limits_incompatible = [_New_limits](const auto& _Blk) {
                return !_New_limits._Contains(_Blk->_Capacity);
            };

            _Drop_reserved_if(_Block_limits_incompatible);

            if (_Myval._Size != 0) {
                _Block _Temp_sent = _Block::_Sentinel(_Temp_sent);
                const auto _Count = _Pick_active_for_rebuild(_Block_limits_incompatible, _Temp_sent);
                _Rebuild_n(_Count, _Temp_sent);
            }
        } else {
            trim_capacity();
            if (_Myval._Size != 0) {
                _Rebuild_all();
            }
        }

        _Backout._Hive = nullptr;
    }

    // [hive.modifiers], modifiers
    template <class... _Valty>
    iterator emplace(_Valty&&... _Val) {
        iterator _Ret;
        const auto _Nonfull = _Myval._Nonfull_begin();
        if (_Nonfull != _Myval._Sent()) {
            const auto _Index = _Nonfull->_Emplace_one([this, &_Val...](_Union_ptr _Where) {
                _Alty_traits::construct(_Al, _STD addressof(_Where->_Value), _STD forward<_Valty>(_Val)...);
            });

            if (_Nonfull->_Full()) {
                _Nonfull._Remove_from_list();
            }
            ++_Myval._Size;

            _Ret = iterator{_Block_iter_active{_Nonfull}, _Index};
        } else if (_Myval._Reserved_first != nullptr) {
            _Temp_reserved_block _Temp_blk{*this, _Myval._Reserved_first};
            _Temp_blk._Emplace(_STD forward<_Valty>(_Val)...);

            const auto _New_block = _Temp_blk._Init_and_release();
            ++_Myval._Reserved_first;
            _Activate_block(_New_block);
            _STL_INTERNAL_CHECK(_New_block->_Size == 1);
            ++_Myval._Size;

            _Ret = iterator{_Block_iter_active{_New_block}, 0};
        } else {
            auto _Temp_blk = _Alloc_blk_generously();
            _Temp_blk._Emplace(_STD forward<_Valty>(_Val)...);

            const auto _New_block = _Temp_blk._Init_and_release();
            _Activate_block(_New_block);
            _STL_INTERNAL_CHECK(_New_block->_Size == 1);
            ++_Myval._Size;
            _Myval._Capacity += _New_block->_Capacity;

            _Ret = iterator{_Block_iter_active{_New_block}, 0};
        }
        _Myval._Orphan_end();
        return _Ret;
    }

    template <class... _Valty>
    iterator emplace_hint(const_iterator, _Valty&&... _Val) {
        return emplace(_STD forward<_Valty>(_Val)...);
    }
    iterator insert(const _Ty& _Val) {
        return emplace(_Val);
    }
    iterator insert(_Ty&& _Val) {
        return emplace(_STD move(_Val));
    }
    iterator insert(const_iterator, const _Ty& _Val) {
        return emplace(_Val);
    }
    iterator insert(const_iterator, _Ty&& _Val) {
        return emplace(_STD move(_Val));
    }

private:
    // Grows capacity generously if needed; calls _Func to construct elements in reserved blocks, new blocks, or
    // non-full old blocks, and increases size.
    // _Orphan end iterator if any insertion occurs.
    template <class _Fn>
    constexpr void _Insert_n(size_type _Count, _Fn _Func) {
#if _ITERATOR_DEBUG_LEVEL != 0
        if (_Count != 0) {
            _Myval._Orphan_end();
        }
#endif // _ITERATOR_DEBUG_LEVEL != 0

        // If there is sufficient space, insert into existing blocks without allocation.
        // Otherwise, allocate and prefer inserting into new blocks for better use of contiguous memory.
        if (_Count > _Myval._Capacity - _Myval._Size) {
            const auto _Alloc_count = static_cast<size_type>(_Count - (_Myval._Capacity - _Myval._Size));
            _Alloc_generous_n(
                _Alloc_count, [this, &_Count, _Func = _STD _Pass_fn(_Func)](_Temp_new_block&& _Tmp_blk) mutable {
                    const auto _Blk_cap = _Tmp_blk._Capacity();
                    const auto _Cnt = static_cast<_Block_size_t>((_STD min) (static_cast<size_type>(_Blk_cap), _Count));
                    _STL_INTERNAL_CHECK(_Cnt > 0);

                    _Func(_Tmp_blk, _Cnt);
                    _Activate_block(_Tmp_blk._Init_and_release());

                    _Myval._Capacity += _Blk_cap;
                    _Myval._Size += _Cnt;
                    _Count -= _Cnt;
                });
        }

        while (_Myval._Reserved_first != nullptr && _Count != 0) {
            const auto _Cnt = static_cast<_Block_size_t>(
                (_STD min) (static_cast<size_type>(_Myval._Reserved_first->_Capacity), _Count));
            _STL_INTERNAL_CHECK(_Cnt > 0);

            _Temp_reserved_block _Tmp_blk{*this, _Myval._Reserved_first};
            _Func(_Tmp_blk, _Cnt);
            ++_Myval._Reserved_first;
            _Activate_block(_Tmp_blk._Init_and_release());

            _Myval._Size += _Cnt;
            _Count -= _Cnt;
        }

        for (auto _Nonfull = _Myval._Nonfull_begin(); _Count != 0;) {
            _STL_INTERNAL_CHECK(_Nonfull != _Myval._Sent());

            const auto _Cnt = static_cast<_Block_size_t>(
                (_STD min) (static_cast<size_type>(_Nonfull->_Capacity - _Nonfull->_Size), _Count));
            _STL_INTERNAL_CHECK(_Cnt > 0);

            _Nonfull->_Emplace_n(
                _Cnt, [this, _Func = _STD _Pass_fn(_Func)](_Union_ptr _Ptr, _Block_size_t _Len) mutable {
                    _Local_unions_backout _Backout{_Al, _Ptr};
                    _Func(_Backout, _Len);
                    _Backout._Release();
                    _Myval._Size += _Len;
                });
            if (_Nonfull->_Full()) {
                (_Nonfull++)._Remove_from_list();
            } else {
                _STL_INTERNAL_CHECK(_Cnt == _Count);
                break;
            }
            _Count -= _Cnt;
        }
    }

    template <class _It>
    constexpr void _Insert_sized_rng(size_type _Size, _It&& _First) {
        if (_Size != 0) {
            _Verify_iter_not_in_this(_First);
        }
        _Insert_n(_Size, _Lambdas::template _Copy_move_to_blk<_Lambdas::_Copy | _Lambdas::_Uninit>(_First));
    }

    template <class _It, class _Se>
    constexpr void _Insert_unsized_rng(_It&& _First, _Se&& _Last) {
        if (_First == _Last) {
            return;
        }

        _Verify_iter_not_in_this(_First);
        _Myval._Orphan_end();

        if (_Myval._Size != _Myval._Capacity) {
            const auto _Sent = _Myval._Sent();
            for (auto _Nonfull = _Myval._Nonfull_begin(); _Nonfull != _Sent;) {
                _STL_INTERNAL_CHECK(_First != _Last);
                do {
                    _Nonfull->_Emplace_one([this, &_First](_Union_ptr _Where) {
                        _Alty_traits::construct(_Al, _STD addressof(_Where->_Value), *_First);
                    });
                    ++_First;
                    ++_Myval._Size;
                } while (_First != _Last && !_Nonfull->_Full());

                if (_Nonfull->_Full()) {
                    (_Nonfull++)._Remove_from_list();
                } else {
                    _STL_INTERNAL_CHECK(_First == _Last);
                }

                if (_First == _Last) {
                    return;
                }
            }
            _STL_INTERNAL_CHECK(_First != _Last);

            while (_Myval._Reserved_first != nullptr) {
                _Temp_reserved_block _Tmp_blk{*this, _Myval._Reserved_first};

                const auto _Blk_cap     = _Tmp_blk._Capacity();
                _Block_size_t _Blk_size = 0;
                _STL_INTERNAL_CHECK(_Blk_size != _Blk_cap && _First != _Last);
                do {
                    _Tmp_blk._Emplace(*_First);
                    ++_First;
                    ++_Blk_size;
                } while (_Blk_size != _Blk_cap && _First != _Last);

                _Myval._Size += _Blk_size;
                ++_Myval._Reserved_first;
                _Activate_block(_Tmp_blk._Init_and_release());

                if (_First == _Last) {
                    return;
                }
            }
        }

        _Insert_unsized_rng_into_new_blocks(_First, _Last);
    }

public:
    void insert(initializer_list<_Ty> _Ilist) {
        insert_range(_Ilist);
    }

    template <_Container_compatible_range<_Ty> _Rng>
    void insert_range(_Rng&& _Range) {
        _Dispatch_range_op(
            _Range, [&](auto&&... _Args) { _Insert_sized_rng(_Args...); },
            [&](auto&&... _Args) { _Insert_unsized_rng(_Args...); },
            [&](size_type _Approx_size, auto&&... _Args) {
                _Alloc_generous_n(_Approx_size, [this](_Temp_new_block&& _Tmp_blk) noexcept {
                    _Myval._Capacity += _Tmp_blk._Capacity();
                    _Reserve_block(_Tmp_blk._Uninit_release());
                });
                _Insert_unsized_rng(_Args...);
            });
    }
    template <_Iterator_for_container _Iter>
    void insert(_Iter _First, _Iter _Last) {
        _Dispatch_range_op(
            _First, _Last, [&](auto&&... _Args) { _Insert_sized_rng(_Args...); },
            [&](auto&&... _Args) { _Insert_unsized_rng(_Args...); });
    }

    void insert(size_type _Count, const _Ty& _Val) {
        _Insert_n(_Count, _Lambdas::template _Fill_blk<_Lambdas::_Uninit>(_Val));
    }

private:
    _NODISCARD constexpr bool _Should_reserve(_Block_ptr _Blk) const noexcept {
        if (_Myval._Reserved_first == nullptr) {
            return true;
        }
        const bool _Block_big_enough = _Blk->_Capacity >= _Myval._Reserved_first->_Capacity;
        const bool _Need_more_space  = _Myval._Capacity - _Myval._Size <= _Myval._Limits.max * 2;
        return _Block_big_enough && _Need_more_space;
    }

    // reduces capacity if dealloc
    constexpr void _Reserve_or_dealloc_empty(_Block_ptr _Blk) noexcept {
        if (_Should_reserve(_Blk)) {
            _Reserve_block(_Blk);
        } else {
            _Myval._Capacity -= _Blk->_Capacity;
            _Dealloc_block(_Blk);
        }
    }

    constexpr void _Erase(_Unchecked_const_iterator _UWhere) noexcept {
#if _ITERATOR_DEBUG_LEVEL != 0
        _Myval._Orphan_range(*_UWhere._Blk, _UWhere._Index, _STD _Next_iter(_Local_iterator{_UWhere})._Index);
        if (_STD _Next_iter(_UWhere) == _Unchecked_end()) {
            _Myval._Orphan_end();
        }
#endif // _ITERATOR_DEBUG_LEVEL != 0

        if constexpr (_Need_destruction) {
            _Alty_traits::destroy(_Al, _STD addressof(const_cast<_Ty&>(*_UWhere)));
        }

        const auto _Blk = _UWhere._Blk;
        _STL_INTERNAL_CHECK(_Blk->_Size >= 1);
        if (_Blk->_Size == 1) {
            _Block_iter_active{_Blk}._Remove_from_list();
            if (!_Blk->_Full()) {
                _Block_iter_nonfull{_Blk}._Remove_from_list();
            }
            _Reserve_or_dealloc_empty(_Blk);
        } else {
            if (_Blk->_Full()) {
                _Block_iter_nonfull{_Myval._Sent()}._Insert_after(_Blk);
            }
            _Blk->_Mark_erased(_UWhere._Index);
        }

        --_Myval._Size;
    }

    constexpr void _Erase(_Unchecked_const_iterator _UFirst, _Unchecked_const_iterator _ULast) noexcept {
#if _ITERATOR_DEBUG_LEVEL != 0
        if (_UFirst != _ULast && _ULast == _Unchecked_end()) {
            _Myval._Orphan_end();
        }
#endif // _ITERATOR_DEBUG_LEVEL != 0

        const auto _Erase_partial_block = [this](_Block_ptr _Blk, _Block_size_t _First, _Block_size_t _Last) {
            _STL_INTERNAL_CHECK(_First < _Last);
            _Myval._Orphan_range(*_Blk, _First, _Last);

            _Block_size_t _Elem_count;
            _Scary_val::_With_block_iters(_Blk, _First, _Last, [&](auto _Fst, const auto& _Lst) {
                _Elem_count = static_cast<_Block_size_t>(_RANGES distance(_Fst, _Lst));

                if constexpr (_Need_destruction) {
                    do {
                        _Alty_traits::destroy(_Al, _STD addressof(*_Fst));
                        ++_Fst;
                    } while (_Fst != _Lst);
                }
                return _Lst;
            });

            if (_Blk->_Full()) {
                _Block_iter_nonfull{_Myval._Sent()}._Insert_after(_Blk);
            }

            _Blk->_Mark_erased(_First, _Last, _Elem_count);
            _Myval._Size -= _Elem_count;
        };

        if (_UFirst._Blk != _ULast._Blk) {
            if (_UFirst._Index != _UFirst._Blk->_First_element()) {
                _Erase_partial_block(_UFirst._Blk, _UFirst._Index, _UFirst._Blk->_Capacity);
                ++_UFirst._Blk;
            }

            if (_UFirst._Blk != _ULast._Blk) {
                const auto _Prev_block = _UFirst._Blk->_Prev;

                do {
                    const auto _Blk = _UFirst._Blk++;
                    _Myval._Orphan_block(*_Blk);
                    if (!_Blk->_Full()) {
                        _Block_iter_nonfull{_Blk}._Remove_from_list();
                    }
                    _Myval._Size -= _Blk->_Size;
                    _Destroy_elems(_Blk);
                    _Reserve_or_dealloc_empty(_Blk);
                } while (_UFirst._Blk != _ULast._Blk);

                _ULast._Blk->_Prev = _Prev_block;
                _Prev_block->_Next = _ULast._Blk;
            }

            _UFirst._Index = _UFirst._Blk->_First_element();
        }

        _STL_INTERNAL_CHECK(_UFirst._Blk == _ULast._Blk);

        if (_UFirst._Index != _ULast._Index) {
            _Erase_partial_block(_UFirst._Blk, _UFirst._Index, _ULast._Index);
        }
    }

public:
    iterator erase(const_iterator _Where) noexcept /* strengthened */ {
#if _ITERATOR_DEBUG_LEVEL != 0
        _STL_VERIFY(_Myval._Is_parent_of(_Where) && !_Where._Is_end(), "hive erase iterator outside range");
#endif // _ITERATOR_DEBUG_LEVEL != 0

        const auto _UWhere = _Where._Unwrapped();
        const auto _URet   = _STD _Next_iter(_UWhere);
        _Erase(_UWhere);

        return iterator{_URet._Blk, _URet._Index};
    }

    iterator erase(const_iterator _First, const_iterator _Last) noexcept /* strengthened */ {
#if _ITERATOR_DEBUG_LEVEL != 0
        _STL_VERIFY(_Myval._Is_parent_of(_First), "hive erase iterator outside range");
        _STD _Adl_verify_range(_First, _Last);
#endif // _ITERATOR_DEBUG_LEVEL != 0
        _Erase(_First._Unwrapped(), _Last._Unwrapped());
        // Note: The end iterator is bound to the container and never really invalidated.
        return _Last._Mutable(); // _Mutable ignores the invalidity
    }

    void swap(hive& _Right) noexcept /* strengthened */ {
        if (this != _STD addressof(_Right)) {
            _STD _Pocs(_Al, _Right._Al);
            _Myval._Swap(_Right._Myval);
        }
    }

    void clear() noexcept {
        // does not deallocate; always reserves all active blocks
        // O(1) if the destruction is trivial

        if constexpr (_Need_destruction) {
            const auto _Sent = _Myval._Sent();
            for (auto _Blk = _Myval._Active_begin(); _Blk != _Sent; ++_Blk) {
                _Destroy_elems(_Blk);
            }
        }

        _Myval._Orphan_nonend();

        auto& _Sent            = _Myval._Sent_block;
        _Sent._Prev->_Next     = _Myval._Reserved_first;
        _Myval._Reserved_first = _Block_iter_reserved{_Sent._Next};
        _Sent._Prev = _Sent._Next = _Myval._Sent();
        _Sent._Prev_nonfull = _Sent._Next_nonfull = _Myval._Sent();

        _Myval._Size = 0;
    }

    // [hive.operations], hive operations
    void splice(hive& _Right) {
#if _ITERATOR_DEBUG_LEVEL != 0
        if constexpr (!_Alty_traits::is_always_equal::value) {
            _STL_VERIFY(_Al == _Right._Al, "hive allocators incompatible for splice");
        }
#endif // _ITERATOR_DEBUG_LEVEL != 0
        _STL_VERIFY(_STD addressof(_Right) != this, "cannot splice hive with itself");

        if (_Right.empty()) {
            _Myval._Orphan_end();
            _Right._Myval._Orphan_end();
            return;
        }

        if (!_Myval._Limits._Overlaps(_Right._Myval._Limits)) {
            _STD _Xlength_error("hive limits incompatible for splice");
        }

        const bool _Need_limits_check  = !_Myval._Limits._Contains(_Right._Myval._Limits);
        const bool _Need_capacity_calc = _Right._Myval._Reserved_first != nullptr;
        size_type _Right_active_cap    = _Need_capacity_calc ? size_type{0} : _Right._Myval._Capacity;
        if (_Need_limits_check || _Need_capacity_calc) {
            const auto _Sent = _Right._Myval._Sent();
            for (auto _Blk = _Right._Myval._Active_begin(); _Blk != _Sent; ++_Blk) {
                if (_Need_limits_check && !_Myval._Limits._Contains(_Blk->_Capacity)) {
                    _STD _Xlength_error("hive limits incompatible for splice");
                }

                if (_Need_capacity_calc) {
                    _Right_active_cap += _Blk->_Capacity;
                }
            }
        }

        if (_Right_active_cap > max_size() - _Myval._Capacity) {
            _Xlength();
        }
        _STL_INTERNAL_CHECK(_Right._Myval._Size <= max_size() - _Myval._Size);

        _Myval._Orphan_end();
        _Right._Myval._Orphan_end();

        _Myval._Capacity += _Right_active_cap;
        _Right._Myval._Capacity -= _Right_active_cap;
        _Myval._Size += _Right._Myval._Size;
        _Right._Myval._Size = 0;

        _Right._Myval._Adopt_all(_STD addressof(_Myval));
        _Splice_blocks(_Right._Myval._Sent_block);
    }
    void splice(hive&& _Right) {
        splice(_Right);
    }

    template <class _Pr2 = equal_to<_Ty>>
    size_type unique(_Pr2 _Pred = _Pr2()) noexcept(
        noexcept(static_cast<bool>(_Pred(_STD declval<const _Ty&>(), _STD declval<const _Ty&>())))) /* strengthened */ {
        static_assert(
            requires(const _Ty& _Val) {
                { _Pred(_Val, _Val) } -> _Boolean_testable;
            }, "binary_pred must meet the requirements of BinaryPredicate (N5032 [hive.operations]/1).");

        size_type _Count = 0;

        if (_Myval._Size >= 2) {
            // Note: The end iterator is bound to the container and never really invalidated.
            const auto _Last = _Unchecked_end();
            auto _Iter       = _Unchecked_begin();
            auto _Prev       = _Iter;
            ++_Iter;

            _STL_INTERNAL_CHECK(_Iter != _Last);
            do {
                if (_Pred(*_Iter, *_Prev)) {
                    const auto _First_duplicate = _Iter;

                    size_type _Cnt = 0;
                    do {
                        ++_Iter;
                        ++_Cnt;
                    } while (_Iter != _Last && _Pred(*_Iter, *_Prev));

                    _Count += _Cnt;
                    if (_Cnt != 1) {
                        _Erase(_First_duplicate, _Iter);
                    } else {
                        _Erase(_First_duplicate);
                    }

                    if (_Iter == _Last) {
                        break;
                    }
                }
                _Prev = _Iter;
                ++_Iter;
            } while (_Iter != _Last);
        }

        return _Count;
    }

private:
    template <class _Pr2>
    constexpr void _Sort_buffered_direct(pointer _Buffer, _Pr2 _Pred) {
        _Local_elems_backout _Backout{_Al, _Buffer}; // no release

        // move elements to uninitialized buffer
        const auto _Sent = _Myval._Sent();
        for (auto _Blk = _Myval._Active_begin(); _Blk != _Sent; ++_Blk) {
            _Myval._Visit_block_iter_n(
                _Blk, _Lambdas::template _Copy_move_from_blk<_Lambdas::_Move | _Lambdas::_Uninit>(_Backout));
        }

        const auto _Buffer_lst = _Backout._Last;
        _Bidi_container_inplace_sorter<pointer, _Pr2>::_Sort(_Buffer, _Buffer_lst, _Pred, _Al);

        // move sorted elements back
        for (auto _Blk = _Myval._Active_begin(); _Blk != _Sent; ++_Blk) {
            _Myval._Visit_block_iter_n(
                _Blk, _Lambdas::template _Copy_move_to_blk<_Lambdas::_Move | _Lambdas::_Init>(_Buffer));
        }
        _STL_INTERNAL_CHECK(_Buffer == _Buffer_lst);
    }

    struct _Indirect_sort_pair {
        _Ty* _Elem;
        _Indirect_sort_pair* _Old_pos;
    };
    template <class _Pr2>
    constexpr void _Sort_buffered_indirect(_Indirect_sort_pair* _Buffer, _Pr2 _Pred) {
        _Uninitialized_backout _Backout{_Buffer}; // no release
        _RANGES for_each(
            *this, [&_Backout](_Ty& _Elem) { _Backout._Emplace_back(_STD addressof(_Elem), _Backout._Last); });

        const auto _Buffer_lst = _Backout._Last;
        _STD sort(_Buffer, _Buffer_lst,
            [_Pred](const auto& _Left, const auto& _Right) mutable { return _Pred(*_Left._Elem, *_Right._Elem); });

        for (_Indirect_sort_pair* _Current = _Buffer; _Current != _Buffer_lst; ++_Current) {
            if (_Current->_Old_pos != _Current) {
                _Alloc_temporary2<_Alloc> _Temp(_Al, _STD move(*_Current->_Elem));
                auto _Dst = _Current;
                auto _Src = _Current->_Old_pos;

                do {
                    *_Dst->_Elem   = _STD move(*_Src->_Elem);
                    _Dst           = _Src;
                    _Src           = _Dst->_Old_pos;
                    _Dst->_Old_pos = _Dst;
                } while (_Src != _Current);

                *_Dst->_Elem = _STD move(_Temp._Get_value());
            }
        }
    }

    // doesn't check triviality because non-trivial move/swap operations are usually inexpensive (e.g., std::unique_ptr)
    static constexpr bool _Use_direct_sort = sizeof(_Ty) <= sizeof(_Indirect_sort_pair);

public:
    template <class _Pr2 = less<_Ty>>
    void sort(_Pr2 _Pred = _Pr2()) {
        static_assert(
            requires(const _Ty& _Val) {
                { _Pred(_Val, _Val) } -> _Boolean_testable;
            }, "comp must meet the requirements of BinaryPredicate (N5032 [hive.operations]/1).");
        static_assert(is_swappable_v<_Ty>,
            "hive<T, Allocator>::sort requires that T is Cpp17Swappable (N5032 [hive.operations]/13).");

        if (_Myval._Size <= 1) {
            return;
        }

        using _Passed_pr = decltype(_STD _Pass_fn(_Pred));

        if (_Myval._Sent_block._Prev == _Myval._Sent_block._Next) {
            _Block& _Blk = *_Myval._Active_begin();
            if (_Blk._Full()) {
                // single full block, sort as an array
                _Bidi_container_inplace_sorter<_Local_ptr, _Passed_pr>::_Sort(
                    _Local_ptr{_Blk._Data}, _Local_ptr{_Blk._Data + _Blk._Capacity}, _STD _Pass_fn(_Pred), _Al);
                return;
            }
        }

        using _Sort_t = conditional_t<_Use_direct_sort, _Ty, _Indirect_sort_pair>;

        if !consteval {
            const auto _Buffer = _Myval.template _Find_buffer_inplace<_Sort_t>(_Myval._Size);
            if (_Buffer != nullptr) {
                if constexpr (_Use_direct_sort) {
                    _Sort_buffered_direct(_STD _Refancy<pointer>(_Buffer), _STD _Pass_fn(_Pred));
                } else {
                    _Sort_buffered_indirect(_Buffer, _STD _Pass_fn(_Pred));
                }
                return;
            }
        }

        using _Alsort = _Maybe_rebind_alloc_t<_Alty, _Sort_t>;
        _Alsort _Als(_Al);
        _Alloc_construct_n_ptr _Buffer{_Als, _Myval._Size}; // no release

        _TRY_BEGIN
        _Buffer._Allocate();
        _CATCH_ALL
        const auto _Mydist = static_cast<difference_type>(_Myval._Size);
        _Bidi_container_inplace_sorter<_Unchecked_iterator, _Passed_pr>::_Sort(
            _Unchecked_begin(), _Unchecked_end(), _Mydist, _Mydist, _STD _Pass_fn(_Pred), _Al);
        return;
        _CATCH_END

        if constexpr (_Use_direct_sort) {
            _Sort_buffered_direct(_Buffer._Ptr, _STD _Pass_fn(_Pred));
        } else {
            _Sort_buffered_indirect(_STD to_address(_Buffer._Ptr), _STD _Pass_fn(_Pred));
        }
    }

    _NODISCARD iterator get_iterator(const_pointer _Ptr) noexcept {
        return static_cast<const hive*>(this)->get_iterator(_Ptr)._Mutable();
    }
    _NODISCARD const_iterator get_iterator(const_pointer _Ptr) const noexcept {
        // Note that fancy pointer might not provide the implementation-defined strict total order comparison.
        const auto _Ptr_union = reinterpret_cast<const _Union*>(_STD to_address(_Ptr));
        const auto _Sent      = const_cast<_Scary_val&>(_Myval)._Sent();
        for (auto _Blk = _Myval._Active_begin(); _Blk != _Sent; ++_Blk) {
            const auto _First_union = _STD to_address(_Blk->_Data);
            const auto _Last_union  = _First_union + _Blk->_Capacity;

            // Technically, we should use std::less and std::less_equal (N5032 [expr.rel]/4, [comparisons.general]/2),
            // but since they just invoke built-in comparison operators internally, we omit them here.
            if (_First_union <= _Ptr_union && _Ptr_union < _Last_union) {
                const auto _Index = static_cast<_Block_size_t>(_Ptr_union - _First_union);

#if _ITERATOR_DEBUG_LEVEL != 0 // FIXME: is this too heavyweight?
                if (!_Blk->_Full()) {
                    for (_Local_iterator _Iter{_Blk, _Blk->_First_element()}; _Iter._Index != _Index; ++_Iter) {
                        _STL_VERIFY(_Iter._Index < _Index, "cannot get hive iterator for invalid pointer");
                    }
                }
#endif // _ITERATOR_DEBUG_LEVEL != 0

                return const_iterator{_Blk, _Index};
            }
        }
#if _MSVC_STL_HARDENING_HIVE || _ITERATOR_DEBUG_LEVEL != 0
        _STL_REPORT_ERROR("cannot get iterator for pointer outside this hive");
#endif // _MSVC_STL_HARDENING_HIVE || _ITERATOR_DEBUG_LEVEL != 0
        _STL_UNREACHABLE;
    }

    _NODISCARD constexpr _Unchecked_iterator _Unchecked_begin() noexcept {
        return static_cast<const hive*>(this)->_Unchecked_begin()._Mutable();
    }
    _NODISCARD constexpr _Unchecked_const_iterator _Unchecked_begin() const noexcept {
        const auto _Blk = _Myval._Active_begin();
        return {_Blk, _Blk->_First_element()};
    }
    _NODISCARD constexpr _Unchecked_iterator _Unchecked_end() noexcept {
        return static_cast<const hive*>(this)->_Unchecked_end()._Mutable();
    }
    _NODISCARD constexpr _Unchecked_const_iterator _Unchecked_end() const noexcept {
        const auto _Sent = const_cast<_Scary_val&>(_Myval)._Sent();
        return {_Block_iter_active{_Sent}, 0};
    }

private:
    // TRANSITION, VSO-2680018: `typename` should be dropped
    template <class _Ty0, class _Alloc0, class _Uty>
    friend typename hive<_Ty0, _Alloc0>::size_type erase(hive<_Ty0, _Alloc0>& _Cont, const _Uty& _Val);
    template <class _Ty0, class _Alloc0, class _Pr>
    friend typename hive<_Ty0, _Alloc0>::size_type erase_if(hive<_Ty0, _Alloc0>& _Cont, _Pr _Pred);

    template <class _Pr>
    constexpr size_type _Erase_if(_Pr _Pred) {
        size_type _Count = 0;
        // Note: The end iterator is bound to the container and never really invalidated.
        const auto _Last = _Unchecked_end();
        for (auto _Iter = _Unchecked_begin(); _Iter != _Last; ++_Iter) {
            if (_Pred(*_Iter)) {
                struct _Eraser {
                    // Per N5032 [hive.erasure]/2, this function's behavior is equivalent to erasing elements
                    // immediately after each call to _Pred, but here we batch adjacent erasures into a single operation
                    // for efficiency. Therefore, if _Pred throws, all pending elements should be erased.
                    hive& _Hive;
                    _Pr& _Pred;
                    _Unchecked_iterator& _Iter;
                    const _Unchecked_iterator& _Last;

                    _Unchecked_iterator _First = _Iter;
                    size_type _Cnt             = 0;

                    constexpr size_type _Seek() {
                        do {
                            ++_Iter;
                            ++_Cnt;
                        } while (_Iter != _Last && _Pred(*_Iter));
                        return _Cnt;
                    }

                    constexpr ~_Eraser() noexcept {
                        _STL_INTERNAL_CHECK(_Cnt > 0);
                        if (_Cnt != 1) {
                            _Hive._Erase(_First, _Iter);
                        } else {
                            _Hive._Erase(_First);
                        }
                    }
                };

                _Count += _Eraser{*this, _Pred, _Iter, _Last}._Seek();

                if (_Iter == _Last) {
                    break;
                }
            }
        }

        return _Count;
    }

private:
    _MSVC_NO_UNIQUE_ADDRESS _Alty _Al;
    _Scary_val _Myval;
