#ifndef _HIVE_
#define _HIVE_
#include <yvals_core.h>
#if _STL_COMPILER_PREPROCESSOR
#if !_HAS_CXX26
_EMIT_STL_WARNING(STL4038, "The contents of <hive> are available only with C++26 or later.");
#else // ^^^ !_HAS_CXX26 / _HAS_CXX26 vvv

#include <compare> // see [compare.syn]
#include <initializer_list> // see [initializer.list.syn]
#include <xpolymorphic_allocator.h>

#pragma pack(push, _CRT_PACKING)
#pragma warning(push, _STL_WARNING_LEVEL)
#pragma warning(disable : _STL_DISABLED_WARNINGS)
_STL_DISABLE_CLANG_WARNINGS
#pragma push_macro("new")
#undef new

_STD_BEGIN
_EXPORT_STD struct hive_limits {
    size_t min;
    size_t max;
    constexpr hive_limits(size_t _Min, size_t _Max) noexcept : min{_Min}, max{_Max} {}
};

template <class _ValueType, class _SizeType, class _DifferenceType, class _Pointer, class _ConstPointer>
struct _Hive_val_provider {
    struct _Val {
        using value_type      = _ValueType;
        using pointer         = _Pointer;
        using const_pointer   = _ConstPointer;
        using reference       = value_type&;
        using const_reference = const value_type&;
        using size_type       = _SizeType;
        using difference_type = _DifferenceType;
        using iterator        = /* TODO */;
        using const_iterator  = /* TODO */;

        // hive_limits current - limits = implementation - defined; // exposition only
    };
};

// [hive], class template hive
_EXPORT_STD template <class _Ty, class _Alloc = allocator<_Ty>>
class hive {
private:
    using _Alty        = _Rebind_alloc_t<_Alloc, _Ty>;
    using _Alty_traits = allocator_traits<_Alty>;

public:
    static_assert(!_ENFORCE_MATCHING_ALLOCATORS || is_same_v<_Ty, typename _Alloc::value_type>,
        _MISMATCHED_ALLOCATOR_MESSAGE("hive<T, Allocator>", "T"));
    static_assert(is_object_v<_Ty>, "The C++ Standard forbids containers of non-object types "
                                    "because of [container.requirements].");

    // types
    using value_type      = _Ty;
    using allocator_type  = _Alloc;
    using pointer         = _Alty_traits::pointer;
    using const_pointer   = _Alty_traits::const_pointer;
    using reference       = value_type&;
    using const_reference = const value_type&;
    using size_type       = _Alty_traits::size_type; // see [container.requirements]
    using difference_type = _Alty_traits::difference_type; // see [container.requirements]

private:
    using _Scary_val = _Hive_val_provider<_Ty, size_type, difference_type, pointer, const_pointer>::_Val;

public:
    using iterator               = _Scary_val::iterator; // see [container.requirements]
    using const_iterator         = _Scary_val::const_iterator; // see [container.requirements]
    using reverse_iterator       = _STD reverse_iterator<iterator>; // see [container.requirements]
    using const_reverse_iterator = _STD reverse_iterator<const_iterator>; // see [container.requirements]

    // [hive.cons], construct/copy/destroy
    constexpr hive() noexcept(noexcept(_Alloc())) : hive(_Alloc()) {}
    constexpr explicit hive(const _Alloc& _Allocator) noexcept;
    constexpr explicit hive(hive_limits _Block_limits) : hive(_Block_limits, _Alloc()) {}
    constexpr hive(hive_limits _Block_limits, const _Alloc& _Allocator);

    explicit hive(size_type _Count, const _Alloc& _Allocator = _Alloc());
    hive(size_type _Count, hive_limits _Block_limits, const _Alloc& _Allocator = _Alloc());

    hive(size_type _Count, const _Ty& _Val, const _Alloc& _Allocator = _Alloc());
    hive(size_type _Count, const _Ty& _Val, hive_limits _Block_limits, const _Alloc& _Allocator = _Alloc());

    template <_Iterator_for_container _Iter>
    hive(_Iter _First, _Iter _Last, const _Alloc& _Allocator = _Alloc());
    template <_Iterator_for_container _Iter>
    hive(_Iter _First, _Iter _Last, hive_limits _Block_limits, const _Alloc& _Allocator = _Alloc());

    template <_Container_compatible_range<_Ty> _Rng>
    hive(from_range_t, _Rng&& _Range, const _Alloc& _Allocator = _Alloc());
    template <_Container_compatible_range<_Ty> _Rng>
    hive(from_range_t, _Rng&& _Range, hive_limits _Block_limits, const _Alloc& _Allocator = _Alloc());

    hive(const hive& _Right);
    hive(hive&& _Right) noexcept;
    hive(const hive& _Right, const type_identity_t<_Alloc>& _Allocator);
    hive(hive&& _Right, const type_identity_t<_Alloc>& _Allocator);

    hive(initializer_list<_Ty> _Ilist, const _Alloc& _Allocator = _Alloc());
    hive(initializer_list<_Ty> _Ilist, hive_limits _Block_limits, const _Alloc& _Allocator = _Alloc());

    ~hive();

    hive& operator=(const hive& _Right);
    hive& operator=(hive&& _Right) noexcept(_Choose_pocma_v<_Alty> != _Pocma_values::_No_propagate_allocators);
    hive& operator=(initializer_list<_Ty> _Ilist);
    template <_Iterator_for_container _Iter>
    void assign(_Iter _First, _Iter _Last);
    template <_Container_compatible_range<_Ty> _Rng>
    void assign_range(_Rng&& _Range);
    void assign(size_type _Count, const _Ty& _Val);
    void assign(initializer_list<_Ty> _Ilist);

    _NODISCARD allocator_type get_allocator() const noexcept;

    // iterators
    _NODISCARD iterator begin() noexcept;
    _NODISCARD const_iterator begin() const noexcept;
    _NODISCARD iterator end() noexcept;
    _NODISCARD const_iterator end() const noexcept;
    _NODISCARD reverse_iterator rbegin() noexcept;
    _NODISCARD const_reverse_iterator rbegin() const noexcept;
    _NODISCARD reverse_iterator rend() noexcept;
    _NODISCARD const_reverse_iterator rend() const noexcept;
    _NODISCARD const_iterator cbegin() const noexcept;
    _NODISCARD const_iterator cend() const noexcept;
    _NODISCARD const_reverse_iterator crbegin() const noexcept;
    _NODISCARD const_reverse_iterator crend() const noexcept;

    // [hive.capacity], capacity
    _NODISCARD_EMPTY_MEMBER bool empty() const noexcept;
    _NODISCARD size_type size() const noexcept;
    _NODISCARD size_type max_size() const noexcept;
    _NODISCARD size_type capacity() const noexcept;

    void reserve(size_type _New_capacity);

    void shrink_to_fit();

    void trim_capacity() noexcept;
    void trim_capacity(size_type _Min_capacity) noexcept;

    _NODISCARD constexpr hive_limits block_capacity_limits() const noexcept;
    _NODISCARD static constexpr hive_limits block_capacity_default_limits() noexcept;
    _NODISCARD static constexpr hive_limits block_capacity_hard_limits() noexcept;

    void reshape(hive_limits _New_limits);

    // [hive.modifiers], modifiers
    template <class... _Valty>
    iterator emplace(_Valty&&... _Val);
    template <class... _Valty>
    iterator emplace_hint(const_iterator, _Valty&&... _Val);
    iterator insert(const _Ty& _Val);
    iterator insert(_Ty&& _Val);
    iterator insert(const_iterator, const _Ty& _Val);
    iterator insert(const_iterator, _Ty&& _Val);

    void insert(initializer_list<_Ty> _Ilist);
    template <_Container_compatible_range<_Ty> _Rng>
    void insert_range(_Rng&& _Range);
    template <_Iterator_for_container _Iter>
    void insert(_Iter _First, _Iter _Last);
    void insert(size_type _Count, const _Ty& _Val);

    iterator erase(const_iterator _Where);
    iterator erase(const_iterator _First, const_iterator _Last);

    void swap(hive&) noexcept(_Alty_traits::propagate_on_container_swap::value || _Alty_traits::is_always_equal::value);

    void clear() noexcept;

    // [hive.operations], hive operations
    void splice(hive& _Right);
    void splice(hive&& _Right);

    template <class _Pr2 = equal_to<_Ty>>
    size_type unique(_Pr2 _Pred = _Pr2());

    template <class _Pr2 = less<_Ty>>
    void sort(_Pr2 _Pred = _Pr2());

    _NODISCARD iterator get_iterator(const_pointer _Ptr) noexcept;
    _NODISCARD const_iterator get_iterator(const_pointer _Ptr) const noexcept;

private:
    _Scary_val _Myval;
};

template <_Iterator_for_container _Iter, _Allocator_for_container _Alloc = allocator<_Iter_value_t<_Iter>>>
hive(_Iter, _Iter, _Alloc = _Alloc()) -> hive<_Iter_value_t<_Iter>, _Alloc>;

template <_Iterator_for_container _Iter, _Allocator_for_container _Alloc = allocator<_Iter_value_t<_Iter>>>
hive(_Iter, _Iter, hive_limits, _Alloc = _Alloc()) -> hive<_Iter_value_t<_Iter>, _Alloc>;

template <_RANGES input_range _Rng, _Allocator_for_container _Alloc = allocator<_RANGES range_value_t<_Rng>>>
hive(from_range_t, _Rng&&, _Alloc = _Alloc()) -> hive<_RANGES range_value_t<_Rng>, _Alloc>;

template <_RANGES input_range _Rng, _Allocator_for_container _Alloc = allocator<_RANGES range_value_t<_Rng>>>
hive(from_range_t, _Rng&&, hive_limits, _Alloc = _Alloc()) -> hive<_RANGES range_value_t<_Rng>, _Alloc>;

_EXPORT_STD template <class _Ty, class _Alloc>
void swap(hive<_Ty, _Alloc>& _Left, hive<_Ty, _Alloc>& _Right) noexcept(noexcept(_Left.swap(_Right)));

_EXPORT_STD template <class _Ty, class _Alloc, class _Uty = _Ty>
hive<_Ty, _Alloc>::size_type erase(hive<_Ty, _Alloc>& _Cont, const _Uty& _Val);

_EXPORT_STD template <class _Ty, class _Alloc, class _Pr>
hive<_Ty, _Alloc>::size_type erase_if(hive<_Ty, _Alloc>& _Cont, _Pr _Pred);

namespace pmr {
    _EXPORT_STD template <class _Ty>
    using hive = _STD hive<_Ty, polymorphic_allocator<_Ty>>;
}
_STD_END

#pragma pop_macro("new")
_STL_RESTORE_CLANG_WARNINGS
#pragma warning(pop)
#pragma pack(pop)
#endif // ^^^ _HAS_CXX26 ^^^
#endif // _STL_COMPILER_PREPROCESSOR
#endif // _HIVE_
