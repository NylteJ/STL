private:
    _NODISCARD constexpr _Temp_new_block _Alloc_block(_Block_size_t _Block_cap) {
        _STL_INTERNAL_CHECK(_Myval._Limits._Contains(_Block_cap));
        _STL_INTERNAL_CHECK(_Block_cap > 0);
        _STL_INTERNAL_CHECK(_Block_cap <= max_size() - _Myval._Capacity);
        _STL_INTERNAL_STATIC_ASSERT(is_implicit_lifetime_v<_Block>);
        _STL_INTERNAL_STATIC_ASSERT(is_implicit_lifetime_v<_Union>);

        _Alblk _Alb(_Al);
        _Alloc_construct_ptr _New_block(_Alb);
        _New_block._Allocate();

        _Alunion _Alu(_Al);
        _Alloc_construct_n_ptr _New_data(_Alu, _Block_cap);
        _New_data._Allocate();

        {
            using _Skip_t     = _Block::_Skipfield_t;
            using _Alskip     = _Rebind_alloc_t<_Alloc, _Skip_t>;
            using _Alskp_size = _Alloc_size_t<_Alskip>;
            _Alskip _Als(_Al);
            _New_block._Ptr->_Skip =
                allocator_traits<_Alskip>::allocate(_Als, static_cast<_Alskp_size>(_Block_cap + 1uz),
                    _New_data._Ptr); // no need to be protected
            _STL_INTERNAL_STATIC_ASSERT(is_implicit_lifetime_v<_Skip_t>);
        }

        _New_block._Ptr->_Data     = _New_data._Release();
        _New_block._Ptr->_Capacity = _Block_cap;

        return _Temp_new_block{*this, _New_block._Release()};
    }

    [[noreturn]] static void _Xlength() {
        _STD _Xlength_error("hive too long");
    }

    // Allocates as precisely as possible, returns the actual allocated size.
    template <class _Fn>
    constexpr size_type _Alloc_exact_n(size_type _Count, _Fn _Func) {
        _STL_INTERNAL_CHECK(_Count > 0);
        const auto _Limits = _Myval._Limits;
        if constexpr (_Max_limit_may_be_zero) {
            if (_Limits.max == 0) {
                _Xlength();
            }
        }

        const auto _Block_count     = static_cast<size_type>((_Count + (_Limits.max - 1uz)) / _Limits.max);
        const auto _Base_elem_cnt   = static_cast<size_type>(_Block_count * _Limits.min);
        const auto _Actual_elem_cnt = (_STD max) (_Count, _Base_elem_cnt);

        if (_Actual_elem_cnt > max_size() - _Myval._Capacity) {
            _Xlength();
        }

        const auto _Extra_elem_cnt = static_cast<size_type>(_Actual_elem_cnt - _Base_elem_cnt);
        if (_Extra_elem_cnt == 0) {
            for (size_type _Idx = 0; _Idx != _Block_count; ++_Idx) {
                _Func(_Alloc_block(_Limits.min));
            }
        } else {
            const auto _Limits_length = _Limits.max - _Limits.min;
            _STL_INTERNAL_CHECK(_Limits_length != 0);
            const auto _Max_block_cnt = static_cast<size_type>(_Extra_elem_cnt / _Limits_length);
            const auto _Rest_elem_cnt = static_cast<size_type>(_Extra_elem_cnt % _Limits_length);

            _STL_INTERNAL_CHECK(_Max_block_cnt <= _Block_count);
            const auto _Nonmax_blk_cnt = static_cast<size_type>(_Block_count - _Max_block_cnt);
            if (_Nonmax_blk_cnt > 0) {
                for (size_type _Idx = 1; _Idx < _Nonmax_blk_cnt; ++_Idx) {
                    _Func(_Alloc_block(_Limits.min));
                }
                _Func(_Alloc_block(static_cast<_Block_size_t>(_Limits.min + _Rest_elem_cnt)));
            }
            for (size_type _Idx = 0; _Idx != _Max_block_cnt; ++_Idx) {
                _Func(_Alloc_block(_Limits.max));
            }
        }

        return _Actual_elem_cnt;
    }

    template <_Iterator_for_container _Iter, class _SizedOp, class _UnsizedOp>
    constexpr void _Dispatch_range_op(_Iter& _First, _Iter& _Last, _SizedOp _Sized, _UnsizedOp _Unsized) {
        _STD _Adl_verify_range(_First, _Last);
        auto&& _UFirst = _STD _Get_unwrapped(_STD move(_First));
        auto&& _ULast  = _STD _Get_unwrapped(_STD move(_Last));

        using _UIter = remove_cvref_t<decltype(_UFirst)>;

        if constexpr (sized_sentinel_for<_UIter, _UIter>) {
            const auto _Dist = _ULast - _UFirst;
#if _ITERATOR_DEBUG_LEVEL != 0
            _STL_VERIFY(_Dist >= 0, "input range transposed");
#endif // _ITERATOR_DEBUG_LEVEL != 0
            const auto _Size = _STD _Convert_size<size_type>(_STD _To_unsigned_like(_Dist));
            _Sized(_Size, _UFirst);
        } else {
            _Unsized(_UFirst, _ULast);
        }
    }

    template <_Container_compatible_range<_Ty> _Rng, class _SizedOp, class _UnsizedOp, class _ApproxedOp>
    constexpr void _Dispatch_range_op(_Rng& _Range, _SizedOp _Sized, _UnsizedOp _Unsized, _ApproxedOp _Approxed) {
        if constexpr (_RANGES sized_range<_Rng>) {
            const auto _Size = _STD _Convert_size<size_type>(_RANGES size(_Range));
            _Sized(_Size, _RANGES _Ubegin(_Range));
        } else {
#ifdef __cpp_lib_ranges_reserve_hint // TRANSITION, GH-5299
            if constexpr (_RANGES approximately_sized_range<_Rng>) {
                const auto _Approx_size = _STD _Convert_size<size_type>(_RANGES reserve_hint(_Range));
                _Approxed(_Approx_size, _RANGES _Ubegin(_Range), _RANGES _Uend(_Range));
            } else
#else // ^^^ defined(__cpp_lib_ranges_reserve_hint) / !defined(__cpp_lib_ranges_reserve_hint) vvv
            (void) _Approxed;
#endif // ^^^ !defined(__cpp_lib_ranges_reserve_hint) ^^^
            {
                _Unsized(_RANGES _Ubegin(_Range), _RANGES _Uend(_Range));
            }
        }
    }

    // Precisely allocates blocks, calls _Func to construct elements in, activates them, and sets size and capacity.
    // _Tidy *this if an exception is thrown; should only be called in constructors.
    template <class _Fn>
    constexpr void _Construct_n(size_type _Count, _Fn _Func);

public:
    explicit hive(size_type _Count, const _Alloc& _Allocator = _Alloc());
    hive(size_type _Count, hive_limits _Block_limits, const _Alloc& _Allocator = _Alloc());

    hive(size_type _Count, const _Ty& _Val, const _Alloc& _Allocator = _Alloc())
        : hive(_Count, _Val, block_capacity_default_limits(), _Allocator) {}
    hive(size_type _Count, const _Ty& _Val, hive_limits _Block_limits, const _Alloc& _Allocator = _Alloc())
        : _Al(_Allocator), _Myval(_Block_limits) {
        _Verify_limits(_Block_limits);
        _Construct_n(_Count, _Lambdas::template _Fill_blk<_Lambdas::_Uninit>(_Val));
    }

private:
    template <class _It>
    constexpr void _Construct_sized_rng(size_type _Size, _It&& _First) {
        _Construct_n(_Size, _Lambdas::template _Copy_move_to_blk<_Lambdas::_Copy | _Lambdas::_Uninit>(_First));
    }

    template <class _It, class _Se>
    constexpr void _Construct_unsized_rng(_It&& _First, _Se&& _Last);

public:
    template <_Iterator_for_container _Iter>
    hive(_Iter _First, _Iter _Last, const _Alloc& _Allocator = _Alloc())
        : hive(_STD move(_First), _STD move(_Last), block_capacity_default_limits(), _Allocator) {}
    template <_Iterator_for_container _Iter>
    hive(_Iter _First, _Iter _Last, hive_limits _Block_limits, const _Alloc& _Allocator = _Alloc())
        : _Al(_Allocator), _Myval(_Block_limits) {
        _Verify_limits(_Block_limits);
        _Dispatch_range_op(
            _First, _Last, [&](auto&&... _Args) { _Construct_sized_rng(_Args...); },
            [&](auto&&... _Args) { _Construct_unsized_rng(_Args...); });
    }

    template <_Container_compatible_range<_Ty> _Rng>
    hive(from_range_t, _Rng&& _Range, const _Alloc& _Allocator = _Alloc())
        : hive(from_range, _Range, block_capacity_default_limits(), _Allocator) {}
