template <class _Iter, class _Pr>
class _Bidi_container_inplace_sorter {
    // Provides sorting for bidirectional ranges. Constructs and destroys temporary objects via allocator, guarantees
    // worst-case O(N log N) complexity, and allocates no extra memory.
private:
    _STL_INTERNAL_STATIC_ASSERT(bidirectional_iterator<_Iter>);
    _STL_INTERNAL_STATIC_ASSERT(same_as<_Pr, decltype(_STD _Pass_fn(_STD declval<_Pr&>()))>);

    using _Sorter = _Bidi_container_inplace_sorter;

    using _Diff = iter_difference_t<_Iter>;

    using _Partition_result = pair<_Iter, _Iter>;

    template <class _Alloc>
    struct _Fallback_rand {
        _STL_INTERNAL_STATIC_ASSERT(random_access_iterator<_Iter>);

        static constexpr void _Make_heap_unchecked(_Iter _First, _Iter _Last, _Pr _Pred, _Alloc& _Al) {
            // make [_First, _Last) into a heap
            _Diff _Bottom = _Last - _First;
            for (_Diff _Hole = _Bottom >> 1; _Hole > 0;) { // shift for codegen
                // reheap top half, bottom to top
                --_Hole;
                _Alloc_temporary2<_Alloc> _Val(_Al, _STD move(*(_First + _Hole)));
                _STD _Pop_heap_hole_by_index(_First, _Hole, _Bottom, _STD move(_Val._Get_value()), _Pred);
            }
        }

        static constexpr void _Pop_heap_unchecked(_Iter _First, _Iter _Last, _Pr _Pred, _Alloc& _Al) {
            // pop *_First to *(_Last - 1) and reheap
            if (2 <= _Last - _First) {
                --_Last;
                _Alloc_temporary2<_Alloc> _Val(_Al, _STD move(*_Last));
                _STD _Pop_heap_hole_unchecked(_First, _Last, _Last, _STD move(_Val._Get_value()), _Pred);
            }
        }

        static constexpr void _Sort_heap_unchecked(const _Iter _First, _Iter _Last, _Pr _Pred, _Alloc& _Al) {
            // order heap by repeatedly popping
            for (; _Last - _First >= 2; --_Last) {
                _Fallback_rand::_Pop_heap_unchecked(_First, _Last, _Pred, _Al);
            }
        }
    };

    struct _Fallback_bidi {
        static constexpr _Iter _Collect_medians_of_five(const _Iter& _First, _Diff _Median_count, _Pr _Pred) {
            // collect the medians of five at the beginning of the range
            _Iter _Med_out = _First;

            _Iter _Rng5_0 = _First;
            for (_Diff _Idx = 0; _Idx != _Median_count; ++_Idx) {
                auto _Rng5_1       = _STD _Next_iter(_Rng5_0);
                const auto _Rng5_2 = _STD _Next_iter(_Rng5_1);
                const auto _Rng5_3 = _STD _Next_iter(_Rng5_2);
                const auto _Rng5_4 = _STD _Next_iter(_Rng5_3);

                _STD _Med3_unchecked(_Rng5_0, _Rng5_1, _Rng5_2, _Pred);
                if (_DEBUG_LT_PRED(_Pred, *_Rng5_4, *_Rng5_3)) {
                    swap(*_Rng5_4, *_Rng5_3); // intentional ADL
                }

                // now 0 <= 1 <= 2, and 3 <= 4
                auto& _Guess = _Rng5_1;
                if (_DEBUG_LT_PRED(_Pred, *_Rng5_4, *_Rng5_1)) { // 4 < 1
                    if (_DEBUG_LT_PRED(_Pred, *_Rng5_0, *_Rng5_4)) { // 0 < 4 < 1
                        _Guess = _Rng5_4;
                    } else { // 4 <= 0
                        _Guess = _Rng5_0;
                    }
                } else if (_DEBUG_LT_PRED(_Pred, *_Rng5_1, *_Rng5_3)) { // 1 < 3
                    if (_DEBUG_LT_PRED(_Pred, *_Rng5_2, *_Rng5_3)) { // 2 < 3
                        _Guess = _Rng5_2;
                    } else { // 1 < 3 <= 2
                        _Guess = _Rng5_3;
                    }
