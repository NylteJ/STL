template <size_t _ValueSize>
using _Hive_skipfield_t = conditional_t<_ValueSize >= 4, uint16_t, uint8_t>;

template <class _ValueT>
constexpr bool _Hive_use_bitset = sizeof(_ValueT) < 2 * sizeof(_Hive_skipfield_t<sizeof(_ValueT)>);

template <class _ValueT>
struct _Hive_union_provider {
    _STL_INTERNAL_STATIC_ASSERT(false);
};
template <class _ValueT, class _HiveSizeT, class _AnyPtrT>
struct _Hive_block_provider {
    _STL_INTERNAL_STATIC_ASSERT(false);
};

// skipfield mode
template <class _SkipT>
constexpr _SkipT _Hive_skipfield_zero = 0; // for sentinel block

template <class _ValueT>
    requires (!_Hive_use_bitset<_ValueT>)
struct _Hive_union_provider<_ValueT> {
    union _Union {
        struct _Free_list_node {
            using _Index = _Hive_skipfield_t<sizeof(_ValueT)>;
            _Index _Prev;
            _Index _Next;
        };

        _ValueT _Value;
        _Free_list_node _Free;

        ~_Union() = delete; // FIXME: unnecessary in C++26
    };
};

template <class _ValueT, class _HiveSizeT, class _AnyPtrT>
    requires (!_Hive_use_bitset<_ValueT>)
struct _Hive_block_provider<_ValueT, _HiveSizeT, _AnyPtrT> {
    struct _Block : _Hive_block_base {
        static constexpr bool _Bitset_mode = false;

        using _Union         = _Hive_union_provider<_ValueT>::_Union;
        using _Union_ptr     = _Rebind_pointer_t<_AnyPtrT, _Union>;
        using _Block_ptr     = _Rebind_pointer_t<_AnyPtrT, _Block>;
        using _Skipfield_t   = _Hive_skipfield_t<sizeof(_ValueT)>;
        using _Skipfield_ptr = _Rebind_pointer_t<_AnyPtrT, _Skipfield_t>;
        using _Order_id_t    = _HiveSizeT;
        using _Size_t        = _Skipfield_t;

        static constexpr auto _Free_npos = _STD _Max_limit<_Size_t>();

        _Block_ptr _Next; // active blocks list and reserved blocks list
        _Block_ptr _Prev; // active blocks list

        // blocks with unused memory (due to element erasure or unused tail space)
        _Block_ptr _Next_nonfull;
        _Block_ptr _Prev_nonfull;

        _Union_ptr _Data;

        _Skipfield_ptr _Skip; // has one extra 0 past the end

        _Size_t _Capacity;
        _Size_t _Size;

        _Size_t _First_free; // first index of the first skipblock in the free list
        // Note: The free list node data is stored at the end of the skipblock, but _First_free references the beginning
        // of the skipblock. This way, the insertion position is directly provided by _First_free, and the node data
        // only needs to be updated once per skipblock when it is filled.

        _Order_id_t _Order_id;

        static constexpr _Block _Sentinel(_Block& _Blk) noexcept {
            const auto _Ptr = pointer_traits<_Block_ptr>::pointer_to(_Blk);
            return {
                ._Next         = _Ptr,
                ._Prev         = _Ptr,
                ._Next_nonfull = _Ptr,
                ._Prev_nonfull = _Ptr,
                ._Data         = nullptr,
                ._Skip         = pointer_traits<_Skipfield_ptr>::pointer_to(
                    const_cast<_Skipfield_t&>(_Hive_skipfield_zero<_Skipfield_t>)),
                ._Capacity   = 0,
                ._Size       = 0,
                ._First_free = 0,
                ._Order_id   = _STD _Max_limit<_Order_id_t>(),
            };
        }

        _NODISCARD constexpr bool _Is_sent() const noexcept {
            return _Order_id == _STD _Max_limit<_Order_id_t>();
        }

        _NODISCARD constexpr _Size_t _First_element() const noexcept {
            return _Skip[0];
        }

        _NODISCARD constexpr bool _Full() const noexcept {
            _STL_INTERNAL_CHECK(_Size <= _Capacity);
            return _Size == _Capacity;
        }

        // first + [0, second)
        _NODISCARD constexpr pair<_Size_t, _Size_t> _First_free_range() {
            _STL_INTERNAL_CHECK(!this->_Full());
            _STL_INTERNAL_CHECK(_First_free < _Capacity);
            _STL_INTERNAL_CHECK(this->_Skip[_First_free] > 0);
            return {_First_free, this->_Skip[_First_free]};
        }

        // Init uninitialized block, except order id and IDL=2 data.
        constexpr void _Init(_Size_t _Element_count) noexcept {
            _Size = _Element_count;
            if (!this->_Full()) {
                _First_free                      = _Size;
                this->_Data[_Capacity - 1]._Free = {_Free_npos, _Free_npos};
                _STD _Uninitialized_value_construct_n_unchecked1(_Skip, _Size);
                this->_Skip[_Capacity] = 0;
                this->_Skip[_Size] = this->_Skip[_Capacity - 1] = static_cast<_Size_t>(_Capacity - _Size);
            } else {
                _STD _Uninitialized_value_construct_n_unchecked1(_Skip, _Capacity + 1);
            }
        }

        struct _Emplace_guard {
            _Union_ptr _Pos;
            typename _Union::_Free_list_node _Node;
            constexpr explicit _Emplace_guard(_Union_ptr _Pos_) : _Pos(_Pos_), _Node(_Pos->_Free) {}
            constexpr ~_Emplace_guard() noexcept {
                if (_Pos != nullptr) {
                    _Pos->_Free = _Node;
                }
            }
        };

        // Does not modify the nonfull blocks list. Returns the index of the new element.
        // provides strong guarantee
        template <class _Fn>
        constexpr _Size_t _Emplace_one(_Fn _Func) {
            _STL_INTERNAL_CHECK(!this->_Full());

            const auto [_Free_pos, _Free_len] = _First_free_range();
            _STL_INTERNAL_CHECK(_Free_len > 0);
            if (_Free_len != 1) {
                _Func(_Data + _Free_pos);
                this->_Skip[_Free_pos]     = 0;
                this->_Skip[_Free_pos + 1] = this->_Skip[_Free_pos + _Free_len - 1] =
                    static_cast<_Size_t>(_Free_len - 1);
                ++_First_free;
            } else {
                _STL_INTERNAL_CHECK(this->_Data[_Free_pos]._Free._Prev == _Free_npos);
                const auto _Next_free = this->_Data[_Free_pos]._Free._Next;

                _Emplace_guard _Guard{_Data + _Free_pos};
                _Func(_Data + _Free_pos);
                _Guard._Pos = nullptr;

                if (_Next_free != _Free_npos) {
                    this->_Data[_Next_free]._Free._Prev = _Free_npos;
                    _First_free = static_cast<_Size_t>(_Next_free + 1 - this->_Skip[_Next_free]);
                }
                this->_Skip[_Free_pos] = 0;
            }
            ++_Size;

            return _Free_pos;
        }

        // n > 0
        template <class _Fn>
        constexpr void _Emplace_n(_Size_t _Count, _Fn _Func) {
            _STL_INTERNAL_CHECK(_Size + _Count <= _Capacity);

            _STL_INTERNAL_CHECK(_Count > 0);
            do {
                const auto [_Free_pos, _Free_len] = _First_free_range();
                const auto _Cnt                   = (_STD min) (_Count, _Free_len);
                this->_Emplace_n_at(_Free_pos, _Cnt, _STD _Pass_fn(_Func));
                _Count -= _Cnt;
            } while (_Count != 0);
        }

        // n > 0
        template <class _Fn>
        constexpr void _Emplace_n_at(_Size_t _Pos, _Size_t _Count, _Fn _Func) {
            _STL_INTERNAL_CHECK(_Pos < _Capacity);
            _STL_INTERNAL_CHECK(_Count > 0);

            const auto _Length = this->_Skip[_Pos];
            _STL_INTERNAL_CHECK(_Length >= _Count);
            _STL_INTERNAL_CHECK(_Length == this->_Skip[_Pos + _Length - 1]);
            if (_Count != _Length) {
                _Func(_Data + _Pos, _Count);

                _RANGES fill_n(_STD to_address(_Skip + _Pos), _Count, _Size_t{0});
                _Size += _Count;

                this->_Skip[_Pos + _Count] = this->_Skip[_Pos + _Length - 1] = static_cast<_Size_t>(_Length - _Count);
                if (_Pos == _First_free) {
                    _First_free = static_cast<_Size_t>(_Pos + _Count);
                }
            } else {
                const auto _Node_pos  = _Pos + _Length - 1;
                const auto _Node_data = this->_Data[_Node_pos]._Free;

                _Emplace_guard _Guard{_Data + _Node_pos};
                _Func(_Data + _Pos, _Count);
                _Guard._Pos = nullptr;

                _RANGES fill_n(_STD to_address(_Skip + _Pos), _Count, _Size_t{0});
                _Size += _Count;

                this->_Remove_from_free_list(_Node_data._Prev, _Node_data._Next);
            }
        }

        constexpr void _Mark_erased(_Size_t _Pos) noexcept {
            _STL_INTERNAL_CHECK(this->_Skip[_Pos] == 0);
            _STL_INTERNAL_CHECK(_Size > 1);

            const bool _Left_erased  = _Pos != 0 && this->_Skip[_Pos - 1] != 0;
            const bool _Right_erased = this->_Skip[_Pos + 1] != 0;
            const auto _Left_skip    = _Left_erased ? this->_Skip[_Pos - 1] : 0;
            const auto _Right_skip   = this->_Skip[_Pos + 1];
            const auto _Left_idx     = static_cast<_Size_t>(_Pos - _Left_skip);
            const auto _Right_idx    = static_cast<_Size_t>(_Pos + _Right_skip);
            const auto _New_skip     = static_cast<_Size_t>(_Left_skip + 1 + _Right_skip);

            this->_Skip[_Left_idx] = this->_Skip[_Right_idx] = _New_skip;

            if (_Left_erased) {
                if (_Right_erased) {
                    this->_Remove_from_free_list(_Pos - 1u);
                } else {
                    const auto _Free_node = this->_Data[_Pos - 1]._Free;

                    if (_Free_node._Prev != _Free_npos) {
                        this->_Data[_Free_node._Prev]._Free._Next = _Pos;
                    }

                    if (_Free_node._Next != _Free_npos) {
                        this->_Data[_Free_node._Next]._Free._Prev = _Pos;
                    }
                    this->_Data[_Pos]._Free = _Free_node;
                }
            }

            if (_Right_erased) {
                if (_First_free == _Pos + 1) {
                    _First_free = _Left_idx;
                }
            }

            if (!_Left_erased && !_Right_erased) {
                this->_Data[_Pos]._Free._Prev = _Free_npos;
                if (!this->_Full()) {
                    const auto _Next_node_pos     = static_cast<_Size_t>(_First_free + this->_Skip[_First_free] - 1);
                    this->_Data[_Pos]._Free._Next = _Next_node_pos;
                    this->_Data[_Next_node_pos]._Free._Prev = _Pos;
                } else {
                    this->_Data[_Pos]._Free._Next = _Free_npos;
                }
                _First_free = _Left_idx;
            }

            --_Size;
        }

        constexpr void _Mark_erased(_Size_t _First, _Size_t _Last, _Size_t _Elem_count) noexcept {
            _STL_INTERNAL_CHECK(_First < _Last && _Last <= _Capacity);
            _STL_INTERNAL_CHECK(_Size > _Elem_count);
            _STL_INTERNAL_CHECK(this->_Skip[_First] == 0 && this->_Skip[_Last] == 0);

            const bool _Left_erased = _First != 0 && this->_Skip[_First - 1] != 0;
            const auto _Left_skip   = _Left_erased ? this->_Skip[_First - 1] : _Size_t{0};
            const auto _Left_idx    = static_cast<_Size_t>(_First - _Left_skip);
            const auto _Dist        = static_cast<_Size_t>(_Last - _First);
            const auto _Right_idx   = static_cast<_Size_t>(_Last - 1);

            bool _All_free_nodes_removed = false;
            if (_Dist != _Elem_count) { // there are skipblocks in the range, update free list
                _STL_INTERNAL_CHECK(!this->_Full());
                _All_free_nodes_removed = true;
                for (auto _Tail = static_cast<_Size_t>(_First_free + this->_Skip[_First_free] - 1);;) {
                    const auto _Next_tail = this->_Data[_Tail]._Free._Next;

                    const auto _Head = static_cast<_Size_t>(_Tail - this->_Skip[_Tail] + 1);
                    // [_Head, _Tail] is empty
                    if (_First < _Head && _Tail < _Last) {
                        this->_Remove_from_free_list(_Tail);
                    } else {
                        _All_free_nodes_removed = false;
                    }

                    if (_Next_tail == _Free_npos) {
                        break;
                    }
                    _Tail = _Next_tail;
                }
            }

            if (_Left_erased) {
                const auto _Left_free = this->_Data[_First - 1]._Free;

                if (_Left_free._Prev != _Free_npos) {
                    this->_Data[_Left_free._Prev]._Free._Next = _Right_idx;
                }

                if (_Left_free._Next != _Free_npos) {
                    this->_Data[_Left_free._Next]._Free._Prev = _Right_idx;
                }
                this->_Data[_Right_idx]._Free = _Left_free;
            } else {
                this->_Data[_Right_idx]._Free._Prev = _Free_npos;
                if (!_All_free_nodes_removed && !this->_Full()) {
                    const auto _Next_node = static_cast<_Size_t>(_First_free + this->_Skip[_First_free] - 1);
                    this->_Data[_Right_idx]._Free._Next = _Next_node;
                    this->_Data[_Next_node]._Free._Prev = _Right_idx;
                } else {
                    this->_Data[_Right_idx]._Free._Next = _Free_npos;
                }
                _First_free = _Left_idx;
            }

            this->_Skip[_Left_idx] = this->_Skip[_Right_idx] = static_cast<_Size_t>(_Last - _Left_idx);
            _Size -= _Elem_count;
        }

    private:
        constexpr void _Remove_from_free_list(_Size_t _Prev_idx, _Size_t _Next_idx) {
            if (_Prev_idx != _Free_npos) {
                if (_Next_idx != _Free_npos) {
                    this->_Data[_Prev_idx]._Free._Next = _Next_idx;
                    this->_Data[_Next_idx]._Free._Prev = _Prev_idx;
                } else {
                    this->_Data[_Prev_idx]._Free._Next = _Free_npos;
                }
            } else {
                if (_Next_idx != _Free_npos) {
                    this->_Data[_Next_idx]._Free._Prev = _Free_npos;
                    _First_free                        = static_cast<_Size_t>(_Next_idx + 1 - this->_Skip[_Next_idx]);
                }
            }
        }
        constexpr void _Remove_from_free_list(_Size_t _Idx) noexcept {
            const auto _Prev_idx = this->_Data[_Idx]._Free._Prev;
            const auto _Next_idx = this->_Data[_Idx]._Free._Next;
            this->_Remove_from_free_list(_Prev_idx, _Next_idx);
        }
    };
};

// bitset mode
template <size_t _BitCount>
struct _Hive_bitset {
    using _Word_t = size_t;

    static constexpr size_t _Word_bits  = sizeof(_Word_t) * CHAR_BIT;
    static constexpr size_t _Word_count = (_BitCount + (_Word_bits - 1)) / _Word_bits;

    _Word_t _Words[_Word_count];

    struct _Sentinel_tag {};
    constexpr explicit _Hive_bitset(_Sentinel_tag) noexcept {
        if !consteval {
            _Words[0] = 0;
        } else {
            this->_Reset();
        }
    }
    constexpr _Hive_bitset() noexcept = default;

    constexpr void _Set(size_t _Pos) noexcept {
        _STL_INTERNAL_CHECK(_Pos < _BitCount);
        _Words[_Pos / _Word_bits] |= 1uz << (_Pos % _Word_bits);
    }

    constexpr void _Reset(size_t _Pos) noexcept {
        _STL_INTERNAL_CHECK(_Pos < _BitCount);
        _Words[_Pos / _Word_bits] &= ~(1uz << (_Pos % _Word_bits));
    }
    constexpr void _Reset(size_t _First, size_t _Last) noexcept {
        _STL_INTERNAL_CHECK(_First < _Last && _Last <= _BitCount);

        // mostly copied from _Fill_vbool
        auto _WFirst         = _Words + _First / _Word_bits;
        const auto _WLast    = _Words + _Last / _Word_bits;
        const auto _FirstOff = _First % _Word_bits;
        const auto _LastOff  = _Last % _Word_bits;

        constexpr auto _FullWord    = static_cast<_Word_t>(-1);
        const auto _FirstSourceMask = _FullWord << _FirstOff;
        const auto _FirstDestMask   = ~_FirstSourceMask;
        constexpr auto _FillVal     = static_cast<_Word_t>(0);

        if (_WFirst == _WLast) {
            // We already excluded _First == _Last, so here _LastOff > 0 and the shift is safe
            const auto _LastSourceMask = _FullWord >> (_Word_bits - _LastOff);
            const auto _LastDestMask   = ~_LastSourceMask;
            const auto _SourceMask     = _FirstSourceMask & _LastSourceMask;
            const auto _DestMask       = _FirstDestMask | _LastDestMask;
            *_WFirst                   = (*_WFirst & _DestMask) | (_FillVal & _SourceMask);
            return;
        }

        *_WFirst = (*_WFirst & _FirstDestMask) | (_FillVal & _FirstSourceMask);
        ++_WFirst;

        if consteval {
            for (; _WFirst != _WLast; ++_WFirst) {
                *_WFirst = _FillVal;
            }
        } else {
            const auto _WFirst_ch   = reinterpret_cast<const char*>(_WFirst);
            const auto _WLast_ch    = reinterpret_cast<const char*>(_WLast);
            const auto _Count_ch    = static_cast<size_t>(_WLast_ch - _WFirst_ch);
            constexpr auto _ValChar = static_cast<unsigned char>(0);
            _CSTD memset(_WFirst, _ValChar, _Count_ch);
            _WFirst = _WLast;
        }

        if (_LastOff != 0) {
            const auto _LastSourceMask = _FullWord >> (_Word_bits - _LastOff);
            const auto _LastDestMask   = ~_LastSourceMask;
            *_WFirst                   = (*_WFirst & _LastDestMask) | (_FillVal & _LastSourceMask);
        }
    }
    constexpr void _Reset() noexcept {
        for (auto&& _Word : _Words) {
            _Word = 0;
