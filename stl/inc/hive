template <class _ValueT, class _HiveSizeT, class _AnyPtrT>
    requires (_Hive_use_bitset<_ValueT>)
struct _Hive_block_provider<_ValueT, _HiveSizeT, _AnyPtrT> {
    struct _Block : _Hive_block_base {
        static constexpr bool _Bitset_mode = true;

        using _Block_ptr  = _Rebind_pointer_t<_AnyPtrT, _Block>;
        using _Union      = _Hive_union_provider<_ValueT>::_Union;
        using _Union_ptr  = _Rebind_pointer_t<_AnyPtrT, _Union>;
        using _Order_id_t = _HiveSizeT;
        using _Size_t     = _Hive_skipfield_t<sizeof(_ValueT)>;

        static constexpr auto _Size_max      = _STD _Max_limit<_Size_t>();
        static constexpr size_t _Bitset_bits = _Size_max + 1;
        _STL_INTERNAL_STATIC_ASSERT(_Bitset_bits <= 256); // otherwise _First_free_range() is closer to O(N)

        using _Bitset_t = _Hive_bitset<_Bitset_bits>;

        static constexpr auto _Bitset_word_bits = _Bitset_t::_Word_bits;

        _Block_ptr _Next; // active blocks list and reserved blocks list
        _Block_ptr _Prev; // active blocks list

        // blocks with unused memory (due to element erasure or unused tail space)
        _Block_ptr _Next_nonfull;
        _Block_ptr _Prev_nonfull;

        _Bitset_t _Empty;

        _Union_ptr _Data; // also act as skipfield

        _Size_t _Capacity;
        _Size_t _Size;

        _Order_id_t _Order_id;

        static constexpr _Block _Sentinel(_Block& _Blk) noexcept {
            const auto _Ptr = pointer_traits<_Block_ptr>::pointer_to(_Blk);
            return {
                ._Next         = _Ptr,
                ._Prev         = _Ptr,
                ._Next_nonfull = _Ptr,
                ._Prev_nonfull = _Ptr,
                ._Empty{typename _Bitset_t::_Sentinel_tag{}},
                ._Data     = nullptr,
                ._Capacity = 0,
                ._Size     = 0,
                ._Order_id = _STD _Max_limit<_Order_id_t>(),
            };
        }

        _NODISCARD constexpr bool _Is_sent() const noexcept {
            return _Order_id == _STD _Max_limit<_Order_id_t>();
        }

        _NODISCARD constexpr _Size_t _First_element() const noexcept {
            return _Empty[0] ? _Data[0]._Skip : _Size_t{0};
        }

        _NODISCARD constexpr bool _Full() {
            _STL_INTERNAL_CHECK(_Size <= _Capacity);
            return _Size == _Capacity;
        }

        // first + [0, second)
        _NODISCARD constexpr pair<_Size_t, _Size_t> _First_free_range() {
            _STL_INTERNAL_CHECK(!this->_Full());
            const auto _First_free = static_cast<_Size_t>(_Empty._First_one());
            return {_First_free, this->_Data[_First_free]._Skip};
        }

        // Init uninitialized block, except order id and IDL=2 data.
        constexpr void _Init(_Size_t _Element_count) noexcept {
            _Empty._Reset();
            _Size = _Element_count;

            if (!this->_Full()) {
                _Empty._Set(_Size);
                _Empty._Set(_Capacity - 1uz);
                this->_Data[_Size]._Skip = this->_Data[_Capacity - 1]._Skip = static_cast<_Size_t>(_Capacity - _Size);
            }
        }

        struct _Emplace_guard {
            _Union_ptr _Pos;
            typename _Union::_Skip_t _Skip;
            constexpr explicit _Emplace_guard(_Union_ptr _Pos_) : _Pos(_Pos_), _Skip(_Pos->_Skip) {}
            constexpr ~_Emplace_guard() noexcept {
                if (_Pos != nullptr) {
                    _Pos->_Skip = _Skip;
                }
            }
        };

        // Does not modify the nonfull blocks list. Returns the index of the new element.
        // provides strong guarantee
        template <class _Fn>
        constexpr _Size_t _Emplace_one(_Fn _Func) {
            _STL_INTERNAL_CHECK(!this->_Full());

            const auto [_Free_pos, _Free_len] = _First_free_range();
            _STL_INTERNAL_CHECK(_Free_len > 0);

            _Emplace_guard _Guard{_Data + _Free_pos};
            _Func(_Data + _Free_pos);
            _Guard._Pos = nullptr;

            _Empty._Reset(_Free_pos);
            if (_Free_len != 1) {
                _Empty._Set(_Free_pos + 1uz);
                this->_Data[_Free_pos + 1]._Skip = this->_Data[_Free_pos + _Free_len - 1]._Skip =
                    static_cast<_Size_t>(_Free_len - 1);
            }
            ++_Size;

            return _Free_pos;
        }

        // n > 0
        template <class _Fn>
        constexpr void _Emplace_n(_Size_t _Count, _Fn _Func) {
            _STL_INTERNAL_CHECK(_Size + _Count <= _Capacity);

            _STL_INTERNAL_CHECK(_Count > 0);
            do {
                const auto [_Free_pos, _Free_len] = _First_free_range();
                const auto _Cnt                   = (_STD min) (_Count, _Free_len);
                this->_Emplace_n_at(_Free_pos, _Cnt, _STD _Pass_fn(_Func));
                _Count -= _Cnt;
            } while (_Count != 0);
        }

        // n > 0
        template <class _Fn>
        constexpr void _Emplace_n_at(_Size_t _Pos, _Size_t _Count, _Fn _Func) {
            _STL_INTERNAL_CHECK(_Pos < _Capacity);
            _STL_INTERNAL_CHECK(_Count > 0);

            const auto _Length = this->_Data[_Pos]._Skip;
            _STL_INTERNAL_CHECK(_Length >= _Count);
            _STL_INTERNAL_CHECK(_Length == this->_Data[_Pos + _Length - 1]._Skip);
            _Emplace_guard _Head_guard{_Data + _Pos};
            if (_Length == _Count) {
                _Emplace_guard _Tail_guard{_Data + _Pos + _Length - 1};
                _Func(_Data + _Pos, _Count);
                _Tail_guard._Pos = nullptr;
            } else {
                _Func(_Data + _Pos, _Count);
            }
            _Head_guard._Pos = nullptr;

            _Empty._Reset(_Pos, _Pos + _Count + 0uz);
            _Size += _Count;
            if (_Length != _Count) {
                _Empty._Set(_Pos + _Count + 0uz);
                this->_Data[_Pos + _Count]._Skip = this->_Data[_Pos + _Length - 1]._Skip =
                    static_cast<_Size_t>(_Length - _Count);
            }
        }

        constexpr void _Mark_erased(_Size_t _Pos) noexcept {
            _STL_INTERNAL_CHECK(!_Empty[_Pos]);
            _STL_INTERNAL_CHECK(_Size > 1);

            _Empty._Set(_Pos);

            const bool _Left_erased  = _Pos != 0 && _Empty[_Pos - 1uz];
            const bool _Right_erased = _Empty[_Pos + 1uz];

            const auto _Left_skip  = _Left_erased ? this->_Data[_Pos - 1]._Skip : _Size_t{0};
            const auto _Right_skip = _Right_erased ? this->_Data[_Pos + 1]._Skip : _Size_t{0};
            const auto _Left_idx   = _Pos - _Left_skip;
            const auto _Right_idx  = _Pos + _Right_skip;

            this->_Data[_Left_idx]._Skip = this->_Data[_Right_idx]._Skip =
                static_cast<_Size_t>(_Left_skip + 1 + _Right_skip);

            --_Size;
        }

        constexpr void _Mark_erased(_Size_t _First, _Size_t _Last, _Size_t _Elem_count) noexcept {
            _STL_INTERNAL_CHECK(_First < _Last && _Last <= _Capacity);
            _STL_INTERNAL_CHECK(_Size > _Elem_count);
            _STL_INTERNAL_CHECK(!_Empty[_First] && !_Empty[_Last]); // _Empty[_Capacity] is false

            _Empty._Set(_First);
            _Empty._Set(_Last - 1uz);

            const bool _Left_erased = _First != 0 && _Empty[_First - 1uz];
            const auto _Left_skip   = _Left_erased ? this->_Data[_First - 1]._Skip : _Size_t{0};
            const auto _Left_idx    = _First - _Left_skip;

            this->_Data[_Left_idx]._Skip = this->_Data[_Last - 1]._Skip = static_cast<_Size_t>(_Last - _Left_idx);
            _Size -= _Elem_count;
        }
    };
};

template <class _BlockT, class _BlockPtr>
struct _Hive_block_iterator_provider {
    template <_BlockPtr _BlockT::* _Next, _BlockPtr _BlockT::* _Prev>
