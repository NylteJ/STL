template <size_t _ValueSize>
using _Hive_skipfield_t = conditional_t<_ValueSize >= 4, uint16_t, uint8_t>;

template <class _SkipT>
constexpr _SkipT _Hive_skipfield_zero = 0; // for sentinel block

template <class _ValueT>
struct _Hive_union_provider {
    union _Union {
        struct _Free_list_node {
            using _Index = _Hive_skipfield_t<sizeof(_ValueT)>;
            _Index _Prev;
            _Index _Next;
        };

        _ValueT _Value;
        _Free_list_node _Free;

        ~_Union() = delete; // FIXME: unnecessary in C++26
    };
};

template <class _ValueT, class _HiveSizeT, class _AnyPtrT>
struct _Hive_block_provider {
    struct _Block : _Hive_block_base {
        using _Union         = _Hive_union_provider<_ValueT>::_Union;
        using _Union_ptr     = _Rebind_pointer_t<_AnyPtrT, _Union>;
        using _Block_ptr     = _Rebind_pointer_t<_AnyPtrT, _Block>;
        using _Skipfield_t   = _Hive_skipfield_t<sizeof(_ValueT)>;
        using _Skipfield_ptr = _Rebind_pointer_t<_AnyPtrT, _Skipfield_t>;
        using _Order_id_t    = _HiveSizeT;
        using _Size_t        = _Skipfield_t;

        static constexpr auto _Free_npos = _STD _Max_limit<_Size_t>();

        _Block_ptr _Next; // active blocks list and reserved blocks list
        _Block_ptr _Prev; // active blocks list

        // blocks with unused memory (due to element erasure or unused tail space)
        _Block_ptr _Next_nonfull;
        _Block_ptr _Prev_nonfull;

        _Union_ptr _Data;

        _Skipfield_ptr _Skip; // has one extra 0 past the end (i.e. _Skip[_Capacity] == 0)

        _Size_t _Capacity;
        _Size_t _Size;

        _Size_t _First_free; // first index of the first skipblock in the free list
        // Note: The free list node data is stored at the end of the skipblock, but _First_free references the beginning
        // of the skipblock. This way, the insertion position is directly provided by _First_free, and the node data
        // only needs to be updated once per skipblock when it is filled.

        _Order_id_t _Order_id;

        _NODISCARD static constexpr _Block _Sentinel(_Block& _Blk) noexcept {
            const auto _Ptr = pointer_traits<_Block_ptr>::pointer_to(_Blk);
            return {
                ._Next         = _Ptr,
                ._Prev         = _Ptr,
                ._Next_nonfull = _Ptr,
                ._Prev_nonfull = _Ptr,
                ._Data         = nullptr,
                ._Skip         = pointer_traits<_Skipfield_ptr>::pointer_to(
                    const_cast<_Skipfield_t&>(_Hive_skipfield_zero<_Skipfield_t>)),
                ._Capacity   = 0,
                ._Size       = 0,
                ._First_free = 0,
                ._Order_id   = _STD _Max_limit<_Order_id_t>(),
            };
        }

        _NODISCARD constexpr bool _Is_sent() const noexcept {
            return _Order_id == _STD _Max_limit<_Order_id_t>();
        }

        _NODISCARD constexpr _Size_t _First_element() const noexcept {
            return _Skip[0];
        }

        _NODISCARD constexpr bool _Full() const noexcept {
            _STL_INTERNAL_CHECK(_Size <= _Capacity);
            return _Size == _Capacity;
        }

        // first + [0, second)
        _NODISCARD constexpr pair<_Size_t, _Size_t> _First_free_range() {
            _STL_INTERNAL_CHECK(!_Full());
            _STL_INTERNAL_CHECK(_First_free < _Capacity);
            _STL_INTERNAL_CHECK(_Skip[_First_free] > 0);
            return {_First_free, _Skip[_First_free]};
        }

        // Init uninitialized block, except order id and IDL=2 data.
        constexpr void _Init(_Size_t _Element_count) noexcept {
            _Size = _Element_count;
            if (!_Full()) {
                _First_free                = _Size;
                _Data[_Capacity - 1]._Free = {_Free_npos, _Free_npos};
                _STD _Uninitialized_value_construct_n_unchecked1(_Skip, _Size);
                _Skip[_Capacity] = 0;
                _Skip[_Size] = _Skip[_Capacity - 1] = static_cast<_Size_t>(_Capacity - _Size);
            } else {
                _STD _Uninitialized_value_construct_n_unchecked1(_Skip, _Capacity + 1);
            }
        }

        struct _Emplace_guard {
            _Union_ptr _Pos;
            typename _Union::_Free_list_node _Node;
            constexpr explicit _Emplace_guard(_Union_ptr _Pos_) : _Pos(_Pos_), _Node(_Pos->_Free) {}
            constexpr ~_Emplace_guard() noexcept {
                if (_Pos != nullptr) {
                    _Pos->_Free = _Node;
                }
            }
        };

        // Does not modify the nonfull blocks list. Returns the index of the new element.
        // provides strong guarantee
        template <class _Fn>
        constexpr _Size_t _Emplace_one(_Fn _Func) {
            _STL_INTERNAL_CHECK(!_Full());

            const auto [_Free_pos, _Free_len] = _First_free_range();
            _STL_INTERNAL_CHECK(_Free_len > 0);
            if (_Free_len != 1) { // skipblock not exhausted, just shrink it
                _Func(_Data + _Free_pos);
                _Skip[_Free_pos]     = 0;
                _Skip[_Free_pos + 1] = _Skip[_Free_pos + _Free_len - 1] = static_cast<_Size_t>(_Free_len - 1);
                ++_First_free;
            } else { // skipblock exhausted, update free list
                _STL_INTERNAL_CHECK(_Data[_Free_pos]._Free._Prev == _Free_npos);
                const auto _Next_free = _Data[_Free_pos]._Free._Next;

                _Emplace_guard _Guard{_Data + _Free_pos};
                _Func(_Data + _Free_pos);
                _Guard._Pos = nullptr;

                if (_Next_free != _Free_npos) {
                    _Data[_Next_free]._Free._Prev = _Free_npos;
                    _First_free                   = static_cast<_Size_t>(_Next_free + 1 - _Skip[_Next_free]);
                }
                _Skip[_Free_pos] = 0;
            }
            ++_Size;

            return _Free_pos;
        }

        // n > 0
        template <class _Fn>
        constexpr void _Emplace_n(_Size_t _Count, _Fn _Func) {
            _STL_INTERNAL_CHECK(_Size + _Count <= _Capacity);

            _STL_INTERNAL_CHECK(_Count > 0);
            do {
                const auto [_Free_pos, _Free_len] = _First_free_range();
                const auto _Cnt                   = (_STD min) (_Count, _Free_len);
                _Emplace_n_at(_Free_pos, _Cnt, _STD _Pass_fn(_Func));
                _Count -= _Cnt;
            } while (_Count != 0);
        }

        // n > 0
        template <class _Fn>
        constexpr void _Emplace_n_at(_Size_t _Pos, _Size_t _Count, _Fn _Func) {
            _STL_INTERNAL_CHECK(_Pos < _Capacity);
            _STL_INTERNAL_CHECK(_Count > 0);

            const auto _Length = _Skip[_Pos];
            _STL_INTERNAL_CHECK(_Length >= _Count);
            _STL_INTERNAL_CHECK(_Length == _Skip[_Pos + _Length - 1]);
            if (_Count != _Length) { // skipblock not exhausted, just shrink it
                _Func(_Data + _Pos, _Count);

                _RANGES fill_n(_STD to_address(_Skip + _Pos), _Count, _Size_t{0});
                _Size += _Count;

                _Skip[_Pos + _Count] = _Skip[_Pos + _Length - 1] = static_cast<_Size_t>(_Length - _Count);
                if (_Pos == _First_free) {
                    _First_free = static_cast<_Size_t>(_Pos + _Count);
                }
            } else { // skipblock exhausted, update free list
                const auto _Node_pos  = _Pos + _Length - 1;
                const auto _Node_data = _Data[_Node_pos]._Free;

                _Emplace_guard _Guard{_Data + _Node_pos};
                _Func(_Data + _Pos, _Count);
                _Guard._Pos = nullptr;

                _RANGES fill_n(_STD to_address(_Skip + _Pos), _Count, _Size_t{0});
                _Size += _Count;

                _Remove_free_node(_Node_data._Prev, _Node_data._Next);
            }
        }

        constexpr void _Mark_erased(_Size_t _Pos) noexcept {
            _STL_INTERNAL_CHECK(_Skip[_Pos] == 0);
            _STL_INTERNAL_CHECK(_Size > 1);

            const auto _Left_skip    = _Pos != 0 ? _Skip[_Pos - 1] : _Size_t{0};
            const auto _Right_skip   = _Skip[_Pos + 1];
            const bool _Left_erased  = _Left_skip != 0;
            const bool _Right_erased = _Right_skip != 0;
            const auto _Left_idx     = static_cast<_Size_t>(_Pos - _Left_skip);
            const auto _Right_idx    = static_cast<_Size_t>(_Pos + _Right_skip);
            const auto _New_skip     = static_cast<_Size_t>(_Left_skip + 1 + _Right_skip);

            _Skip[_Left_idx] = _Skip[_Right_idx] = _New_skip;

            if (_Left_erased) {
                if (_Right_erased) {
                    _Remove_free_node(_Pos - 1u);
                } else {
                    const auto _Free_node = _Data[_Pos - 1]._Free;

                    if (_Free_node._Prev != _Free_npos) {
                        _Data[_Free_node._Prev]._Free._Next = _Pos;
                    }

                    if (_Free_node._Next != _Free_npos) {
                        _Data[_Free_node._Next]._Free._Prev = _Pos;
                    }
                    _Data[_Pos]._Free = _Free_node;
                }
            }

            if (_Right_erased) {
                if (_First_free == _Pos + 1) {
                    _First_free = _Left_idx;
                }
            }

            if (!_Left_erased && !_Right_erased) {
                _Data[_Pos]._Free._Prev = _Free_npos;
                if (!_Full()) {
                    const auto _Next_node_pos         = static_cast<_Size_t>(_First_free + _Skip[_First_free] - 1);
                    _Data[_Pos]._Free._Next           = _Next_node_pos;
                    _Data[_Next_node_pos]._Free._Prev = _Pos;
                } else {
                    _Data[_Pos]._Free._Next = _Free_npos;
                }
                _First_free = _Left_idx;
            }

            --_Size;
        }

        constexpr void _Mark_erased(_Size_t _First, _Size_t _Last, _Size_t _Elem_count) noexcept {
            _STL_INTERNAL_CHECK(_First < _Last && _Last <= _Capacity);
            _STL_INTERNAL_CHECK(_Size > _Elem_count);
            _STL_INTERNAL_CHECK(_Skip[_First] == 0 && _Skip[_Last] == 0);

            const auto _Left_skip   = _First != 0 ? _Skip[_First - 1] : _Size_t{0};
            const bool _Left_erased = _Left_skip != 0;
            const auto _Left_idx    = static_cast<_Size_t>(_First - _Left_skip);
            const auto _Right_idx   = static_cast<_Size_t>(_Last - 1);

            const auto _Dist = static_cast<_Size_t>(_Last - _First);

            bool _All_free_nodes_removed = false;
            if (_Dist != _Elem_count) { // there are skipblocks in the range, update free list
                _STL_INTERNAL_CHECK(!_Full());
                _All_free_nodes_removed = true;
                for (auto _Tail = static_cast<_Size_t>(_First_free + _Skip[_First_free] - 1);;) {
                    const auto _Next_tail = _Data[_Tail]._Free._Next;

                    const auto _Head = static_cast<_Size_t>(_Tail - _Skip[_Tail] + 1);
                    // [_Head, _Tail] is empty
                    if (_First <= _Head && _Tail < _Last) {
                        _Remove_free_node(_Tail);
                    } else {
                        _All_free_nodes_removed = false;
                    }

                    if (_Next_tail == _Free_npos) {
                        break;
                    }
                    _Tail = _Next_tail;
                }
            }

            if (_Left_erased) {
                const auto _Left_free = _Data[_First - 1]._Free;

                if (_Left_free._Prev != _Free_npos) {
                    _Data[_Left_free._Prev]._Free._Next = _Right_idx;
                }

                if (_Left_free._Next != _Free_npos) {
                    _Data[_Left_free._Next]._Free._Prev = _Right_idx;
                }
                _Data[_Right_idx]._Free = _Left_free;
            } else {
                _Data[_Right_idx]._Free._Prev = _Free_npos;
                if (!_All_free_nodes_removed && !_Full()) {
                    const auto _Next_node         = static_cast<_Size_t>(_First_free + _Skip[_First_free] - 1);
                    _Data[_Right_idx]._Free._Next = _Next_node;
                    _Data[_Next_node]._Free._Prev = _Right_idx;
                } else {
                    _Data[_Right_idx]._Free._Next = _Free_npos;
                }
                _First_free = _Left_idx;
            }

            _Skip[_Left_idx] = _Skip[_Right_idx] = static_cast<_Size_t>(_Last - _Left_idx);
            _Size -= _Elem_count;
        }

    private:
        constexpr void _Remove_free_node(_Size_t _Prev_idx, _Size_t _Next_idx) noexcept {
            if (_Prev_idx != _Free_npos) {
                if (_Next_idx != _Free_npos) {
                    _Data[_Prev_idx]._Free._Next = _Next_idx;
                    _Data[_Next_idx]._Free._Prev = _Prev_idx;
                } else {
                    _Data[_Prev_idx]._Free._Next = _Free_npos;
                }
            } else {
                if (_Next_idx != _Free_npos) {
                    _Data[_Next_idx]._Free._Prev = _Free_npos;
                    _First_free                  = static_cast<_Size_t>(_Next_idx + 1 - _Skip[_Next_idx]);
                }
            }
        }
        constexpr void _Remove_free_node(_Size_t _Idx) noexcept {
            const auto _Prev_idx = _Data[_Idx]._Free._Prev;
            const auto _Next_idx = _Data[_Idx]._Free._Next;
            _Remove_free_node(_Prev_idx, _Next_idx);
        }
    };
};

template <class _BlockT, class _BlockPtr>
struct _Hive_block_iterators_provider {
    template <_BlockPtr _BlockT::* _Next, _BlockPtr _BlockT::* _Prev>
    struct _Block_iter {
        using _Block     = _BlockT;
        using _Block_ptr = _BlockPtr;

        _STL_INTERNAL_STATIC_ASSERT(_Next != nullptr);
        using iterator_concept  = conditional_t<_Prev != nullptr, bidirectional_iterator_tag, forward_iterator_tag>;
        using iterator_category = iterator_concept;
        using value_type        = _Block;
        using pointer           = _Block_ptr;
        using difference_type   = iter_difference_t<pointer>;
        using reference         = value_type&;

        constexpr explicit _Block_iter(_Block_ptr _Block) noexcept : _Blk(_Block) {}
        constexpr explicit _Block_iter(nullptr_t = nullptr) noexcept : _Blk(nullptr) {}

        _NODISCARD constexpr _Block_ptr _Ptr() const noexcept {
            return _Blk;
        }
        _NODISCARD /* implicit */ constexpr operator _Block_ptr() const noexcept {
            return _Blk;
        }

        constexpr explicit operator bool() const noexcept {
            return static_cast<bool>(_Blk);
        }

        constexpr _Block& operator*() const noexcept {
            return *_Blk;
        }
        constexpr _Block_ptr operator->() const noexcept {
            return _Blk;
        }

        constexpr _Block_iter& operator++() noexcept {
            _Blk = (*_Blk).*_Next;
            return *this;
        }
        constexpr _Block_iter operator++(int) noexcept {
            const auto _Temp = *this;
            ++*this;
            return _Temp;
        }
        constexpr _Block_iter& operator--() noexcept {
            _Blk = (*_Blk).*_Prev;
            return *this;
        }
        constexpr _Block_iter operator--(int) noexcept {
            const auto _Temp = *this;
            --*this;
            return _Temp;
        }

        constexpr bool operator==(const _Block_iter&) const = default;
        constexpr bool operator==(_Block_ptr _Other) const {
            return _Blk == _Other;
        }
        constexpr bool operator==(nullptr_t) const {
            return _Blk == nullptr;
        }

        constexpr void _Swap(_Block_iter& _Other) {
            swap(_Blk, _Other._Blk); // intentional ADL
        }

        constexpr void _Remove_from_list() const noexcept {
            const auto _Blk_next = (*_Blk).*_Next;
            const auto _Blk_prev = (*_Blk).*_Prev;
            (*_Blk_next).*_Prev  = _Blk_prev;
            (*_Blk_prev).*_Next  = _Blk_next;
#ifdef _ENABLE_STL_INTERNAL_CHECK
            (*_Blk).*_Next = (*_Blk).*_Prev = nullptr;
#endif // defined(_ENABLE_STL_INTERNAL_CHECK)
        }

        constexpr void _Insert_after(_Block_ptr _Other) const noexcept {
            const auto _Blk_next = (*_Blk).*_Next;
            (*_Other).*_Next     = _Blk_next;
            (*_Other).*_Prev     = _Blk;
            (*_Blk_next).*_Prev  = _Other;
            (*_Blk).*_Next       = _Other;
        }

        constexpr void _Insert_before(_Block_ptr _Other) const noexcept {
            const auto _Blk_prev = (*_Blk).*_Prev;
            (*_Other).*_Prev     = _Blk_prev;
            (*_Other).*_Next     = _Blk;
            (*_Blk_prev).*_Next  = _Other;
            (*_Blk).*_Prev       = _Other;
        }

        constexpr void _Splice_before(_Block_ptr _Sent) const noexcept {
            const auto _Blk_prev  = (*_Blk).*_Prev;
            const auto _Sent_next = (*_Sent).*_Next;
            (*_Blk_prev).*_Next   = _Sent_next;
            (*_Sent_next).*_Prev  = _Blk_prev;
            const auto _Sent_prev = (*_Sent).*_Prev;
            (*_Blk).*_Prev        = _Sent_prev;
            (*_Sent_prev).*_Next  = _Blk;
            (*_Sent).*_Next = (*_Sent).*_Prev = _Sent;
        }

    private:
        _Block_ptr _Blk;
    };

    using _Active_iterator   = _Block_iter<&_BlockT::_Next, &_BlockT::_Prev>;
    using _Nonfull_iterator  = _Block_iter<&_BlockT::_Next_nonfull, &_BlockT::_Prev_nonfull>;
    using _Reserved_iterator = _Block_iter<&_BlockT::_Next, nullptr>;
};

