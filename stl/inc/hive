            (*_Blk).*_Next = (*_Blk).*_Prev = nullptr;
#endif // defined(_ENABLE_STL_INTERNAL_CHECK)
        }

        constexpr void _Insert_after(_Block_ptr _Other) const noexcept {
            const auto _Blk_next = (*_Blk).*_Next;
            (*_Other).*_Next     = _Blk_next;
            (*_Other).*_Prev     = _Blk;
            (*_Blk_next).*_Prev  = _Other;
            (*_Blk).*_Next       = _Other;
        }

        constexpr void _Insert_before(_Block_ptr _Other) const noexcept {
            const auto _Blk_prev = (*_Blk).*_Prev;
            (*_Other).*_Prev     = _Blk_prev;
            (*_Other).*_Next     = _Blk;
            (*_Blk_prev).*_Next  = _Other;
            (*_Blk).*_Prev       = _Other;
        }

        constexpr void _Splice_before(_Block_ptr _Sent) const noexcept {
            const auto _Blk_prev  = (*_Blk).*_Prev;
            const auto _Sent_next = (*_Sent).*_Next;
            (*_Blk_prev).*_Next   = _Sent_next;
            (*_Sent_next).*_Prev  = _Blk_prev;
            const auto _Sent_prev = (*_Sent).*_Prev;
            (*_Blk).*_Prev        = _Sent_prev;
            (*_Sent_prev).*_Next  = _Blk;
            (*_Sent).*_Next = (*_Sent).*_Prev = _Sent;
        }

    private:
        _Block_ptr _Blk;
    };

    using _Active_iterator   = _Block_iter<&_BlockT::_Next, &_BlockT::_Prev>;
    using _Nonfull_iterator  = _Block_iter<&_BlockT::_Next_nonfull, &_BlockT::_Prev_nonfull>;
    using _Reserved_iterator = _Block_iter<&_BlockT::_Next, nullptr>;
};

