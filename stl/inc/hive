template <size_t _ValueSize>
using _Hive_skipfield_t = conditional_t<_ValueSize >= 4, uint16_t, uint8_t>;

template <class _SkipT>
constexpr _SkipT _Hive_skipfield_zero = 0; // for sentinel block

template <class _ValueT>
struct _Hive_union_provider {
    union _Union {
        struct _Free_list_node {
            using _Index = _Hive_skipfield_t<sizeof(_ValueT)>;
            _Index _Prev;
            _Index _Next;
        };

        _ValueT _Value;
        _Free_list_node _Free;

        ~_Union() = delete; // FIXME: unnecessary in C++26
    };
};

template <class _ValueT, class _HiveSizeT, class _AnyPtrT>
struct _Hive_block_provider {
    struct _Block : _Hive_block_base {
        using _Union         = _Hive_union_provider<_ValueT>::_Union;
        using _Union_ptr     = _Rebind_pointer_t<_AnyPtrT, _Union>;
        using _Block_ptr     = _Rebind_pointer_t<_AnyPtrT, _Block>;
        using _Skipfield_t   = _Hive_skipfield_t<sizeof(_ValueT)>;
        using _Skipfield_ptr = _Rebind_pointer_t<_AnyPtrT, _Skipfield_t>;
        using _Order_id_t    = _HiveSizeT;
        using _Size_t        = _Skipfield_t;

        static constexpr auto _Free_npos = _STD _Max_limit<_Size_t>();

        _Block_ptr _Next; // active blocks list and reserved blocks list
        _Block_ptr _Prev; // active blocks list

        // blocks with unused memory (due to element erasure or unused tail space)
        _Block_ptr _Next_nonfull;
        _Block_ptr _Prev_nonfull;

        _Union_ptr _Data;

        _Skipfield_ptr _Skip; // has one extra 0 past the end (i.e. _Skip[_Capacity] == 0)

        _Size_t _Capacity;
        _Size_t _Size;

        _Size_t _First_free; // first index of the first skipblock in the free list
        // Note: The free list node data is stored at the end of the skipblock, but _First_free references the beginning
        // of the skipblock. This way, the insertion position is directly provided by _First_free, and the node data
        // only needs to be updated once per skipblock when it is filled.

        _Order_id_t _Order_id;

        _NODISCARD static constexpr _Block _Sentinel(_Block& _Blk) noexcept {
            const auto _Ptr = pointer_traits<_Block_ptr>::pointer_to(_Blk);
            return {
                ._Next         = _Ptr,
                ._Prev         = _Ptr,
                ._Next_nonfull = _Ptr,
                ._Prev_nonfull = _Ptr,
                ._Data         = nullptr,
                ._Skip         = pointer_traits<_Skipfield_ptr>::pointer_to(
                    const_cast<_Skipfield_t&>(_Hive_skipfield_zero<_Skipfield_t>)),
                ._Capacity   = 0,
                ._Size       = 0,
                ._First_free = 0,
                ._Order_id   = _STD _Max_limit<_Order_id_t>(),
            };
        }

        _NODISCARD constexpr bool _Is_sent() const noexcept {
            return _Order_id == _STD _Max_limit<_Order_id_t>();
        }

        _NODISCARD constexpr _Size_t _First_element() const noexcept {
            return _Skip[0];
        }

        _NODISCARD constexpr bool _Full() const noexcept {
            _STL_INTERNAL_CHECK(_Size <= _Capacity);
            return _Size == _Capacity;
        }

        // first + [0, second)
        _NODISCARD constexpr pair<_Size_t, _Size_t> _First_free_range() {
            _STL_INTERNAL_CHECK(!_Full());
            _STL_INTERNAL_CHECK(_First_free < _Capacity);
            _STL_INTERNAL_CHECK(_Skip[_First_free] > 0);
            return {_First_free, _Skip[_First_free]};
        }

        // Init uninitialized block, except order id and IDL=2 data.
        constexpr void _Init(_Size_t _Element_count) noexcept {
            _Size = _Element_count;
            if (!_Full()) {
                _First_free                = _Size;
                _Data[_Capacity - 1]._Free = {_Free_npos, _Free_npos};
                _STD _Uninitialized_value_construct_n_unchecked1(_Skip, _Size);
                _Skip[_Capacity] = 0;
                _Skip[_Size] = _Skip[_Capacity - 1] = static_cast<_Size_t>(_Capacity - _Size);
            } else {
                _STD _Uninitialized_value_construct_n_unchecked1(_Skip, _Capacity + 1);
            }
        }
    };
};

template <class _BlockT, class _BlockPtr>
struct _Hive_block_iterators_provider {
    template <_BlockPtr _BlockT::* _Next, _BlockPtr _BlockT::* _Prev>
    struct _Block_iter {
        using _Block     = _BlockT;
        using _Block_ptr = _BlockPtr;

        _STL_INTERNAL_STATIC_ASSERT(_Next != nullptr);
        using iterator_concept  = conditional_t<_Prev != nullptr, bidirectional_iterator_tag, forward_iterator_tag>;
        using iterator_category = iterator_concept;
        using value_type        = _Block;
        using pointer           = _Block_ptr;
        using difference_type   = iter_difference_t<pointer>;
        using reference         = value_type&;

        constexpr explicit _Block_iter(_Block_ptr _Block) noexcept : _Blk(_Block) {}
        constexpr explicit _Block_iter(nullptr_t = nullptr) noexcept : _Blk(nullptr) {}

        _NODISCARD constexpr _Block_ptr _Ptr() const noexcept {
            return _Blk;
        }
        _NODISCARD /* implicit */ constexpr operator _Block_ptr() const noexcept {
            return _Blk;
        }

        constexpr explicit operator bool() const noexcept {
            return static_cast<bool>(_Blk);
        }

        constexpr _Block& operator*() const noexcept {
            return *_Blk;
        }
        constexpr _Block_ptr operator->() const noexcept {
            return _Blk;
        }

        constexpr _Block_iter& operator++() noexcept {
            _Blk = (*_Blk).*_Next;
            return *this;
        }
        constexpr _Block_iter operator++(int) noexcept {
            const auto _Temp = *this;
            ++*this;
            return _Temp;
        }
        constexpr _Block_iter& operator--() noexcept {
            _Blk = (*_Blk).*_Prev;
            return *this;
        }
        constexpr _Block_iter operator--(int) noexcept {
            const auto _Temp = *this;
            --*this;
            return _Temp;
        }

        constexpr bool operator==(const _Block_iter&) const = default;
        constexpr bool operator==(_Block_ptr _Other) const {
            return _Blk == _Other;
        }
        constexpr bool operator==(nullptr_t) const {
            return _Blk == nullptr;
        }

        constexpr void _Swap(_Block_iter& _Other) {
            swap(_Blk, _Other._Blk); // intentional ADL
        }

        constexpr void _Remove_from_list() const noexcept {
            const auto _Blk_next = (*_Blk).*_Next;
            const auto _Blk_prev = (*_Blk).*_Prev;
            (*_Blk_next).*_Prev  = _Blk_prev;
            (*_Blk_prev).*_Next  = _Blk_next;
#ifdef _ENABLE_STL_INTERNAL_CHECK
            (*_Blk).*_Next = (*_Blk).*_Prev = nullptr;
#endif // defined(_ENABLE_STL_INTERNAL_CHECK)
        }

        constexpr void _Insert_after(_Block_ptr _Other) const noexcept {
            const auto _Blk_next = (*_Blk).*_Next;
            (*_Other).*_Next     = _Blk_next;
            (*_Other).*_Prev     = _Blk;
            (*_Blk_next).*_Prev  = _Other;
            (*_Blk).*_Next       = _Other;
        }

        constexpr void _Insert_before(_Block_ptr _Other) const noexcept {
            const auto _Blk_prev = (*_Blk).*_Prev;
            (*_Other).*_Prev     = _Blk_prev;
            (*_Other).*_Next     = _Blk;
            (*_Blk_prev).*_Next  = _Other;
            (*_Blk).*_Prev       = _Other;
        }

        constexpr void _Splice_before(_Block_ptr _Sent) const noexcept {
            const auto _Blk_prev  = (*_Blk).*_Prev;
            const auto _Sent_next = (*_Sent).*_Next;
            (*_Blk_prev).*_Next   = _Sent_next;
            (*_Sent_next).*_Prev  = _Blk_prev;
            const auto _Sent_prev = (*_Sent).*_Prev;
            (*_Blk).*_Prev        = _Sent_prev;
            (*_Sent_prev).*_Next  = _Blk;
            (*_Sent).*_Next = (*_Sent).*_Prev = _Sent;
        }

    private:
        _Block_ptr _Blk;
    };

    using _Active_iterator   = _Block_iter<&_BlockT::_Next, &_BlockT::_Prev>;
    using _Nonfull_iterator  = _Block_iter<&_BlockT::_Next_nonfull, &_BlockT::_Prev_nonfull>;
    using _Reserved_iterator = _Block_iter<&_BlockT::_Next, nullptr>;
};

// [hive], class template hive
_EXPORT_STD template <class _Ty, class _Alloc = allocator<_Ty>>
class hive;

template <class _Myhive>
struct _Hive_iterators_provider {
    using _Block        = _Myhive::_Block;
    using _Block_ptr    = _Myhive::_Block_ptr;
    using _Block_size_t = _Myhive::_Block_size_t;

    using _Block_iter_active = _Myhive::_Block_iter_active;

    static constexpr auto _Sentinel_ord_id = _STD _Max_limit<typename _Myhive::size_type>();

    // also used in IDL as common base class
    template <class _Base = _Hive_iterator_base0>
    class _Unchecked_local_iter : public _Base {
    public:
        using iterator_category = bidirectional_iterator_tag;
        using value_type        = _Myhive::value_type;
        using difference_type   = _Myhive::difference_type;
        using pointer           = _Myhive::pointer;
        using reference         = value_type&;

        constexpr _Unchecked_local_iter() noexcept = default;

        _NODISCARD constexpr reference operator*() const noexcept {
            return _Blk->_Data[_Index]._Value;
        }
        _NODISCARD constexpr pointer operator->() const noexcept {
            return pointer_traits<pointer>::pointer_to(**this);
        }

        constexpr _Unchecked_local_iter& operator++() noexcept {
            _STL_INTERNAL_CHECK(_Index < _Blk->_Capacity);
            const _Block_size_t _Delta = _Blk->_Skip[_Index + 1] + 1u;
            _STL_INTERNAL_CHECK(_Delta <= _Blk->_Capacity && _Index <= _Blk->_Capacity - _Delta);
            _Index += _Delta;
            return *this;
        }
        constexpr _Unchecked_local_iter operator++(int) noexcept {
            const auto _Temp = *this;
            ++*this;
            return _Temp;
        }
        constexpr _Unchecked_local_iter& operator--() noexcept {
            _STL_INTERNAL_CHECK(_Index > 0);
            const _Block_size_t _Delta = _Blk->_Skip[_Index - 1] + 1u;
            _STL_INTERNAL_CHECK(_Index >= _Delta);
            _Index -= _Delta;
            return *this;
        }
        constexpr _Unchecked_local_iter operator--(int) noexcept {
            const auto _Temp = *this;
            --*this;
            return _Temp;
        }

        _NODISCARD constexpr bool operator==(const _Unchecked_local_iter& _Right) const noexcept {
            _STL_INTERNAL_CHECK(_Blk == _Right._Blk);
            return _Index == _Right._Index;
        }

    protected:
        template <class _Ty, class _Alloc>
        friend class hive;
        template <class _ValueType, class _SizeType, class _DifferenceType, class _Pointer, class _ConstPointer>
        friend struct _Hive_val_provider;

        friend _Hive_iterators_provider;

        constexpr _Unchecked_local_iter(_Block_ptr _Blk_, _Block_size_t _Index_) : _Blk(_Blk_), _Index(_Index_) {}

        _Block_iter_active _Blk{nullptr};
        _Block_size_t _Index = 0;
    };

    template <bool _Const, class _Base = _Hive_iterator_base0>
    class _Unchecked_iter : public _Unchecked_local_iter<_Base> {
        using _Mybase = _Unchecked_local_iter<_Base>;
        using _Mybase::_Blk, _Mybase::_Index;

    public:
        using typename _Mybase::value_type;
        using pointer   = conditional_t<_Const, typename _Myhive::const_pointer, typename _Myhive::pointer>;
        using reference = conditional_t<_Const, const value_type&, value_type&>;

        constexpr _Unchecked_iter() noexcept                       = default;
        constexpr _Unchecked_iter(const _Unchecked_iter&) noexcept = default;

        /* implicit */ constexpr _Unchecked_iter(const _Unchecked_iter<false, _Base>& _Mutable_iter) noexcept
            requires _Const
            : _Mybase(_Mutable_iter) {}

        constexpr _Unchecked_iter& operator=(const _Unchecked_iter&) noexcept = default;

        _NODISCARD constexpr reference operator*() const noexcept {
            return _Mybase::operator*();
        }
        _NODISCARD constexpr pointer operator->() const noexcept {
            return pointer_traits<pointer>::pointer_to(**this);
        }

        constexpr _Unchecked_iter& operator++() noexcept {
            _Mybase::operator++();
            if (_Index == _Blk->_Capacity) {
                ++_Blk;
                _Index = _Blk->_First_element();
                this->_Adopt(_STD to_address(_Blk._Ptr()));
            }
            return *this;
        }
        constexpr _Unchecked_iter operator++(int) noexcept {
            const auto _Temp = *this;
            ++*this;
            return _Temp;
        }

        constexpr _Unchecked_iter& operator--() noexcept {
            if (_Index == _Blk->_First_element()) {
                --_Blk;
                _Index = _Blk->_Capacity;
                this->_Adopt(_STD to_address(_Blk._Ptr()));
            }
            _Mybase::operator--();
            return *this;
        }
        constexpr _Unchecked_iter operator--(int) noexcept {
            const auto _Temp = *this;
            --*this;
            return _Temp;
        }

        template <bool _RightConst>
        _NODISCARD constexpr strong_ordering operator<=>(
            const _Unchecked_iter<_RightConst, _Base>& _Right) const noexcept {
            if (_Blk == _Right._Blk) {
                return _Index <=> _Right._Index;
            }
            _STL_INTERNAL_CHECK(_Blk->_Order_id != _Right._Blk->_Order_id);
            return _Blk->_Order_id < _Right._Blk->_Order_id ? strong_ordering::less : strong_ordering::greater;
        }

        template <bool _RightConst>
        _NODISCARD constexpr bool operator==(const _Unchecked_iter<_RightConst, _Base>& _Right) const noexcept {
            return _Blk == _Right._Blk && _Index == _Right._Index;
        }

    protected:
        template <class _Ty, class _Alloc>
        friend class hive;

        friend _Hive_iterators_provider;

        constexpr _Unchecked_iter(_Block_iter_active _Blk_, _Block_size_t _Index_) : _Mybase(_Blk_, _Index_) {}

        _NODISCARD constexpr auto _Mutable() const noexcept
            requires _Const
        {
            return _Unchecked_iter<false, _Base>{_Blk, _Index};
        }
    };

    template <bool _Const>
    class _Iter : public _Unchecked_iter<_Const, _Hive_iterator_base> {
        using _Mybase = _Unchecked_iter<_Const, _Hive_iterator_base>;
        using _Mybase::_Blk, _Mybase::_Index;

    public:
        using typename _Mybase::reference, typename _Mybase::pointer;

        constexpr _Iter() noexcept             = default;
        constexpr _Iter(const _Iter&) noexcept = default;

        /* implicit */ constexpr _Iter(const _Iter<false>& _Mutable_iter) noexcept
            requires _Const
            : _Mybase(_Mutable_iter._Blk, _Mutable_iter._Index) {
            _Hive_iterator_base::operator=(_Mutable_iter);
        }

        constexpr _Iter& operator=(const _Iter&) noexcept = default;

#if _ITERATOR_DEBUG_LEVEL != 0
        _NODISCARD constexpr reference operator*() const noexcept {
            _STL_VERIFY(!this->_Is_value_initialized(), "cannot dereference value-initialized hive iterator");
            _STL_VERIFY(!this->_Is_invalid(), "cannot dereference invalid hive iterator");
            _STL_VERIFY(!this->_Is_end(), "cannot dereference end hive iterator");

            return _Mybase::operator*();
        }
        _NODISCARD constexpr pointer operator->() const noexcept {
            return pointer_traits<pointer>::pointer_to(**this);
        }
#endif // _ITERATOR_DEBUG_LEVEL != 0

        constexpr _Iter& operator++() noexcept {
#if _ITERATOR_DEBUG_LEVEL != 0
            _STL_VERIFY(!this->_Is_value_initialized(), "cannot increment value-initialized hive iterator");
            _STL_VERIFY(!this->_Is_invalid(), "cannot increment invalid hive iterator");
            _STL_VERIFY(!this->_Is_end(), "cannot increment end hive iterator");
#endif // _ITERATOR_DEBUG_LEVEL != 0
            _Mybase::operator++();
            return *this;
        }
        constexpr _Iter operator++(int) noexcept {
            const auto _Temp = *this;
            ++*this;
            return _Temp;
        }
        constexpr _Iter& operator--() noexcept {
#if _ITERATOR_DEBUG_LEVEL != 0
            _STL_VERIFY(!this->_Is_value_initialized(), "cannot decrement value-initialized hive iterator");
            _STL_VERIFY(!this->_Is_invalid(), "cannot decrement invalid hive iterator");
            _STL_VERIFY(!this->_Is_begin(), "cannot decrement begin hive iterator");
#endif // _ITERATOR_DEBUG_LEVEL != 0
            _Mybase::operator--();
            return *this;
        }
        constexpr _Iter operator--(int) noexcept {
            const auto _Temp = *this;
            --*this;
            return _Temp;
        }

#if _ITERATOR_DEBUG_LEVEL != 0
        template <bool _OtherConst>
        constexpr void _Compat(const _Iter<_OtherConst>& _Other) const noexcept {
            _STL_VERIFY((this->_Myblock != nullptr && _Other._Myblock != nullptr
                            && this->_Myblock->_Mycont == _Other._Myblock->_Mycont)
                            || (this->_Is_value_initialized() && _Other._Is_value_initialized()),
                "hive iterators incompatible");
        }

        template <bool _RightConst>
        _NODISCARD constexpr strong_ordering operator<=>(const _Iter<_RightConst>& _Right) const noexcept {
            _Compat(_Right);
            return _Mybase::operator<=>(_Right);
        }
        template <bool _RightConst>
        _NODISCARD constexpr bool operator==(const _Iter<_RightConst>& _Right) const noexcept {
            _Compat(_Right);
            return _Mybase::operator==(_Right);
        }
#endif // _ITERATOR_DEBUG_LEVEL != 0

        using _Prevent_inheriting_unwrap = _Iter;

        _NODISCARD constexpr _Unchecked_iter<_Const> _Unwrapped() const noexcept {
            return {_Blk, _Index};
        }

        constexpr void _Seek_to(const _Unchecked_iter<_Const>& _It) noexcept {
            _Blk   = _It._Blk;
            _Index = _It._Index;
            this->_Adopt(_STD to_address(_Blk._Ptr()));
        }

#if _ITERATOR_DEBUG_LEVEL != 0
        template <bool _LastConst>
        friend constexpr void _Verify_range(const _Iter& _First, const _Iter<_LastConst>& _Last) noexcept {
            // note _Compat check inside operator<=>
            _STL_VERIFY(_First <= _Last, "hive iterator range transposed");
        }
#endif // _ITERATOR_DEBUG_LEVEL != 0

    private:
        template <class _Ty, class _Alloc>
        friend class hive;

        friend _Hive_iterators_provider;

        constexpr _Iter(_Block_iter_active _Blk_, _Block_size_t _Index_) : _Mybase(_Blk_, _Index_) {
            this->_Adopt(_STD to_address(_Blk._Ptr()));
        }

        _NODISCARD constexpr auto _Mutable() const noexcept
            requires _Const
        {
            return _Iter<false>{_Blk, _Index};
        }

#if _ITERATOR_DEBUG_LEVEL != 0
        _NODISCARD constexpr bool _Is_first_block() const noexcept {
            return _Blk->_Prev->_Is_sent();
        }

        _NODISCARD constexpr bool _Is_end() const noexcept {
            return _Blk->_Is_sent();
        }
        _NODISCARD constexpr bool _Is_begin() const noexcept {
            return _Is_first_block() && _Index == _Blk->_First_element();
        }
#endif // _ITERATOR_DEBUG_LEVEL != 0
    };

    using const_iterator             = _Iter<true>;
    using iterator                   = _Iter<false>;
    using _Unchecked_const_iterator  = _Unchecked_iter<true>;
    using _Unchecked_iterator        = _Unchecked_iter<false>;
    using _Local_iterator            = _Unchecked_local_iter<>;
    using _Local_iterator_idl_common = _Unchecked_local_iter<_Hive_iterator_base>;

    _STL_INTERNAL_STATIC_ASSERT(derived_from<iterator, _Local_iterator_idl_common>);
    _STL_INTERNAL_STATIC_ASSERT(derived_from<const_iterator, _Local_iterator_idl_common>);

    _STL_INTERNAL_STATIC_ASSERT(_Unwrappable_v<iterator>);
    _STL_INTERNAL_STATIC_ASSERT(!_Unwrappable_v<_Unchecked_iterator>);
    _STL_INTERNAL_STATIC_ASSERT(_Unwrappable_v<const_iterator>);
    _STL_INTERNAL_STATIC_ASSERT(!_Unwrappable_v<_Unchecked_const_iterator>);
};

template <class _UnionPtr, class _ValuePtr>
struct _Hive_local_ptr_provider {
    struct _Lptr {
        // Provides iteration over the element values in a block's union array, so that other code can treat them as a
        // non-contiguous range of elements.
        using iterator_concept  = random_access_iterator_tag;
        using iterator_category = random_access_iterator_tag;
        using value_type        = pointer_traits<_ValuePtr>::element_type;
        using difference_type   = pointer_traits<_UnionPtr>::difference_type;
        using pointer           = _ValuePtr;
        using reference         = value_type&;

        constexpr _Lptr(_UnionPtr _Raw_ptr = nullptr) noexcept : _Raw(_Raw_ptr) {}
        _NODISCARD constexpr reference operator*() const noexcept {
            return _Raw->_Value;
        }
        _NODISCARD constexpr pointer operator->() const noexcept {
            return pointer_traits<pointer>::pointer_to(**this);
        }
        _NODISCARD constexpr reference operator[](difference_type _Off) const noexcept {
            return _Raw[_Off]._Value;
        }

        // simply forward other operators
        constexpr _Lptr& operator++() noexcept {
            ++_Raw;
            return *this;
        }
        constexpr _Lptr operator++(int) noexcept {
            const auto _Tmp = *this;
            ++_Raw;
            return _Tmp;
        }
        constexpr _Lptr& operator--() noexcept {
            --_Raw;
            return *this;
        }
        constexpr _Lptr operator--(int) noexcept {
            const auto _Tmp = *this;
            --_Raw;
            return _Tmp;
        }
        constexpr _Lptr& operator+=(difference_type _Off) noexcept {
            _Raw += _Off;
            return *this;
        }
        constexpr _Lptr& operator-=(difference_type _Off) noexcept {
            _Raw -= _Off;
            return *this;
        }
        _NODISCARD constexpr difference_type operator-(const _Lptr& _Right) const noexcept {
            return _Raw - _Right._Raw;
        }
        _NODISCARD constexpr bool operator==(const _Lptr& _Right) const noexcept {
            return _Raw == _Right._Raw;
        }
        _NODISCARD constexpr strong_ordering operator<=>(const _Lptr& _Right) const noexcept {
            return _STD to_address(_Raw) <=> _STD to_address(_Right._Raw);
        }
        _NODISCARD constexpr _Lptr operator+(difference_type _Off) const noexcept {
            auto _Tmp = *this;
            _Tmp += _Off;
            return _Tmp;
        }
        _NODISCARD constexpr _Lptr operator-(difference_type _Off) const noexcept {
            auto _Tmp = *this;
            _Tmp -= _Off;
            return _Tmp;
        }
        _NODISCARD friend constexpr _Lptr operator+(difference_type _Off, _Lptr _Next) noexcept {
            _Next += _Off;
            return _Next;
        }

        _UnionPtr _Raw;
    };
    _STL_INTERNAL_STATIC_ASSERT(random_access_iterator<_Lptr>);
    _STL_INTERNAL_STATIC_ASSERT(!contiguous_iterator<_Lptr>); // because `addressof(_Raw[n]._Value)` is not equivalent
                                                              // to `addressof(_Raw->_Value) + n` (which is actually UB)
};

template <class _BlockSizeT, class _Ty>
class _Hive_lambdas {
public:
    using _Mode_t = uint8_t;
    enum : _Mode_t { _Copy = 1 << 1, _Move = 1 << 2, _Uninit = 1 << 3, _Init = 1 << 4 };

private:
    using _Block_size_t = _BlockSizeT;

    template <_Mode_t _Mode, class _DstIt, class _ValTy>
    static constexpr void _Do_output(_DstIt& _Dst, _ValTy&& _Val) {
        using _Cast_type = conditional_t<static_cast<bool>(_Mode & _Move), remove_reference_t<_ValTy>&&, _ValTy&&>;
        if constexpr (_Mode & _Uninit) {
            _Dst._Emplace(static_cast<_Cast_type>(_Val));
        } else {
            *_Dst = static_cast<_Cast_type>(_Val);
            ++_Dst;
        }
    }

    template <_Mode_t _Mode, class _SrcIt, class _DstIt>
    static constexpr void _Do_copy_move(_SrcIt& _Src, _Block_size_t _Cnt, _DstIt& _Dst) {
        _STL_INTERNAL_CHECK(_Cnt > 0);
        do {
            _Do_output<_Mode>(_Dst, *_Src);
            ++_Src;
            --_Cnt;
        } while (_Cnt != 0);
    }

public:
    template <_Mode_t _Mode>
    _NODISCARD static constexpr auto _Fill_blk(const _Ty& _Val) noexcept {
        _STL_INTERNAL_STATIC_ASSERT(!(_Mode & (_Copy | _Move)));
        return [&]<class _DstIt>(_DstIt&& _Dest, _Block_size_t _Cnt) {
            _STL_INTERNAL_CHECK(_Cnt > 0);
            do {
                _Do_output<_Mode>(_Dest, _Val);
                --_Cnt;
            } while (_Cnt != 0);
        };
    }

    template <_Mode_t _Mode, class _SrcIt>
    _NODISCARD static constexpr auto _Copy_move_to_blk(_SrcIt& _Src) noexcept {
        return [&](auto&& _Dst, _Block_size_t _Cnt) { _Do_copy_move<_Mode>(_Src, _Cnt, _Dst); };
    }
    template <_Mode_t _Mode, class _DstIt>
    _NODISCARD static constexpr auto _Copy_move_from_blk(_DstIt& _Dst) noexcept {
        return [&](auto&& _Src, _Block_size_t _Cnt) { _Do_copy_move<_Mode>(_Src, _Cnt, _Dst); };
    }

    template <_Mode_t _Mode, class _DstIt>
    _NODISCARD static constexpr auto _Copy_move_from_blk_bounded(_DstIt& _Dst, _Block_size_t& _Dst_cnt) noexcept {
        return [&]<class _SrcIt>(_SrcIt _Src_fst, const _SrcIt& _Src_lst) {
            _STL_INTERNAL_CHECK(_Src_fst != _Src_lst);
            _STL_INTERNAL_CHECK(_Dst_cnt > 0);
            do {
                _Do_output<_Mode>(_Dst, *_Src_fst);
                ++_Src_fst;
                --_Dst_cnt;
            } while (_Src_fst != _Src_lst && _Dst_cnt != 0);
            return _Src_fst;
        };
    }
};

template <class _ValueType, class _SizeType, class _DifferenceType, class _Pointer, class _ConstPointer>
struct _Hive_val_provider {
    struct _Val : _Hive_val_empty_base {
        using value_type      = _ValueType;
        using pointer         = _Pointer;
        using const_pointer   = _ConstPointer;
        using reference       = value_type&;
        using const_reference = const value_type&;
        using size_type       = _SizeType;
        using difference_type = _DifferenceType;

        using _Block        = _Hive_block_provider<value_type, size_type, pointer>::_Block;
        using _Block_ptr    = _Block::_Block_ptr;
        using _Block_size_t = _Block::_Size_t;

        using _Union     = _Block::_Union;
        using _Union_ptr = _Block::_Union_ptr;

        using _Limits_t = _Hive_limits_small<_Block_size_t>;

        using _Block_iters_provider = _Hive_block_iterators_provider<_Block, _Block_ptr>;
        using _Block_iter_active    = _Block_iters_provider::_Active_iterator;
        using _Block_iter_nonfull   = _Block_iters_provider::_Nonfull_iterator;
        using _Block_iter_reserved  = _Block_iters_provider::_Reserved_iterator;

        using _Iters_provider            = _Hive_iterators_provider<_Val>;
        using iterator                   = _Iters_provider::iterator;
        using const_iterator             = _Iters_provider::const_iterator;
        using _Unchecked_iterator        = _Iters_provider::_Unchecked_iterator;
        using _Unchecked_const_iterator  = _Iters_provider::_Unchecked_const_iterator;
        using _Local_iterator            = _Iters_provider::_Local_iterator;
        using _Local_iterator_idl_common = _Iters_provider::_Local_iterator_idl_common;

        using _Local_ptr = _Hive_local_ptr_provider<_Union_ptr, pointer>::_Lptr;

        using _Lambdas = _Hive_lambdas<_Block_size_t, value_type>;

        static constexpr auto _Sentinel_ord_id = _STD _Max_limit<size_type>();

        _Block _Sent_block = _Block::_Sentinel(_Sent_block);
        _Block_iter_reserved _Reserved_first{nullptr};

        size_type _Size     = 0;
        size_type _Capacity = 0;

        _Limits_t _Limits;

        constexpr explicit _Val(_Limits_t _Limits_) noexcept : _Limits(_Limits_) {
#if _ITERATOR_DEBUG_LEVEL != 0
            _Sent_block._Mycont = this;
#endif // _ITERATOR_DEBUG_LEVEL != 0
        }

        _NODISCARD constexpr _Block_iter_active _Active_begin() const noexcept {
            return _Block_iter_active{_Sent_block._Next};
        }
        _NODISCARD constexpr _Block_iter_nonfull _Nonfull_begin() const noexcept {
            return _Block_iter_nonfull{_Sent_block._Next_nonfull};
        }
        _NODISCARD constexpr _Block_ptr _Sent() noexcept {
            return pointer_traits<_Block_ptr>::pointer_to(_Sent_block);
        }

        template <class _Fn>
        static constexpr void _Visit_block_iter_n(_Block_ptr _Blk, _Fn _Func) {
            // pass wrapped pointer when the block is full to enable further optimizations
            if (_Blk->_Full()) {
                _Func(_Local_ptr{_Blk->_Data}, _Blk->_Capacity);
            } else {
                _Func(_Local_iterator{_Blk, _Blk->_First_element()}, _Blk->_Size);
            }
        }

        template <class _Fn>
        static constexpr _Block_size_t _With_block_iter(_Block_ptr _Blk, _Block_size_t _Index, _Fn _Func) {
            // pass wrapped pointer when the block is full to enable further optimizations
            if (_Blk->_Full()) {
                return static_cast<_Block_size_t>(_Func(_Local_ptr{_Blk->_Data + _Index})._Raw - _Blk->_Data);
            } else {
                return _Func(_Local_iterator{_Blk, _Index})._Index;
            }
        }

        template <class _Fn>
        static constexpr _Block_size_t _With_block_iters(
            _Block_ptr _Blk, _Block_size_t _First, _Block_size_t _Last, _Fn _Func) {
            // pass wrapped pointers when the block is full to enable further optimizations
            if (_Blk->_Full()) {
                return static_cast<_Block_size_t>(
                    _Func(_Local_ptr{_Blk->_Data + _First}, _Local_ptr{_Blk->_Data + _Last})._Raw - _Blk->_Data);
            } else {
                return _Func(_Local_iterator{_Blk, _First}, _Local_iterator{_Blk, _Last})._Index;
            }
        }

#if _ITERATOR_DEBUG_LEVEL == 0
        constexpr void _Orphan_block(const _Block&) const noexcept {}
        constexpr void _Orphan_range(const _Block&, _Block_size_t, _Block_size_t) const noexcept {}
        constexpr void _Orphan_nonend() const noexcept {}
        constexpr void _Orphan_end() const noexcept {}

        constexpr void _Adopt_all(const _Hive_val_empty_base*) const noexcept {}
#else // ^^^ _ITERATOR_DEBUG_LEVEL == 0 / _ITERATOR_DEBUG_LEVEL > 0 vvv
        constexpr void _Orphan_block(const _Block& _Blk) const noexcept {
            if consteval {
                _Orphan_block_unlocked(_Blk);
            } else {
                _Orphan_block_locked(_Blk);
            }
        }
        constexpr void _Orphan_range(const _Block& _Blk, _Block_size_t _First, _Block_size_t _Last) const noexcept {
            if consteval {
                _Orphan_range_unlocked(_Blk, _First, _Last);
            } else {
                _Orphan_range_locked(_Blk, _First, _Last);
            }
        }
        constexpr void _Orphan_nonend() const noexcept {
            if consteval {
                _Orphan_nonend_unlocked();
            } else {
                _Orphan_nonend_locked();
            }
        }
        constexpr void _Orphan_end() const noexcept {
            if consteval {
                _Orphan_end_unlocked();
            } else {
                _Orphan_end_locked();
            }
        }

        constexpr void _Adopt_all(const _Hive_val_empty_base* _Parent) const noexcept {
            // Note: No debug lock needed here, as we are working with blocks instead of iterators.
            const auto _Last = const_cast<_Val*>(this)->_Sent();
            for (auto _Blk = _Active_begin(); _Blk != _Last; ++_Blk) {
                _Blk->_Mycont = _Parent;
            }
        }

        _NODISCARD constexpr bool _Is_parent_of(const _Local_iterator_idl_common& _Iter) const noexcept {
            return _Iter._Myblock != nullptr && _Iter._Myblock->_Mycont == this;
        }
        _NODISCARD constexpr bool _Is_parent_of(const _Local_iterator& _Iter) const noexcept {
            return _Iter._Blk->_Mycont == this;
        }

        constexpr void _Orphan_block_unlocked(const _Block& _Blk) const noexcept {
            const auto _Last_iter = _STD addressof(_Blk._Sent_iter);
            for (auto _Iter = _Blk._Sent_iter._Mynextiter; _Iter != _Last_iter; _Iter = _Iter->_Mynextiter) {
                static_cast<const _Hive_iterator_base12&>(*_Iter)._Myblock = nullptr;
            }
            _Blk._Sent_iter._Mynextiter = _Blk._Sent_iter._Mypreviter = _Last_iter;
        }
        void _Orphan_block_locked(const _Block& _Blk) const noexcept {
            _Lockit _Lock(_LOCK_DEBUG);
            _Orphan_block_unlocked(_Blk);
        }

        constexpr void _Orphan_range_unlocked(
            const _Block& _Blk, _Block_size_t _First, _Block_size_t _Last) const noexcept {
            const auto _Lst = _STD addressof(_Blk._Sent_iter);
            for (auto _Fst = _Blk._Sent_iter._Mynextiter; _Fst != _Lst;) {
                const auto _Next      = _Fst->_Mynextiter;
                const auto& _Fst_iter = static_cast<const _Local_iterator_idl_common&>(*_Fst);
                if (_First <= _Fst_iter._Index && _Fst_iter._Index < _Last) {
                    _Fst_iter._Orphan_me_unlocked();
                }
                _Fst = _Next;
            }
        }
        void _Orphan_range_locked(const _Block& _Blk, _Block_size_t _First, _Block_size_t _Last) const noexcept {
            _Lockit _Lock(_LOCK_DEBUG);
            _Orphan_range_unlocked(_Blk, _First, _Last);
        }

        constexpr void _Orphan_nonend_unlocked() const noexcept {
            const auto _Last_blk = const_cast<_Val*>(this)->_Sent();
            for (auto _Blk = _Active_begin(); _Blk != _Last_blk; ++_Blk) {
                _Orphan_block_unlocked(*_Blk);
            }
        }
        void _Orphan_nonend_locked() const noexcept {
            _Lockit _Lock(_LOCK_DEBUG);
            _Orphan_nonend_unlocked();
        }

        constexpr void _Orphan_end_unlocked() const noexcept {
            _Orphan_block_unlocked(_Sent_block);
        }
        void _Orphan_end_locked() const noexcept {
            _Lockit _Lock(_LOCK_DEBUG);
            _Orphan_end_unlocked();
        }
#endif // ^^^ _ITERATOR_DEBUG_LEVEL > 0 ^^^
    };
};

template <class _Ty, class _Alloc>
class hive {
private:
    using _Alty        = _Rebind_alloc_t<_Alloc, _Ty>;
    using _Alty_traits = allocator_traits<_Alty>;

    static constexpr bool _Need_destruction =
        !conjunction_v<is_trivially_destructible<_Ty>, _Uses_default_destroy<_Alty, _Ty*>>;

public:
    static_assert(!_ENFORCE_MATCHING_ALLOCATORS || is_same_v<_Ty, typename _Alloc::value_type>,
        _MISMATCHED_ALLOCATOR_MESSAGE("hive<T, Allocator>", "T"));
    static_assert(is_object_v<_Ty>, "The C++ Standard forbids containers of non-object types "
                                    "because of [container.requirements].");

    // types
    using value_type      = _Ty;
    using allocator_type  = _Alloc;
    using pointer         = _Alty_traits::pointer;
    using const_pointer   = _Alty_traits::const_pointer;
    using reference       = value_type&;
    using const_reference = const value_type&;
    using size_type       = _Alty_traits::size_type;
    using difference_type = _Alty_traits::difference_type;

private:
    static constexpr bool _Alty_uses_default_max_size =
        disjunction_v<_Is_default_allocator<_Alloc>, negation<_Has_max_size<_Alty>>>;
    static constexpr bool _Max_limit_may_be_zero =
        !_Alty_uses_default_max_size || _STD _Max_limit<size_type>() / sizeof(_Ty) == 0;

    using _Scary_val = _Hive_val_provider<_Ty, size_type, difference_type, pointer, const_pointer>::_Val;

    using _Block_size_t = _Scary_val::_Block_size_t;

    using _Limits_t = _Scary_val::_Limits_t;

    using _Block        = _Scary_val::_Block;
    using _Alblk        = _Rebind_alloc_t<_Alloc, _Block>;
    using _Alblk_traits = allocator_traits<_Alblk>;
    using _Block_ptr    = _Scary_val::_Block_ptr;

    using _Union          = _Scary_val::_Union;
    using _Alunion        = _Rebind_alloc_t<_Alloc, _Union>;
    using _Alunion_traits = allocator_traits<_Alunion>;
    using _Union_ptr      = _Scary_val::_Union_ptr;

    using _Block_iter_active   = _Scary_val::_Block_iter_active;
    using _Block_iter_nonfull  = _Scary_val::_Block_iter_nonfull;
    using _Block_iter_reserved = _Scary_val::_Block_iter_reserved;

    using _Local_ptr                 = _Scary_val::_Local_ptr;
    using _Local_iterator            = _Scary_val::_Local_iterator;
    using _Local_iterator_idl_common = _Scary_val::_Local_iterator_idl_common;

    using _Lambdas = _Scary_val::_Lambdas;

    static constexpr auto _Sentinel_ord_id = _Scary_val::_Sentinel_ord_id;

    // note that this may exceed `block_capacity_hard_limits().max` due to N5032 [hive.overview]/5.3
    static constexpr size_t _Hard_limits_max =
        _STD min<size_t>(_STD _Max_limit<_Block_size_t>(), _STD _Max_limit<size_type>());


    enum class _Temp_block_type { _New, _Reserved };

    template <_Temp_block_type _Type>
    class _NODISCARD _Temp_block {
    public:
        constexpr _Temp_block(hive& _Hive_, _Block_ptr _Blk_) noexcept
            : _Hive(_Hive_), _Blk(_Blk_), _Last(_Blk->_Data) {}

        _Temp_block(const _Temp_block&)            = delete;
        _Temp_block& operator=(const _Temp_block&) = delete;

        constexpr ~_Temp_block() noexcept {
            if (_Blk != nullptr) {
                if constexpr (_Need_destruction) {
                    for (_Local_ptr _Iter = _Blk->_Data; _Iter != _Last; ++_Iter) {
                        _Alty_traits::destroy(_Hive._Al, _STD to_address(_Iter));
                    }
                }

                if constexpr (_Type == _Temp_block_type::_New) {
                    _Hive._Dealloc_block(_Blk);
                }
            }
        }

        _NODISCARD constexpr _Block_size_t _Capacity() const noexcept {
            return _Blk->_Capacity;
        }

        // except order id
        _NODISCARD constexpr _Block_ptr _Init_and_release() noexcept {
            _Blk->_Init(static_cast<_Block_size_t>(_Last - _Blk->_Data));
#if _ITERATOR_DEBUG_LEVEL != 0
            _Blk->_Sent_iter._Mypreviter = _Blk->_Sent_iter._Mynextiter = _STD addressof(_Blk->_Sent_iter);
            _Blk->_Mycont                                               = _STD addressof(_Hive._Myval);
#endif // _ITERATOR_DEBUG_LEVEL != 0
            return _STD exchange(_Blk, nullptr);
        }

        _NODISCARD constexpr _Block_ptr _Uninit_release() noexcept {
            return _STD exchange(_Blk, nullptr);
        }

        template <class... _Valty>
        constexpr void _Emplace(_Valty&&... _Val) {
            _Alty_traits::construct(_Hive._Al, _STD to_address(_Last), _STD forward<_Valty>(_Val)...);
            ++_Last;
        }

    private:
        hive& _Hive;
        _Block_ptr _Blk;
        _Local_ptr _Last;
    };

    // Uninitialized block with contiguous elements. Destroys elements and deallocates the block if an exception is
    // thrown.
    using _Temp_new_block = _Temp_block<_Temp_block_type::_New>;
    // Uninitialized block with contiguous elements. Destroys elements if an exception is thrown.
    using _Temp_reserved_block = _Temp_block<_Temp_block_type::_Reserved>;

public:
    using iterator                  = _Scary_val::iterator;
    using const_iterator            = _Scary_val::const_iterator;
    using _Unchecked_iterator       = _Scary_val::_Unchecked_iterator;
    using _Unchecked_const_iterator = _Scary_val::_Unchecked_const_iterator;

    using reverse_iterator       = _STD reverse_iterator<iterator>;
    using const_reverse_iterator = _STD reverse_iterator<const_iterator>;

private:
    static constexpr void _Verify_limits([[maybe_unused]] hive_limits _Limits) noexcept {
#if _ITERATOR_DEBUG_LEVEL != 0
        _STL_VERIFY(_Limits.min <= _Limits.max, "hive limits min greater than max");
        const auto _Hard_limits = block_capacity_hard_limits();
        _STL_VERIFY(
            _Hard_limits.min <= _Limits.min && _Limits.max <= _Hard_limits.max, "hive limits outside hard limits");
#endif // _ITERATOR_DEBUG_LEVEL != 0
    }

#ifdef _ENABLE_STL_INTERNAL_CHECK
    constexpr void _Check_invariants() const noexcept {
        const auto _Sent = const_cast<_Scary_val&>(_Myval)._Sent();

        size_type _Actual_size = 0;
        size_type _Actual_cap  = 0;
        for (auto _Blk = _Myval._Active_begin(); _Blk != _Sent; ++_Blk) {
            _STL_INTERNAL_CHECK(_Blk->_Size > 0);

            _STL_INTERNAL_CHECK(_Blk->_Skip[_Blk->_Capacity] == 0);

            for (_Block_size_t _Idx = 0; _Idx != _Blk->_Capacity;) {
                if (_Blk->_Skip[_Idx] != 0) {
                    const auto _Length = _Blk->_Skip[_Idx];
                    const auto _Tail   = _Idx + _Length - 1;
                    _STL_INTERNAL_CHECK(0 < _Length && _Length <= _Blk->_Capacity - _Idx);
                    _STL_INTERNAL_CHECK(_Blk->_Skip[_Idx] == _Blk->_Skip[_Tail]);
                    _Idx += _Length;
                } else {
                    ++_Idx;
                }
            }

            if (!_Blk->_Full()) {
                const auto _First_free = _Blk->_First_free;
                const auto _First_node = _First_free + _Blk->_Skip[_First_free] - 1;
                _STL_INTERNAL_CHECK(_Blk->_Data[_First_node]._Free._Prev == _Block::_Free_npos);

                _Block_size_t _Space_count = 0;
                for (auto _Node = _First_node;;) {
                    const auto _Next_node = _Blk->_Data[_Node]._Free._Next;

                    _STL_INTERNAL_CHECK(_Blk->_Skip[_Node] > 0);
                    _Space_count += _Blk->_Skip[_Node];

                    if (_Next_node == _Block::_Free_npos) {
                        break;
                    }
                    _STL_INTERNAL_CHECK(_Blk->_Data[_Next_node]._Free._Prev == _Node);
                    _Node = _Next_node;
                }
                _STL_INTERNAL_CHECK(_Space_count == _Blk->_Capacity - _Blk->_Size);
            }

            _STL_INTERNAL_CHECK(_Blk->_Next->_Prev == _Blk);
            _STL_INTERNAL_CHECK(_Blk->_Capacity >= _Blk->_Size);
            _STL_INTERNAL_CHECK(_Myval._Limits._Contains(_Blk->_Capacity));
            _STL_INTERNAL_CHECK(_Blk->_Order_id < _Blk->_Next->_Order_id);

            _Actual_size += _Blk->_Size;
            _Actual_cap += _Blk->_Capacity;
        }
        _STL_INTERNAL_CHECK(_Myval._Size == _Actual_size);

        size_type _Active_space_count = 0;
        for (auto _Blk = _Myval._Nonfull_begin(); _Blk != _Sent; ++_Blk) {
            _STL_INTERNAL_CHECK(_Blk->_Next_nonfull->_Prev_nonfull == _Blk);
            const auto _Space_count = _Blk->_Capacity - _Blk->_Size;
            _STL_INTERNAL_CHECK(_Space_count > 0);
            _Active_space_count += static_cast<size_type>(_Space_count);
        }
        _STL_INTERNAL_CHECK(_Active_space_count == _Actual_cap - _Actual_size);

        for (auto _Blk = _Myval._Reserved_first; _Blk != nullptr; ++_Blk) {
            _STL_INTERNAL_CHECK(_Myval._Limits._Contains(_Blk->_Capacity));
            _Actual_cap += _Blk->_Capacity;
        }
        _STL_INTERNAL_CHECK(_Myval._Capacity == _Actual_cap);

        _STL_INTERNAL_CHECK(_Myval._Sent_block._Order_id == _Sentinel_ord_id);

#if _ITERATOR_DEBUG_LEVEL != 0
        const auto _Myval_addr = _STD addressof(_Myval);
        for (auto _Blk = _Myval._Active_begin(); _Blk != _Sent; ++_Blk) {
            _STL_INTERNAL_CHECK(_Blk->_Mycont == _Myval_addr);
            const auto _Blk_ptr = _STD to_address(_Blk._Ptr());
            const auto _Last    = _STD addressof(_Blk->_Sent_iter);
            for (auto _First = _Blk->_Sent_iter._Mynextiter; _First != _Last; _First = _First->_Mynextiter) {
                _STL_INTERNAL_CHECK(_First->_Mypreviter->_Mynextiter == _First);
                auto& _First_iter = static_cast<const _Local_iterator_idl_common&>(*_First);
                _STL_INTERNAL_CHECK(_First_iter._Myblock == _Blk_ptr);
            }
        }
#endif // _ITERATOR_DEBUG_LEVEL != 0
    }
#endif // ^^^ defined(_ENABLE_STL_INTERNAL_CHECK) ^^^

public:
    // [hive.cons], construct/copy/destroy
    constexpr hive() noexcept(noexcept(_Alloc())) : hive(_Alloc()) {}
    constexpr explicit hive(const _Alloc& _Allocator) noexcept : hive(block_capacity_default_limits(), _Allocator) {}
    constexpr explicit hive(hive_limits _Block_limits) noexcept(noexcept(_Alloc())) /* strengthened */
        : hive(_Block_limits, _Alloc()) {}
    constexpr hive(hive_limits _Block_limits, const _Alloc& _Allocator) noexcept /* strengthened */
